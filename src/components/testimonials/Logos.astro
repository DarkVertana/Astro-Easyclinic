---
import { Image } from 'astro:assets';
import CapterraLogo from '../../assets/ratings/capterra.svg';
import GoogleLogo from '../../assets/ratings/google.svg';
import caringMinds from '../../assets/customers/caring-minds.webp';
import germanOsteo from '../../assets/customers/german-osteo.webp';
import premierHospital from '../../assets/customers/premier-hospital.webp';
import samonnoyClinic from '../../assets/customers/samonnoy-clinic.webp';

const customers = [
	{ name: 'Caring Minds', logo: caringMinds },
	{ name: 'German Osteo', logo: germanOsteo },
	{ name: 'Premier Hospital', logo: premierHospital },
	{ name: 'Samonnoy Clinic', logo: samonnoyClinic },
];
---

<section class="logos">
	<div class="panel">
		<p class="eyebrow">Social proof</p>
		<h2>Clinics that already run on EasyClinic</h2>
		<p class="lede">
			A sample of practices and hospitals alongside the public ratings our customers leave.
		</p>

		<div class="ratings" data-stagger>
			<span class="rating">
				<span class="tile"><CapterraLogo width={18} height={18} /></span>
				4.9 <span class="star" aria-hidden="true">&#9733;</span> on Capterra
			</span>
			<span class="rating">
				<span class="tile"><GoogleLogo width={18} height={18} /></span>
				4.8 <span class="star" aria-hidden="true">&#9733;</span> on Google
			</span>
		</div>

		<ul class="strip" data-stagger>
			{
				customers.map((customer) => (
					<li>
						<Image src={customer.logo} alt={customer.name} height={40} densities={[1, 2]} />
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.logos {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 4.5rem 1.5rem 3.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		text-align: center;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 {
		max-width: 18ch;
		margin: 0.85rem auto 0;
		color: var(--navy);
		font-size: clamp(1.75rem, 3.2vw, 2.5rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.lede {
		max-width: 48ch;
		margin: 1rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.ratings {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.5rem;
		margin: 2rem auto 0;
	}
	.rating {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.45rem 0.9rem;
		background: var(--surface-tint);
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.tile {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: var(--brand-wash);
	}
	.star {
		color: var(--brand-teal);
	}
	.strip {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1.75rem 2.5rem;
		max-width: var(--page-max);
		margin: 2.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	.strip li {
		display: flex;
		align-items: center;
		opacity: 0.88;
	}
	.strip img {
		width: auto;
		height: 40px;
		object-fit: contain;
	}

	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 2.75rem;
		}
		.strip {
			gap: 1.25rem 1.75rem;
		}
		.strip img {
			height: 32px;
		}
	}
</style>
