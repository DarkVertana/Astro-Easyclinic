		letter-spacing: -0.03em;
		/* the digits must not reflow as the number climbs */
		font-variant-numeric: tabular-nums;
	}
	.counters span {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	/* the product shot holds the right column */
	.shot {
		margin: 0;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--surface);
		box-shadow: 0 40px 80px rgba(10, 37, 64, 0.16);
		overflow: hidden;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	/* ---------- problem ---------- */
	.problem {
		background: var(--brand-wash);
	}
	.problem .panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 6.5rem 1.5rem 5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.problem .inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.problem .head {
		margin: 0 auto;
		text-align: center;
	}
	.problem .head h2 {
		max-width: 20ch;
		margin-inline: auto;
	}
	.leaks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.leaks li {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 2rem;
	}
	.num {
		color: #b2d9fc;
		font-size: 2.75rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.leaks h3 {
		margin: 1.125rem 0 0;
		color: var(--navy);
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.leaks li > p {
		/* the longest of the three runs to six lines — the others reserve the same */
		min-height: 9em;
		margin: 0.875rem 0 0rem;
		color: var(--muted);
		font-size: 1rem;
	}
	.metric {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		margin: auto 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.metric strong {
		color: var(--brand-blue);
		font-size: 2.25rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.metric span {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	/* ---------- capabilities ---------- */
	.capabilities {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.capabilities .inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 6.5rem;
	}
	.capabilities .head {
		margin: 0 auto;
		text-align: center;
	}
	.capabilities .head h2 {
		max-width: 22ch;
		margin-inline: auto;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.cards li {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.75rem;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.cards .tile {
		transition:
			background 0.25s ease,
			color 0.25s ease;
	}
	@media (hover: hover) {
		.cards li:hover {
			border-color: #b2d9fc;
			box-shadow:
				0 1px 2px rgba(10, 37, 64, 0.06),
				0 20px 44px -14px rgba(10, 37, 64, 0.22);
			transform: translateY(-4px);
		}
		.cards li:hover .tile {
			background: var(--brand-blue);
			color: var(--surface);
		}
	}
	.cards h3 {
		min-height: 2.6em;
		margin: 1.375rem 0 0;
		color: var(--navy);
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.3;
		text-wrap: balance;
	}
	.cards p {
		margin: 0.625rem 0 0;
		color: var(--muted);
		line-height: 1.55;
		font-size: 0.9375rem;
	}

	/* ---------- evidence ---------- */
	.evidence {
		position: relative;
		background: var(--navy);
		color: rgba(255, 255, 255, 0.78);
		font-size: 16px;
		line-height: 1.5;
		overflow: hidden;
	}
	.evidence .inner {
		position: relative;
		z-index: 1;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 6rem 1.5rem 6.5rem;
	}

	/* Bubbles drifting out from the middle of the band. Only the two colours the
	   logo carries besides the navy this sits on — the blue and the teal. Each one
	   is a soft radial rather than a flat disc, so it reads as light not a dot. */
	.bubbles {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}
	.bubbles span {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--size);
		height: var(--size);
		margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
		border-radius: 50%;
		background: radial-gradient(circle at 36% 34%, var(--tint), transparent 74%);
		opacity: 0;
		animation: drift var(--dur) linear var(--delay) infinite;
	}
	/* Position only — no scale, so a bubble is the same size the whole way out. */
	@keyframes drift {
		0% {
			opacity: 0;
			transform: translate(0, 0);
		}
		14% {
			opacity: 0.95;
		}
		30% {
			transform: translate(var(--x1), var(--y1));
		}
		56% {
			transform: translate(var(--x2), var(--y2));
		}
		80% {
			opacity: 0.7;
			transform: translate(var(--x3), var(--y3));
		}
		100% {
			opacity: 0;
			transform: translate(var(--x), var(--y));
		}
	}
	/* Twelve wandering paths out of the centre. Each bubble passes through three
	   waypoints that are pushed off its bearing, so it drifts rather than tracks a
	   straight line, and no two share a duration or a delay. */
	.bubbles span:nth-child(1) {
		--size: 36px;
		--x1: 112px;
		--y1: -41px;
		--x2: 222px;
		--y2: -12px;
		--x3: 313px;
		--y3: -51px;
		--x: 395px;
		--y: -31px;
		--dur: 16s;
		--delay: 0.0s;
		--tint: rgba(48, 160, 255, 0.73);
	}
	.bubbles span:nth-child(2) {
		--size: 66px;
		--x1: 98px;
		--y1: 51px;
		--x2: 193px;
		--y2: 73px;
		--x3: 250px;
		--y3: 157px;
		--x: 319px;
		--y: 186px;
		--dur: 20s;
		--delay: 1.7s;
		--tint: rgba(0, 192, 176, 0.73);
	}
	.bubbles span:nth-child(3) {
		--size: 36px;
		--x1: 76px;
		--y1: 159px;
		--x2: 175px;
		--y2: 279px;
		--x3: 90px;
		--y3: 461px;
		--x: 279px;
		--y: 517px;
		--dur: 24s;
		--delay: 3.4s;
		--tint: rgba(48, 160, 255, 0.73);
	}
	.bubbles span:nth-child(4) {
		--size: 44px;
		--x1: -24px;
		--y1: 127px;
		--x2: -48px;
		--y2: 236px;
		--x3: -67px;
		--y3: 337px;
		--x: -67px;
		--y: 424px;
		--dur: 25s;
		--delay: 5.1s;
		--tint: rgba(0, 192, 176, 0.88);
	}
	.bubbles span:nth-child(5) {
		--size: 50px;
		--x1: -39px;
		--y1: 144px;
		--x2: -103px;
		--y2: 259px;
		--x3: -28px;
		--y3: 397px;
		--x: -170px;
		--y: 467px;
		--dur: 29s;
		--delay: 6.8s;
		--tint: rgba(48, 160, 255, 0.73);
	}
	.bubbles span:nth-child(6) {
		--size: 66px;
		--x1: -139px;
		--y1: 72px;
		--x2: -229px;
		--y2: 183px;
		--x3: -388px;
		--y3: 157px;
		--x: -416px;
		--y: 318px;
		--dur: 33s;
		--delay: 8.5s;
		--tint: rgba(0, 192, 176, 0.8);
	}
	.bubbles span:nth-child(7) {
		--size: 50px;
		--x1: -112px;
		--y1: 44px;
		--x2: -219px;
		--y2: 53px;
		--x3: -320px;
		--y3: 37px;
		--x: -401px;
		--y: 45px;
		--dur: 16s;
		--delay: 10.2s;
		--tint: rgba(48, 160, 255, 0.8);
	}
	.bubbles span:nth-child(8) {
		--size: 40px;
		--x1: -147px;
		--y1: -39px;
		--x2: -255px;
		--y2: -123px;
		--x3: -319px;
		--y3: -250px;
		--x: -444px;
		--y: -243px;
		--dur: 20s;
		--delay: 11.9s;
		--tint: rgba(0, 192, 176, 0.75);
	}
	.bubbles span:nth-child(9) {
		--size: 40px;
		--x1: -39px;
		--y1: -104px;
		--x2: -96px;
		--y2: -183px;
		--x3: -84px;
		--y3: -283px;
		--x: -186px;
		--y: -319px;
		--dur: 24s;
		--delay: 13.6s;
		--tint: rgba(48, 160, 255, 0.79);
	}
	.bubbles span:nth-child(10) {
		--size: 72px;
		--x1: -28px;
		--y1: -148px;
		--x2: -48px;
		--y2: -277px;
		--x3: -24px;
		--y3: -401px;
		--x: 43px;
		--y: -501px;
		--dur: 25s;
		--delay: 15.3s;
		--tint: rgba(0, 192, 176, 0.88);
	}
	.bubbles span:nth-child(11) {
		--size: 56px;
		--x1: 66px;
		--y1: -146px;
		--x2: 181px;
		--y2: -239px;
		--x3: 219px;
		--y3: -368px;
		--x: 175px;
		--y: -506px;
		--dur: 29s;
		--delay: 17.0s;
		--tint: rgba(48, 160, 255, 0.79);
	}
	.bubbles span:nth-child(12) {
		--size: 36px;
		--x1: 149px;
		--y1: -45px;
		--x2: 229px;
		--y2: -180px;
		--x3: 365px;
		--y3: -201px;
		--x: 437px;
		--y: -283px;
		--dur: 33s;
		--delay: 18.7s;
		--tint: rgba(0, 192, 176, 0.83);
	}
	.evidence .head {
		max-width: 840px;
		margin: 0 auto;
		text-align: center;
	}
	.evidence h2 {
		max-width: 20ch;
		margin-inline: auto;
		color: var(--surface);
	}
	.evidence .lede {
		color: rgba(255, 255, 255, 0.72);
	}

	.results {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.results li {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		border: 1px solid rgba(255, 255, 255, 0.14);
		border-radius: 18px;
		padding: 1.875rem;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09);
	}
	.results strong {
		color: var(--surface);
		font-size: clamp(1.75rem, 2.4vw, 2.125rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.results span {
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.9375rem;
	}
	.quote {
		max-width: 900px;
		margin: 3.5rem auto 0;
		text-align: center;
	}
	.quote blockquote {
		margin: 0;
		border: 0;
		padding: 0;
	}
	.quote p {
		margin: 0;
		color: var(--surface);
		font-size: clamp(1.0625rem, 1.7vw, 1.3125rem);
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: -0.01em;
	}
	.quote p::before {
		content: '\201C';
	}
	.quote p::after {
		content: '\201D';
	}
	.quote figcaption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 1.5rem;
	}
	.quote figcaption strong {
		color: var(--surface);
		font-size: 1rem;
	}
	.quote figcaption span {
		color: rgba(255, 255, 255, 0.62);
		font-size: 0.9375rem;
	}

	/* ---------- use cases ---------- */
	.cases {
		background: var(--navy);
	}
	.cases .panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 6rem 1.5rem 5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.cases .inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.cases .head {
		margin: 0 auto;
		text-align: center;
	}
	.cases .head h2 {
		max-width: 24ch;
		margin-inline: auto;
	}
	.case {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		align-items: center;
		gap: 4rem;
		margin-top: 4.5rem;
	}
	/* the second story mirrors, so the panels alternate down the page */
	.case-flip .case-copy {
		order: 2;
	}
	/* One accent per story, mixed from a brand token the same way the pricing
	   add-on cards are: the wash is that colour over white, the ink the same hue
	   darkened until it clears 4.5:1 on it. */
	.case {
		--case-wash: #edf6fe;
		--case-ink: var(--brand-blue-dark);
	}
	.case-teal {
		--case-wash: #edfaf9;
		--case-ink: #037c73;
	}
	.case-amber {
		--case-wash: #fef9ef;
		--case-ink: #976b09;
	}
	/* one pill treatment for all three, on the palette's own tokens — the per-story
	   accent is left to the outcome callout, where it carries a figure */
	.case-kicker {
		display: inline-block;
		margin: 0;
		border-radius: 999px;
		padding: 0.3125rem 0.6875rem;
		background: var(--surface-tint);
		color: var(--brand-blue-dark);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.case-copy h3 {
		max-width: 18ch;
		margin: 1.125rem 0 0;
		color: var(--navy);
		font-size: clamp(1.5rem, 2.6vw, 2.125rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.case-copy p {
		max-width: 54ch;
		margin: 1.25rem 0 0;
		color: var(--muted);
		
		line-height: 1.65;
	}
	/* the figure each story lands on, pulled out of the narrative */
	.case-outcome {
		margin-top: 1.75rem;
		border-radius: 0 12px 12px 0;
		border-left: 3px solid var(--case-ink);
		padding: 0.875rem 1.125rem;
		background: var(--case-wash);
		color: var(--navy);
		font-size: 1.0625rem;
	}
	.case-outcome strong {
		color: var(--case-ink);
		font-weight: 700;
	}

	/* the product shot for each story */
	.case-shot {
		margin: 0;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 0.05),
			0 26px 54px -18px rgba(10, 37, 64, 0.22);
		overflow: hidden;
	}
	.case-shot img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	/* ---------- proof of concept ---------- */
	.poc {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.poc .inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5.5rem 1.5rem 6rem;
	}
	.poc .head {
		margin: 0 auto;
		text-align: center;
	}
	.poc .head h2 {
		max-width: 20ch;
		margin-inline: auto;
	}
	.stages {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3.5rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: stage;
	}
	.stages li {
		position: relative;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.875rem;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	/* a rule across the gap, so the four read as one run rather than four boxes */
	.stages li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(1.875rem + 19px);
		left: 100%;
		width: 1.25rem;
		height: 2px;
		background: var(--brand-wash-deep);
	}
	@media (hover: hover) {
		.stages li:hover {
			border-color: #b2d9fc;
			box-shadow:
				0 1px 2px rgba(10, 37, 64, 0.06),
				0 20px 44px -14px rgba(10, 37, 64, 0.2);
			transform: translateY(-4px);
		}
	}
	.stage-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin: 0;
	}
	.stage-no {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 38px;
		height: 38px;
		border-radius: 12px;
		background: var(--brand-blue);
		color: var(--surface);
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		box-shadow: 0 4px 12px rgba(0, 128, 246, 0.28);
	}
	.stage-when {
		border: 1px solid var(--brand-wash-deep);
		border-radius: 999px;
		padding: 0.25rem 0.625rem;
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.stages h3 {
		margin: 1.25rem 0 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.stages p {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.poc .actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 3rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.cards li {
			transition: none;
		}
		.bubbles {
			display: none;
		}
	}

	/* ---------- responsive ---------- */
	@media (max-width: 1180px) {
		.cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	@media (max-width: 1080px) {
		/* the shot drops below the copy and the hero reads as one column */
		.hero .inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 3rem;
			padding: 4.5rem 1.5rem 5rem;
		}
		h1,
		.hero .lede {
			max-width: none;
		}
		.problem .panel,
		.cases .panel {
			padding: 4.5rem 1.5rem 4rem;
		}
		.capabilities .inner,
		.evidence .inner,
		.poc .inner {
			padding: 4.5rem 1.5rem 5rem;
		}
		.leaks {
			grid-template-columns: minmax(0, 1fr);
		}
		.leaks li {
			padding: 1.75rem;
		}
		.leaks li > p {
			min-height: 0;
		}
		.metric {
			flex-direction: row;
			align-items: baseline;
			gap: 0.875rem;
		}
		.case {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
			margin-top: 3.5rem;
		}
		.case-flip .case-copy {
			order: 0;
