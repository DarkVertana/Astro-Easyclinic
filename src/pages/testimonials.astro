---
import Cta from '../components/Cta.astro';
import Testimonials from '../components/Testimonials.astro';
import Hero from '../components/testimonials/Hero.astro';
import Logos from '../components/testimonials/Logos.astro';
import Marketing from '../layouts/Marketing.astro';
import { SITE_TITLE } from '../consts';
---

<Marketing
	title={`Testimonials — ${SITE_TITLE}`}
	description="Doctors and clinics on EasyClinic EMR — 5,000+ practitioners in 18 countries on clinic management software that sticks."
	mainClass="testimonials-page"
>
	<Hero />
	<Logos />
	<Testimonials showMore={false} />
	<Cta />
</Marketing>

<style>
	main :global(section.proof) {
		background: var(--navy);
	}
	main :global(section.cta) {
		border-radius: 24px 24px 0 0;
	}
</style>
