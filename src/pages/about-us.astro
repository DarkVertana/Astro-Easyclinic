<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About ${SITE_TITLE}`}
			description={`Established in 2003, ${SITE_TITLE} has grown into a leading provider of premium medical software, serving thousands of clinicians across 18 countries. Meet the team and the mission behind the platform.`}
		/>
		<Reveal />
	</head>
	<body>
		<Header />
		<main data-reveal>
			<!-- intro: continues the wash band that starts behind the header -->
			<section class="intro">
				<div class="inner">
					<div class="headline">
						<p class="eyebrow">About us</p>
						<h1>Clinic software shaped by two decades of listening to doctors</h1>
						<p class="lede">
							{SITE_TITLE} is built by Novel Medicare Solutions. Since 2003 we have helped practices
							move off paper and onto software that keeps up with the way they actually work.
						</p>
					</div>
					<ul class="stats" data-stagger>
						{
							stats.map((stat) => (
								<li>
									<strong>
										{stat.figure}
										{stat.star && (
											<span class="star" aria-hidden="true">
												&#9733;
											</span>
										)}
									</strong>
									<span>{stat.label}</span>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- commitment: white panel rounding over the wash, as Features does on the homepage -->
			<section class="commitment">
				<div class="panel">
					<div class="inner">
						<div class="head">
							<h2>A commitment to streamline your clinic operations</h2>
							<p class="lede">
								Established in 2003, {SITE_TITLE} has grown into a leading provider of premium
								medical software, serving thousands across 18 countries.
							</p>
						</div>
						<div class="split">
							<figure class="shot">
								<Image
									src={workspace}
									alt={`A clinician reviewing a patient record in ${SITE_TITLE}`}
									widths={[420, 620, 900]}
									sizes="(max-width: 1080px) 92vw, 38vw"
								/>
							</figure>
							<ul class="purpose" data-stagger>
							{
								purpose.map((item) => (
									<li>
										<span class="tile" aria-hidden="true">
											<svg viewBox="0 0 16 16" width="22" height="22">
												<path
													d={item.icon}
													fill="none"
													stroke="currentColor"
													stroke-width="1.3"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</span>
										<h3>{item.heading}</h3>
										<p>{item.copy}</p>
									</li>
								))
								}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- clients: a bare logo strip, arrows flanking it -->
			<section class="clients">
				<div class="inner">
					<div class="head">
						<span class="tile mark-tile" aria-hidden="true">
							<Image class="mark-icon" src={handshake} alt="" width={38} height={38} densities={[1, 2]} />
						</span>
						<h2>Empowering healthcare organisations worldwide</h2>
						<p class="lede">
							From solo practitioners to hospital groups and teaching institutions, these are some of
							the organisations running on {SITE_TITLE}.
						</p>
					</div>

					<div class="rail">
						<button type="button" class="arrow" data-scroll="prev" aria-label="Previous logos">
							<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
								<path
									d="M10 2.8 4.8 8l5.2 5.2"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
						<ul class="track" data-track>
							{
								logos.map((logo) => (
									<li data-card>
										<Image src={logo.src} alt={logo.name} height={64} densities={[1, 2]} />
									</li>
								))
							}
						</ul>
						<button type="button" class="arrow" data-scroll="next" aria-label="More logos">
							<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true">
								<path
									d="M6 2.8 11.2 8 6 13.2"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"></path>
							</svg>
						</button>
					</div>
				</div>
			</section>

			<!-- team: navy band, then the standards panel rounds back over it -->
			<section class="team">
				<div class="panel">
					<div class="inner">
						<h2>Meet the {SITE_TITLE} dream team</h2>
						<p class="lede">
							{SITE_TITLE} is the result of a team devoted to the pursuit of excellence, meticulously
							crafting each aspect to set new standards in healthcare solutions.
						</p>
						<ul class="people" data-stagger>
							{
								team.map((person) => (
									<li>
										<div class="person-top">
											<Image
												class="portrait"
												src={person.photo}
												alt={person.name}
												width={96}
												height={96}
												densities={[1, 2]}
											/>
											<a
												class="linkedin"
												href={person.linkedin}
												target="_blank"
												rel="noopener noreferrer"
											>
												<span class="sr-only">{`${person.name} on LinkedIn`}</span>
												<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
													<path fill="currentColor" d={LINKEDIN} />
												</svg>
											</a>
										</div>
										<h3>{person.name}</h3>
										<p class="role">{person.role}</p>
										<p class="bio">{person.bio}</p>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<section class="trust">
				<div class="panel">
					<div class="inner">
						<h2>Built for the standards healthcare runs on</h2>
						<p class="lede">
							{SITE_TITLE} is built on the latest cloud technology with industry-leading encryption
							standards. Your records stay yours — we never sell them, misuse them or pry into them.
						</p>
						<ul class="standards" data-stagger>
							{
								standards.map((standard) => (
									<li>
										<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
											<circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
											<path
												d="m5.2 8.2 2 2 3.6-4"
												fill="none"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										<strong>{standard.name}</strong>
										<small>{standard.note}</small>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</section>

			<Cta />
		</main>
		<Footer />
	</body>
</html>

<script>
	import { initCarousel } from '../scripts/carousel';

	initCarousel('.clients');
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	/* ---------- intro ---------- */
	.intro {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	/* two columns, as the homepage hero is — the stat cards balance the headline */
	.intro .inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
		align-items: center;
		gap: 4rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5.5rem 1.5rem 6.5rem;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-blue);
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		max-width: 20ch;
		margin: 1rem 0 0;
		color: var(--navy);
		font-size: clamp(2.25rem, 4.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.02em;
	}
	.intro .lede {
		max-width: 58ch;
		margin: 1.5rem 0 0;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stats li {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border-radius: 16px;
		padding: 1.75rem;
		background: var(--surface);
	}
	.stats strong {
		color: var(--navy);
		font-size: clamp(1.75rem, 3vw, 2.375rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.stats .star {
		margin-left: 0.125rem;
		color: var(--brand-amber);
		font-size: 0.75em;
	}
	.stats span {
		color: var(--muted);
		font-size: 0.9375rem;
	}

	/* ---------- shared section furniture ---------- */
	h2 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.tile {
		display: grid;
		place-items: center;
		border-radius: 12px;
		background: var(--surface);
		color: var(--brand-blue);
	}

	/* ---------- commitment ---------- */
	.commitment {
		background: var(--brand-wash);
	}
	.commitment .panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 6.5rem 1.5rem 1rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.commitment .inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.commitment .head {
		max-width: 780px;
		margin: 0 auto;
		text-align: center;
	}
	.commitment .head h2 {
		max-width: 20ch;
		margin: 0 auto;
	}
	.commitment .lede {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.split {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: 3rem;
		margin-top: 3.25rem;
	}
	.shot {
		margin: 0;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: 20px;
		object-fit: cover;
	}
	.purpose {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.purpose li {
		border-radius: 20px;
		padding: 2rem;
		background: var(--surface-tint);
	}
	.purpose .tile {
		width: 52px;
		height: 52px;
	}
	.purpose h3 {
		margin: 1.5rem 0 0;
		color: var(--navy);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.purpose p {
		margin: 0.875rem 0 0;
		max-width: 52ch;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	/* ---------- clients ---------- */
	.clients {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.clients .inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4rem;
	}
	.clients .head {
		max-width: 780px;
		
		text-align: start;
	}
	/* the bare line mark reads as spindly beside the heading, so it gets a tile */
	.mark-tile {
		width: 64px;
		height: 64px;
		margin: 1.25rem 0;
		border-radius: 16px;
		background: var(--surface-tint);
	}
	.mark-icon {
		display: block;
		width: 38px;
		height: 38px;
		object-fit: contain;
	}
	.clients .head h2 {
		max-width: 24ch;
		margin: 0 auto;
	}
	.clients .lede {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 1.125rem;
	}

	/* the arrows flank the strip rather than sitting in the heading row */
	.rail {
		position: relative;
		margin-top: 3.5rem;
		padding: 0 3.25rem;
	}
	.arrow {
		position: absolute;
		top: 50%;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border: 0;
		border-radius: 50%;
		padding: 0;
		background: none;
		color: var(--muted);
		cursor: pointer;
		transform: translateY(-50%);
		transition: color 0.2s ease;
	}
	.arrow[data-scroll='prev'] {
		left: 0;
	}
