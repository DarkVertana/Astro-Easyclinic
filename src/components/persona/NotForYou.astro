---
import type { PersonaPage } from './types';

interface Props {
	data: PersonaPage;
}

const { data } = Astro.props;
const block = data.notForYou;
---

{
	block && (
		<section class="not">
			<div class="inner">
				<h2>{block.title}</h2>
				<p>
					{block.copy}
					{block.href && block.linkLabel && (
						<>
							{' '}
							<a href={block.href}>{block.linkLabel}</a>
						</>
					)}
				</p>
			</div>
		</section>
	)
}

<style>
	.not {
		background: var(--brand-wash);
		padding: 3.5rem 1.5rem;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}
	h2 {
		margin: 0;
		color: var(--navy);
		font-size: 1.375rem;
		font-weight: 700;
	}
	p {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	a {
		color: var(--brand-blue);
		font-weight: 650;
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
