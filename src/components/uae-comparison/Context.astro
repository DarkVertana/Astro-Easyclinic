---
import SectionHead from '../SectionHead.astro';

const triggers = [
	'Exchange / DHA onboarding pressure',
	'Insurance/TPA claim friction in AED',
	'Multi-Emirate or multi-branch chaos',
	'Doctors typing after close',
	'Reminder no-shows',
];
---

<section class="context">
	<div class="inner">
		<SectionHead
			eyebrow="Why now"
			title="NABIDH, Malaffi, Riayati — the box you tick first"
			lede="Compliance gets you in the door. Beyond that, clinics want a calmer day: AI records, a quieter desk, cleaner claims, one login across branches."
		/>
		<p class="body">
			Arabic + English patients are normal — confirm Rx language and UI language needs in demo.
		</p>

		<h3 class="sub">Why clinics switch now</h3>
		<ul class="chips" data-stagger>
			{triggers.map((item) => <li>{item}</li>)}
		</ul>
		<p class="note">One trigger is enough to look; two usually means you’re overdue.</p>
	</div>
</section>

<style>
	.context {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.body {
		max-width: 62ch;
		margin: 2rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
		text-align: center;
	}
	.sub {
		margin: 3rem 0 0;
		color: var(--navy);
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		max-width: 920px;
		margin: 1.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 999px;
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.note {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		text-align: center;
	}
</style>
