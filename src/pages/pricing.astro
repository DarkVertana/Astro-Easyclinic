	const sections = [...document.querySelectorAll<HTMLElement>('main.pricing > section')];
	const [hero, ...rest] = sections;
	hero?.classList.add('is-visible');

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const canObserve = 'IntersectionObserver' in window && !reduceMotion;

	if (!canObserve) {
		rest.forEach((section) => section.classList.add('is-visible'));
	} else {
		/* Mark anything already near the viewport before enabling hide-until-reveal. */
		const nearFold = window.innerHeight * 0.92;
		rest.forEach((section) => {
			if (section.getBoundingClientRect().top < nearFold) {
				section.classList.add('is-visible');
			}
		});

		/* Progressive enhance only after in-view sections are marked visible. */
		document.documentElement.classList.add('js-reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -6% 0px', threshold: 0.04 }
		);
		rest.forEach((section) => {
			if (!section.classList.contains('is-visible')) observer.observe(section);
		});
	}
