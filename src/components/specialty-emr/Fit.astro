---
import SectionHead from '../SectionHead.astro';
import type { Specialty } from './data';

interface Props {
	specialty: Specialty;
}

const { specialty } = Astro.props;
---

<section class="fit">
	<div class="panel">
		<SectionHead
			tone="dark"
			eyebrow={specialty.fitEyebrow}
			title={specialty.fitTitle}
			lede={specialty.fitLede}
		/>

		<ul class="rows" data-stagger>
			{
				specialty.fit.map((item) => (
					<li>
						<span class="mi" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
								<path d="m5 13 4 4L19 7" />
							</svg>
						</span>
						<p>{item}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	/* the one navy punctuation band on the page — wash above, white FAQ panel below */
	.fit {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}

	.rows {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.35rem 1.5rem;
		background: rgba(255, 255, 255, 5%);
	}
	.mi {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		background: rgba(255, 255, 255, 8%);
		color: var(--brand-teal);
	}
	.rows p {
		margin: 0.35rem 0 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.9375rem;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 4rem;
		}
	}
	@media (max-width: 720px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.rows {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
