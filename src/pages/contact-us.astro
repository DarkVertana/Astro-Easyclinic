		overscroll-behavior: contain;
	}
	.dial-menu:focus-visible {
		outline: none;
	}
	.dial-menu li {
		display: flex;
		align-items: center;
		gap: 0.5625rem;
		border-radius: 6px;
		padding: 0.375rem 0.5rem;
		color: var(--navy);
