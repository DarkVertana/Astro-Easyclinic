---
import SectionHead from '../SectionHead.astro';
import type { PersonaPage } from './types';

interface Props {
	data: PersonaPage;
}

const { data } = Astro.props;
const block = data.clinicTypes;
---

{
	block && (
		<section class="types">
			<div class="inner">
				<SectionHead title={block.title} lede={block.lede} />
				<ul class="chips" data-stagger>
					{block.items.map((item) => (
						<li>
							<a href={item.href}>
								<strong>{item.title}</strong>
								<span>{item.copy}</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.types {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.chips {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 2.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		border: 1px solid rgba(10, 37, 64, 8%);
		border-radius: 18px;
		padding: 1.25rem 1.35rem;
		background: var(--surface);
		color: inherit;
		text-decoration: none;
	}
	a:hover {
		border-color: rgba(14, 116, 144, 35%);
	}
	strong {
		color: var(--navy);
		font-size: 1.0625rem;
	}
	span {
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.5;
	}
	@media (max-width: 800px) {
		.chips {
			grid-template-columns: 1fr;
		}
	}
</style>
