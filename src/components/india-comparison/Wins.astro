---
import SectionHead from '../SectionHead.astro';

const wins = [
	{
		title: 'Cura AI on the OPD day',
		copy: 'Helps finish a prescription in about three clicks, supports diagnosis, and drafts visit summaries — meaningful time back on busy Indian OPD days.',
	},
	{
		title: 'Payments India clinics actually take',
		copy: 'Online and offline billing with UPI, cards, and netbanking in the same flow as invoices — plus insurance, corporate, and TPA claims tracked from submitted to settled.',
	},
	{
		title: 'WhatsApp, SMS, and any language',
		copy: 'Reminders and prescriptions go out over WhatsApp, SMS, and email in the language your patient reads — built for India’s multilingual, WhatsApp-first reality.',
	},
	{
		title: 'Multi-branch + transparent pricing',
		copy: 'One shared view across locations, specialty EMR depth, and published rupee tiers so a six-doctor polyclinic can budget like rent. ABHA/ABDM links: roadmap — confirm depth in demo.',
	},
];
---

<section class="wins">
	<div class="panel">
		<SectionHead
			tone="dark"
			title="Where EasyClinic earns its place"
			lede="Four local problems most tools only half-solve."
		/>
		<ul class="rows" data-stagger>
			{
				wins.map((w) => (
					<li>
						<strong>{w.title}</strong>
						<p>{w.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.wins {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
	}
	.rows {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.35rem 1.5rem;
		background: rgba(255, 255, 255, 5%);
	}
	strong {
		display: block;
		color: var(--surface);
		font-size: 1.0625rem;
	}
	p {
		margin: 0.55rem 0 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.9875rem;
		line-height: 1.55;
	}
	@media (max-width: 800px) {
		.rows {
			grid-template-columns: 1fr;
		}
	}
</style>
