---
// Scroll-reveal shared by the marketing pages.
// Drop <Reveal /> in <head> and mark the page's <main data-reveal>: its direct
// child <section>s rise into place as they enter the viewport, and any
// [data-stagger] group inside a revealed section arrives one child after another.
---

{/* set before paint, so sections are only hidden when the observer can reveal them */}
<script is:inline>
	document.documentElement.classList.add('js-reveal');
</script>

<script>
	const sections = document.querySelectorAll<HTMLElement>('main[data-reveal] > section');

	if (!('IntersectionObserver' in window)) {
		sections.forEach((section) => section.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		/* sections rise into place as they enter the viewport */
		html.js-reveal main[data-reveal] > section {
			opacity: 0;
			transform: translateY(24px);
			transition:
				opacity 0.7s ease,
				transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main[data-reveal] > section.is-visible {
			opacity: 1;
			transform: none;
		}

		/* card groups inside a revealed section arrive one after another */
		html.js-reveal main[data-reveal] > section [data-stagger] > * {
			opacity: 0;
			transform: translateY(18px);
			transition:
				opacity 0.6s ease,
				transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > * {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > :nth-child(2) {
			transition-delay: 0.09s;
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > :nth-child(3) {
			transition-delay: 0.18s;
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > :nth-child(4) {
			transition-delay: 0.27s;
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > :nth-child(5) {
			transition-delay: 0.36s;
		}
		html.js-reveal main[data-reveal] > section.is-visible [data-stagger] > :nth-child(6) {
			transition-delay: 0.45s;
		}
	}
</style>
