---
import CapterraLogo from '../assets/ratings/capterra.svg';
import GoogleLogo from '../assets/ratings/google.svg';

// Widget contents are illustrative product UI, not live data.
const features = [
	{
		title: 'Scheduling',
		copy: 'Book visits, cut no-shows, keep the day on track',
		widget: 'scheduling',
	},
	{
		title: 'EMR',
		copy: 'Charts, vitals, and history in one patient view',
		widget: 'emr',
	},
	{
		title: 'Billing',
		copy: 'Faster collections with fewer payment errors',
		widget: 'billing',
	},
	{
		title: 'Engagement',
		copy: 'Grow the panel with outreach that patients answer',
		widget: 'growth',
	},
];
---

<section class="features" id="features">
	<div class="panel">
		<div class="ratings">
			<span class="rating">
				<span class="tile"><CapterraLogo width={18} height={18} /></span>
				4.9 <span class="star">&#9733;</span> on Capterra
			</span>
			<span class="rating">
				<span class="tile"><GoogleLogo width={18} height={18} /></span>
				4.8 <span class="star">&#9733;</span> on Google
			</span>
		</div>
		<h2>Clinic software that covers the whole day</h2>

		<ul class="cards" data-stagger>
			{
				features.map((feature) => (
					<li class="card">
						<h3>{feature.title}</h3>
						<p>{feature.copy}</p>

						{feature.widget === 'scheduling' && (
							<div class="widget" aria-hidden="true">
								<p class="widget-title">Book an appointment</p>
								<div class="slots">
									<span class="slot">
										<svg viewBox="0 0 16 16" width="16" height="16">
											<circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
											<path d="M8 4.6V8l2.4 1.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
										</svg>
										11:30
									</span>
									<span class="slot">
										<svg viewBox="0 0 16 16" width="16" height="16">
											<circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
											<path d="M5.4 8h5.2M8.6 5.8 10.8 8l-2.2 2.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										12:00
									</span>
								</div>
								<p class="row">
									<svg viewBox="0 0 16 16" width="16" height="16">
										<rect x="1.8" y="3" width="12.4" height="11" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
										<path d="M1.8 6.6h12.4M5.4 1.8v2.4M10.6 1.8v2.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
									</svg>
									Monday, 20 March
								</p>
							</div>
						)}

						{feature.widget === 'emr' && (
							<div class="widget" aria-hidden="true">
								<div class="patient">
									<span class="avatar">EJ</span>
									<span class="patient-id">
										<strong>Emily Johnson</strong>
										<small>14 Feb 1985</small>
									</span>
									<span class="more">&hellip;</span>
								</div>
								<div class="vitals">
									<span><small>Temp</small><strong>98&deg;F</strong></span>
									<span><small>SpO&#8322;</small><strong>97%</strong></span>
									<span><small>BMI</small><strong>23.5</strong></span>
								</div>
							</div>
						)}

						{feature.widget === 'billing' && (
							<div class="widget widget-plain" aria-hidden="true">
								<div class="pay">
									<span class="pay-icon">
										<svg viewBox="0 0 16 16" width="15" height="15">
											<rect x="1.6" y="3.6" width="12.8" height="8.8" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
											<circle cx="8" cy="8" r="1.8" fill="currentColor" />
										</svg>
									</span>
									<span class="pay-id">
										<strong>Pay all at once</strong>
										<small>$950 today</small>
									</span>
									<span class="box"></span>
								</div>
								<div class="pay">
									<span class="pay-icon">
										<svg viewBox="0 0 16 16" width="15" height="15">
											<circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.4" />
											<path d="M8 8V1.6A6.4 6.4 0 0 1 14.4 8z" fill="currentColor" />
										</svg>
									</span>
									<span class="pay-id">
										<strong>Pay monthly</strong>
										<small>$237.50 &times; 4</small>
									</span>
									<span class="box box-on">
										<svg viewBox="0 0 16 16" width="12" height="12">
											<path d="m3.4 8.4 3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
								</div>
							</div>
						)}

						{feature.widget === 'growth' && (
							<div class="widget" aria-hidden="true">
								<p class="widget-title">Patient growth</p>
								<div class="chart">
									<span class="chart-ticks">
										<small>4k</small>
										<small>2k</small>
										<small>0</small>
									</span>
									<svg class="plot" viewBox="0 0 200 76" preserveAspectRatio="none">
										<line class="grid" x1="0" y1="8" x2="200" y2="8" />
										<line class="grid" x1="0" y1="36" x2="200" y2="36" />
										<line class="axis" x1="0" y1="64" x2="200" y2="64" />
										<path
											class="trend"
											d="M14 56C40 56 44 24 70 24s34 16 60 16 30-28 56-30"
											vector-effect="non-scaling-stroke"
										/>
										<circle cx="14" cy="56" r="3.4" />
										<circle cx="70" cy="24" r="3.4" />
										<circle cx="130" cy="40" r="3.4" />
										<circle cx="186" cy="10" r="3.4" />
									</svg>
									<span class="chart-months">
										<small>Jan</small>
										<small>Feb</small>
										<small>Mar</small>
										<small>Apr</small>
									</span>
								</div>
							</div>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.features {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 7.5rem 1.5rem 6rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}

	/* ratings */
	.ratings {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin: 0;
		color: var(--navy);
		font-weight: 600;
	}
	.rating {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.tile {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--surface);
	}
	.star {
		color: var(--brand-amber);
	}

	h2 {
		max-width: 24ch;
		margin: 1.25rem auto 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
	}

	/* cards */
	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		max-width: var(--page-max);
		margin: 3.25rem auto 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: flex;
		flex-direction: column;
		border-radius: 20px;
		padding: 2.5rem;
		background: var(--surface-tint);
		text-align: center;
	}
	.card h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.625rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}
	.card > p {
		margin: 1.25rem 0 2.5rem;
		color: var(--muted);
		line-height: 1.6;
	}

	/* widgets */
	.widget {
		margin-top: auto;
		border-radius: 12px;
		padding: 1rem;
		background: var(--surface);
		box-shadow: 0 6px 16px rgba(10, 37, 64, 6%);
		font-size: 0.875rem;
		text-align: left;
	}
	.widget-plain {
		padding: 0;
		background: none;
		box-shadow: none;
	}
	.widget-title {
		margin: 0 0 0.875rem;
		color: var(--navy);
		font-weight: 600;
		text-align: center;
	}

	/* scheduling */
	.slots {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
	}
	.slot,
	.row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 8px;
		padding: 0.625rem 0.75rem;
		background: var(--surface-tint);
		color: var(--navy);
	}
	.slot svg,
	.row svg {
		flex-shrink: 0;
		color: var(--brand-blue);
	}
	.row {
		margin: 0.75rem 0 0;
	}

	/* emr */
	.patient {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}
	.avatar {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--brand-teal), var(--brand-blue));
		color: var(--surface);
		font-size: 0.75rem;
		font-weight: 700;
	}
	.patient-id {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.patient-id strong {
		color: var(--navy);
	}
	.patient-id small,
	.pay-id small {
		color: var(--muted);
	}
	.more {
		margin-left: auto;
		color: var(--muted);
		letter-spacing: 0.1em;
	}
	.vitals {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 1rem;
		border-radius: 8px;
		padding: 0.625rem 0;
		background: var(--surface-tint);
		text-align: center;
	}
	.vitals span {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.vitals span + span {
		border-left: 1px solid var(--border);
	}
	.vitals small {
		color: var(--muted);
	}
	.vitals strong {
		color: var(--navy);
	}

	/* billing */
	.pay {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		border-radius: 12px;
		padding: 1rem;
		background: var(--surface);
		box-shadow: 0 6px 16px rgba(10, 37, 64, 6%);
	}
	.pay + .pay {
		margin-top: 0.625rem;
	}
	.pay-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: var(--surface-tint);
		color: var(--brand-blue);
	}
	.pay-id {
		display: flex;
		flex-direction: column;
		line-height: 1.3;
	}
	.pay-id strong {
		color: var(--navy);
	}
	.box {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		margin-left: auto;
		border-radius: 5px;
		background: var(--surface-tint);
	}
	.box-on {
		background: var(--brand-blue);
		color: var(--surface);
	}

	/* growth chart */
	.chart {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 0.5rem;
	}
	.chart-ticks {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 70px;
		color: var(--muted);
		font-size: 0.6875rem;
	}
	.plot {
		width: 100%;
		height: 70px;
		overflow: visible;
	}
	.plot .grid {
		stroke: var(--border);
		stroke-width: 1;
		stroke-dasharray: 4 4;
	}
	.plot .axis {
		stroke: var(--border);
		stroke-width: 1;
	}
	.plot .trend {
		fill: none;
		stroke: var(--brand-blue);
		stroke-width: 2.5;
		stroke-linecap: round;
	}
	.plot circle {
		fill: var(--brand-blue);
	}
	.chart-months {
		display: flex;
		justify-content: space-between;
		grid-column: 2;
		margin-top: 0.375rem;
		color: var(--muted);
		font-size: 0.6875rem;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 5rem 1.5rem 4rem;
		}
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3.5rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
		.card {
			padding: 1.75rem 1.25rem;
		}
		.card h3 {
			font-size: 1.5rem;
		}
		.card > p {
			margin: 0.75rem 0 1.75rem;
		}
	}
</style>
