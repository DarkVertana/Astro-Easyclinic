---
import SectionHead from '../SectionHead.astro';
import { comparisonIndex } from '../market-comparison/data';
---

<section class="comparisons" id="comparisons">
	<div class="inner">
		<SectionHead
			eyebrow="Comparisons"
			title="Market comparison guides"
			lede="Short, honest shortlists — AI, WhatsApp, and local pay/compliance without fake certifications."
		/>
		<ul class="list" data-stagger>
			{
				comparisonIndex.map((item) => (
					<li>
						<a href={item.href}>Best clinic software · {item.geo}</a>
					</li>
				))
			}
		</ul>
		<p class="more">
			<a href="/best-clinic-management-software-kenya">Best clinic software · Kenya</a>
			<a href="/best-clinic-management-software-india">Best clinic software · India</a>
			<a href="/dental-emr-software">Dental EMR</a>
			<a href="/dermatology-emr-software">Dermatology EMR</a>
			<a href="/easyclinic-vs-practo">EasyClinic vs Practo</a>
			<a href="/easyclinic-vs-healthplix">vs HealthPlix</a>
			<a href="/easyclinic-vs-kenyaemr">vs KenyaEMR</a>
			<a href="/easyclinic-emr-vs-traditional-emr">vs Traditional EMR</a>
		</p>
	</div>
</section>

<style>
	.comparisons {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		max-width: 1040px;
		margin: 2.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		border: 1px solid rgba(10, 37, 64, 8%);
		border-radius: 14px;
		padding: 0.95rem 1.1rem;
		background: var(--surface);
		color: var(--navy);
		font-weight: 650;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	a:hover {
		border-color: rgba(14, 116, 144, 35%);
		color: var(--brand-blue);
	}
	.more {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.25rem;
		margin: 1.75rem 0 0;
	}
	.more a {
		border: 0;
		padding: 0;
		background: none;
		color: var(--brand-blue);
	}
	@media (max-width: 860px) {
		.list {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.list {
			grid-template-columns: 1fr;
		}
	}
</style>
