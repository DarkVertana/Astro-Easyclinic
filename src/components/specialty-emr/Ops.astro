---
import SectionHead from '../SectionHead.astro';
import type { Specialty } from './data';

interface Props {
	specialty: Specialty;
}

const { specialty } = Astro.props;
---

<section class="ops">
	<div class="inner">
		<SectionHead eyebrow={specialty.opsEyebrow} title={specialty.opsTitle} lede={specialty.opsLede} />

		<ul class="chips" data-stagger>
			{
				specialty.ops.map((item) => (
					<li>
						<span class="tick" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
								<path d="m5 13 4 4L19 7" />
							</svg>
						</span>
						{item}
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.ops {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.875rem;
		max-width: 980px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 0.95rem 1.25rem;
		background: var(--surface-tint);
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.tick {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 8px;
		background: var(--brand-wash-deep);
		color: var(--brand-blue);
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem 3.5rem;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem 3rem;
		}
		.chips {
			margin-top: 2.25rem;
		}
		.chips li {
			width: 100%;
		}
	}
</style>
