---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../SectionHead.astro';
import clientsPhoto from '../../assets/about/clients.png';
import gaurab from '../../assets/about/gaurab.png';
import girish from '../../assets/about/girish-mohata.jpg';
import mrinal from '../../assets/about/mrinal-pasari.jpg';
import subhashish from '../../assets/about/subhashish.png';
import vikas from '../../assets/about/vikas-malpani.jpg';

const team = [
	{
		name: 'Girish Mohata',
		role: 'Founder & CEO',
		photo: girish,
		copy: 'Powers some of the largest and most complex healthcare clinics across the globe, with multiple profitable tech exits behind him.',
	},
	{
		name: 'Mrinal Pasari',
		role: 'Co-Founder',
		photo: mrinal,
		copy: 'Enterprise architect with 20 years across banking, insurance, healthcare, telecom and ERP systems.',
	},
	{
		name: 'Vikas Malpani',
		role: 'Director, Business Growth & Strategy',
		photo: vikas,
		copy: 'Entrepreneur and business strategist known for forward-thinking leadership and value creation through technology.',
	},
	{
		name: 'Gaurab Chatterjee',
		role: 'Head of Software Development',
		photo: gaurab,
		copy: 'Technology specialist with 16+ years across the software lifecycle, leading large-scale delivery at Easy Clinic since 2010.',
	},
	{
		name: 'Subhashish Saha',
		role: 'Head of Customer Success',
		photo: subhashish,
		copy: 'Leading customer success since 2012, making sure every clinic gets seamless service and unparalleled support.',
	},
	{
		name: 'Chief Product Officers',
		role: 'Our 5,000+ users',
		photo: clientsPhoto,
		copy: 'Our roadmap is steered by 5,000+ users. Their feedback and daily experience make them the true architects of Easy Clinic.',
	},
];

// candid team photos from the live page carousel
const momentModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/about/gallery/moment-*.jpg',
	{ eager: true }
);
const moments = Object.keys(momentModules)
	.sort()
	.map((key) => momentModules[key].default);
---

<section class="team">
	<div class="inner">
		<SectionHead
			eyebrow="People"
			title="Meet the Easy Clinic Dream Team"
			lede="Easy Clinic is Novel Medicare Solutions Pvt Ltd, a group that has been in the clinic with doctors since 2003."
		/>
		<ul class="content" data-stagger>
			{
				team.map((person) => (
					<li class="card">
						<Image
							class="photo"
							src={person.photo}
							alt={`${person.name}, ${person.role}`}
							width={360}
							height={360}
							densities={[1, 2]}
						/>
						<h3>{person.name}</h3>
						<p class="role">{person.role}</p>
						<p>{person.copy}</p>
					</li>
				))
			}
		</ul>

		<p class="closing">
			Easy Clinic is the result of a team devoted to the pursuit of excellence, setting new
			standards in healthcare solutions.
		</p>
		<div class="moments" data-stagger>
			{
				moments.map((photo, index) => (
					<Image
						src={photo}
						alt={`The Easy Clinic team at work, photo ${index + 1}`}
						width={420}
						height={280}
						densities={[1, 2]}
					/>
				))
			}
		</div>
	</div>
</section>
<style>
	.team {
		background: var(--navy);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem;
		background: var(--surface);
	}
	.content {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.card {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 2rem 1.75rem;
		background: var(--surface-tint);
		text-align: center;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		border-color: var(--brand-blue);
		box-shadow: 0 16px 36px rgba(10, 37, 64, 10%);
		transform: translateY(-4px);
	}
	.card :global(img.photo) {
		display: block;
		width: 104px;
		height: 104px;
		margin: 0 auto 1.15rem;
		border: 3px solid var(--surface);
		border-radius: 50%;
		object-fit: cover;
		object-position: top;
		outline: 2px solid var(--brand-wash-deep);
		box-shadow: 0 10px 24px rgba(10, 37, 64, 14%);
		transition: outline-color 0.2s ease;
	}
	.card:hover :global(img.photo) {
		outline-color: var(--brand-blue);
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
	}
	.role {
		margin: 0.25rem 0 0;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.card p:last-child {
		margin: 0.75rem 0 0;
		color: var(--muted);
	}
	.closing {
		max-width: 46ch;
		margin: 4.5rem auto 0;
		color: var(--navy);
		font-size: clamp(1.25rem, 2.2vw, 1.625rem);
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.01em;
		text-align: center;
	}
	.moments {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
	}
	.moments :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 3 / 2;
		border-radius: 16px;
		object-fit: cover;
		transition: transform 0.25s ease;
	}
	.moments :global(img:hover) {
		transform: scale(1.02);
	}
	/* the first photo anchors the mosaic */
	.moments :global(img:first-child) {
		grid-column: span 2;
		grid-row: span 2;
		aspect-ratio: auto;
	}
	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem;
		}
		.content {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem;
		}
		.content {
			margin-top: 2.25rem;
			grid-template-columns: 1fr;
		}
		.closing {
			margin-top: 3rem;
		}
		.moments {
			gap: 0.75rem;
			grid-template-columns: 1fr 1fr;
		}
		.moments :global(img:first-child) {
			grid-column: span 2;
			grid-row: auto;
			aspect-ratio: 3 / 2;
		}
	}
</style>
