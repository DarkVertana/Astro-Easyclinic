---
import SectionHead from '../SectionHead.astro';
import type { VsPageData } from './types';

interface Props {
	data: VsPageData['tests'];
}

const { data } = Astro.props;
---

<section class="tests">
	<div class="inner">
		<SectionHead eyebrow={data.eyebrow} title={data.title} lede={data.lede} />
		<ol class="grid" data-stagger>
			{
				data.items.map((item, i) => (
					<li>
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
						<strong>{item.title}</strong>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.tests {
		background: var(--surface);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 2.75rem auto 0;
		padding: 0;
		list-style: none;
		counter-reset: none;
	}
	.grid li {
		border: 1px solid rgba(10, 37, 64, 8%);
		border-radius: 18px;
		padding: 1.5rem 1.55rem 1.6rem;
		background: #fff;
	}
	.num {
		display: block;
		color: var(--brand-teal);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.06em;
	}
	strong {
		display: block;
		margin-top: 0.45rem;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	p {
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.9875rem;
		line-height: 1.6;
	}
	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
