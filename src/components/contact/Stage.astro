---
const channels = [
	{
		label: 'Email us',
		value: 'hello@easyclinic.io',
		href: 'mailto:hello@easyclinic.io',
		note: 'We read every message.',
		icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
	},
	{
		label: 'Call us',
		value: '+91 91477 70277',
		href: 'tel:+919147770277',
		note: 'Talk to someone on the clinic software team.',
		icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c1 .3 2 .5 3 .6a2 2 0 0 1 1.6 2Z"/>',
	},
	{
		label: 'Visit us',
		value: '30 Circus Avenue, Kolkata - 700 017, India',
		href: 'https://maps.google.com/?q=30+Circus+Avenue+Kolkata',
		note: 'Novel Medicare Solutions Pvt Ltd.',
		icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
	},
];

---

<section class="stage">
	<div class="panel">
		<div class="grid">
			<div class="support">
				<p class="eyebrow">Support</p>
				<h2>Reach people who know the product</h2>
				<p class="lede">
					Book a demo, ask a billing question, or get help going live, the same EasyClinic team
					stays with you.
				</p>
				<ul data-stagger>
					{
						channels.map((item) => (
							<li>
								<a href={item.href}>
									<span class="chip" aria-hidden="true">
										<svg
											viewBox="0 0 24 24"
											width="20"
											height="20"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={item.icon}
										/>
									</span>
									<span class="body">
										<small>{item.label}</small>
										<strong>{item.value}</strong>
										<span>{item.note}</span>
									</span>
									<span class="go" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M5 12h14"></path>
											<path d="m12 5 7 7-7 7"></path>
										</svg>
									</span>
								</a>
							</li>
						))
					}
				</ul>

				<figure class="quote">
					<blockquote>
						What has impressed me is the dedication of the support team after the installation. The
						team especially my dedicated account manager have been there to support my Clinic with
						great enthusiasm and concern.
					</blockquote>
					<figcaption>
						<strong>Dr. J J Thakkar</strong>
						<span>Laser Stone &amp; Endoscopy Centre, Nairobi</span>
					</figcaption>
				</figure>
			</div>

			<div class="form-wrap">
				<svg class="form-dots" viewBox="0 0 120 120" aria-hidden="true">
					{
						Array.from({ length: 25 }, (_, i) => (
							<circle cx={8 + (i % 5) * 26} cy={8 + Math.floor(i / 5) * 26} r="3.5" fill="var(--brand-blue)" opacity="0.3" />
						))
					}
				</svg>
			{/* No backend endpoint yet: submissions hand off to WhatsApp or the
			   visitor's email client. Wire a real POST endpoint here at launch. */}
			<form id="demo-form" class="form" method="post">
				<p class="eyebrow">Book a demo</p>
				<h2>Book a clinic software demo</h2>
				<p class="lede">
					Share a few details and we'll walk through EMR, scheduling, and billing for your clinic.
				</p>

				<div class="fields">
					<label>
						<span>Name</span>
						<input type="text" name="Name" autocomplete="name" required />
					</label>
					<label>
						<span>Clinic name</span>
						<input type="text" name="Clinic" autocomplete="organization" required />
					</label>
					<label>
						<span>Email</span>
						<input type="email" name="Email" autocomplete="email" required />
					</label>
					<label>
						<span>Phone</span>
						<input type="tel" name="Phone" autocomplete="tel" required />
					</label>
					<label class="wide">
						<span>Message</span>
						<textarea name="Message" rows="4"></textarea>
					</label>
				</div>
				<button class="btn btn-solid" type="submit">Send request</button>
				<p class="hint">Opens your email to hello@easyclinic.io, nothing is stored on this site.</p>
			</form>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('#demo-form');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!form.reportValidity()) return;

		const data = new FormData(form);
		const name = String(data.get('Name') ?? '').trim();
		const lines = [...data.entries()]
			.map(([key, value]) => `${key}: ${String(value).trim()}`)
			.filter((line) => !line.endsWith(': '));
		const subject = name ? `Demo request from ${name}` : 'Demo request';
		window.location.href = `mailto:hello@easyclinic.io?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
	});
</script>
<style>
	.stage {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 34rem);
		justify-content: space-between;
		gap: 4rem;
		max-width: var(--page-max);
		margin: 0 auto;
		align-items: start;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0;
		max-width: 18ch;
		color: var(--navy);
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1rem 0 0;
		max-width: 42ch;
		color: var(--muted);
		font-size: 1.0625rem;
	}

	.support ul {
		display: grid;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.support > ul > li + li {
		border-top: 1px solid var(--border);
	}
	.support ul a {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		border-radius: 16px;
		margin-inline: -1rem;
		padding: 1.35rem 3rem 1.35rem 1rem;
		color: inherit;
		text-decoration: none;
		transition: background 0.2s ease;
	}
	.support ul a:hover {
		background: var(--brand-wash);
	}
	.support ul a:hover strong {
		color: var(--brand-blue);
	}
	.go {
		position: absolute;
		top: 50%;
		right: 1.15rem;
		display: grid;
		place-items: center;
		color: var(--brand-blue);
		opacity: 0;
		transform: translate(-6px, -50%);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}
	.support ul a:hover .go {
		opacity: 1;
		transform: translate(0, -50%);
	}
	.chip {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.support a:hover .chip {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}
	.support small {
		color: var(--brand-blue);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.support strong {
		color: var(--navy);
		font-size: 1.0625rem;
		font-weight: 700;
		transition: color 0.2s ease;
	}
	.body > span {
		color: var(--muted);
		font-size: 0.875rem;
	}


	/* support quote card */
	.quote {
		margin: 2.25rem 0 0;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 16px;
		padding: 1.5rem 1.5rem 1.35rem;
		background: var(--brand-wash);
	}
	.quote blockquote {
		margin: 0;
		border: none;
		padding: 0;
		color: var(--navy);
		font-size: 0.9875rem;
		line-height: 1.6;
	}
	.quote figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.6rem;
		margin-top: 0.85rem;
	}
	.quote strong {
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 700;
	}
	.quote figcaption span {
		color: var(--muted);
		font-size: 0.875rem;
	}

	.form-wrap {
		position: relative;
	}
	.form-dots {
		position: absolute;
		top: -1.75rem;
		right: -1.5rem;
		z-index: 0;
		width: 105px;
		height: 105px;
	}
	.form {
		position: relative;
		z-index: 1;
		border: 1px solid var(--border);
		border-radius: 24px;
		padding: 2.5rem;
		background: var(--surface);
		box-shadow: 0 24px 56px rgba(10, 37, 64, 8%);
		scroll-margin-top: 6rem;
	}
	.form h2 {
		max-width: none;
	}
	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.1rem 1rem;
		margin-top: 1.75rem;
	}
	.form label {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		color: var(--navy);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.form label.wide {
		grid-column: 1 / -1;
	}
	.form input,
	.form textarea {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		border: 1.5px solid transparent;
		border-radius: 12px;
		padding: 0.85rem 1rem;
		background: var(--surface-tint);
		color: var(--ink);
		font-family: inherit;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.4;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			box-shadow 0.15s ease;
	}
	.form input:hover,
	.form textarea:hover {
		border-color: var(--brand-wash-deep);
	}
	.form input:focus,
	.form textarea:focus {
		border-color: var(--brand-blue);
		background: var(--surface);
		outline: none;
		box-shadow: 0 0 0 3px var(--brand-wash-deep);
	}
	.form textarea {
		resize: vertical;
		min-height: 6.5rem;
	}
	.btn {
		display: block;
		width: 100%;
		margin-top: 1.5rem;
		border-radius: 12px;
		padding: 0.95rem 1.25rem;
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.2;
		text-align: center;
		cursor: pointer;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.hint {
		margin: 0.85rem 0 0;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 400;
		text-align: center;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 4rem;
		}
		.grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		h2 {
			max-width: none;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3.5rem;
		}
		.form {
			padding: 1.5rem 1.15rem 1.65rem;
		}
		.fields {
			grid-template-columns: 1fr;
		}
	}
</style>
