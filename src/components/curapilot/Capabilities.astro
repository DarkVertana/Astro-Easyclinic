---
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import clinical from '../../assets/curapilot/clinical.webp';
import financial from '../../assets/curapilot/financial.webp';
import operational from '../../assets/inventory-dashboard.webp';
import { capabilityGroups } from './data';

const groupImages = {
	clinical: { src: clinical, alt: 'A clinician working on a laptop with a stethoscope beside it' },
	operations: { src: operational, alt: 'Easy Clinic inventory and pharmacy dashboards' },
	revenue: { src: financial, alt: 'Billing paperwork with a calculator' },
} as const;
---

<section class="capabilities">
	<div class="inner">
		<SectionHead
			eyebrow="What it does"
			title="One intelligence layer, working everywhere your clinic does"
			lede="CuraPilot is not a chatbot bolted onto the side of your software. Its capabilities read from the same live record and feed each other: the prescription informs the claim, the claim informs the ledger, the ledger informs the reorder."
		/>

		<div class="groups">
			{
				capabilityGroups.map((group, index) => (
					<div class="group">
						<div class="intro">
							<p class="index">{String(index + 1).padStart(2, '0')}</p>
							<h3>{group.label}</h3>
							<p class="blurb">{group.blurb}</p>
							{groupImages[group.id as keyof typeof groupImages] && (
								<Image
									class="group-img"
									src={groupImages[group.id as keyof typeof groupImages].src}
									alt={groupImages[group.id as keyof typeof groupImages].alt}
									width={640}
									height={440}
									densities={[1, 1.5]}
								/>
							)}
						</div>
						<ul class="items" data-stagger>
							{group.items.map((item) => (
								<li>
									<span class="chip" aria-hidden="true">
										<svg
											viewBox="0 0 24 24"
											width="20"
											height="20"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
											set:html={item.icon}
										/>
									</span>
									<div class="body">
										<h4>{item.title}</h4>
										<p>{item.copy}</p>
									</div>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
<style>
	.capabilities {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5.5rem 1.5rem;
	}

	.groups {
		max-width: 1100px;
		margin: 1.5rem auto 0;
	}
	.group {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.7fr);
		gap: 2rem 4rem;
		border-top: 1px solid var(--border);
		padding: 3rem 0;
	}
	.group:first-child {
		border-top: 0;
		padding-top: 2.5rem;
	}
	.group:last-child {
		padding-bottom: 0;
	}

	.intro {
		position: sticky;
		top: 2rem;
		align-self: start;
	}
	.index {
		margin: 0;
		color: var(--brand-teal);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.intro h3 {
		margin: 0.5rem 0 0;
		color: var(--navy);
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.blurb {
		margin: 0.75rem 0 0;
		max-width: 30ch;
		color: var(--muted);
		font-size: 1rem;
	}
	.intro :global(img.group-img) {
		display: block;
		width: 100%;
		max-width: 340px;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		margin-top: 1.5rem;
		border-radius: 16px;
		box-shadow: 0 16px 36px rgba(10, 37, 64, 12%);
	}

	.items {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.items li {
		display: flex;
		align-items: flex-start;
		gap: 1.15rem;
		border-radius: 16px;
		margin-inline: -1rem;
		padding: 1.15rem 1rem;
		transition: background 0.2s ease;
	}
	.items li + li {
		border-top: 1px solid var(--border);
	}
	.items li:hover {
		background: var(--brand-wash);
	}
	.chip {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.items li:hover .chip {
		background: var(--brand-blue);
		color: var(--surface);
	}
	h4 {
		margin: 0.15rem 0 0;
		color: var(--navy);
		font-size: 1.0625rem;
		font-weight: 700;
		transition: color 0.2s ease;
	}
	.items li:hover h4 {
		color: var(--brand-blue);
	}
	.body p {
		margin: 0.35rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem;
		}
		.group {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2.5rem 0;
		}
		.intro {
			position: static;
		}
		.blurb {
			max-width: none;
		}
		.intro :global(img.group-img) {
			max-width: 420px;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem;
		}
		.items li {
			margin-inline: 0;
			padding: 1rem 0;
			border-radius: 0;
		}
		.items li:hover {
			background: transparent;
		}
	}
</style>
