---
import PageHero from '../PageHero.astro';

const facts = [
	{ value: '39,849', label: 'Visits reviewed' },
	{ value: 'Peer-reviewed', label: 'Published study' },
	{ value: 'Advisory', label: 'Doctor in charge' },
];
---

<PageHero
	eyebrow="Cura AI"
	title="AI EMR copilot built into your clinic systems"
	lede="CuraPilot sits on your EMR and hospital systems — sharper clinical decisions, tighter operations, and revenue you can trace."
	secondaryHref="/pricing"
	secondaryLabel="View Pricing"
>
	<div class="card">
		<p class="card-label">CuraPilot</p>
		<ul class="rows">
			{
				facts.map((item) => (
					<li class="fact">
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</PageHero>
