---
import SectionHead from '../SectionHead.astro';
import type { GeoMarket, ModuleIcon } from './data';

interface Props {
	market: GeoMarket;
}

const { market } = Astro.props;

const icons: Record<ModuleIcon, string> = {
	chart: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M12 11v6"/><path d="M9 14h6"/>',
	calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="M8 2v4"/><path d="M16 2v4"/>',
	receipt: '<path d="M5 3v18l2.5-1.6L10 21l2-1.6L14 21l2.5-1.6L19 21V3Z"/><path d="M9 8h6"/><path d="M9 12h6"/>',
	pill: '<rect x="2.5" y="8.5" width="19" height="7" rx="3.5" transform="rotate(-45 12 12)"/><path d="M8.5 8.5 15.5 15.5"/>',
	flask: '<path d="M9 2v6.2L4.3 17A2 2 0 0 0 6 20h12a2 2 0 0 0 1.7-3L15 8.2V2"/><path d="M8 2h8"/><path d="M7.5 14h9"/>',
	graph: '<path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-7"/><path d="M22 20H2"/>',
	chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12Z"/><path d="M9 11h6"/><path d="M9 15h3"/>',
	spark: '<path d="M12 3v4"/><path d="M12 17v4"/><path d="m5.6 5.6 2.9 2.9"/><path d="m15.5 15.5 2.9 2.9"/><path d="M3 12h4"/><path d="M17 12h4"/><path d="m5.6 18.4 2.9-2.9"/><path d="m15.5 8.5 2.9-2.9"/>',
};
---

<section class="modules">
	<div class="inner">
		<SectionHead eyebrow={market.modulesEyebrow} title={market.modulesTitle} lede={market.modulesLede} />

		<ul class="bento" data-stagger>
			{
				market.modules.map((item) => (
					<li class:list={[item.accent && 'accent']}>
						<span class="mi" aria-hidden="true">
							<svg
								viewBox="0 0 24 24"
								width="19"
								height="19"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>

		<p class="links">
			<a href="/features">Explore all features</a>
			<span aria-hidden="true">·</span>
			<a href="/curapilot">Meet Cura AI</a>
			<span aria-hidden="true">·</span>
			<a href="/pricing">View pricing</a>
		</p>
	</div>
</section>
<style>
	.modules {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
	}

	.bento {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}
	.bento li {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.5rem;
		background: var(--surface-tint);
	}
	.accent {
		border-color: var(--brand-wash-deep);
		background: var(--brand-wash);
	}

	.mi {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.accent .mi {
		background: var(--surface);
		color: var(--brand-teal);
	}

	h3 {
		margin: 1.15rem 0 0;
		color: var(--navy);
		font-size: 1.0625rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.bento p {
		margin: 0.6rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin: 2.75rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.links a {
		color: var(--brand-blue);
		font-weight: 600;
		text-decoration: none;
	}
	.links a:hover {
		text-decoration: underline;
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem 3.5rem;
		}
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem 3rem;
		}
		.bento {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
