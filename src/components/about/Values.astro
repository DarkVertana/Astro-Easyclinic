---
import SectionHead from '../SectionHead.astro';

// small stroke icons (24×24, currentColor)
const icons: Record<string, string> = {
	zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
	shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
	star: '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z"/>',
	users:
		'<circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.9 3.1-6.5 7-6.5s7 2.6 7 6.5"/><path d="M16 3.6a4 4 0 0 1 0 8.8"/><path d="M19 15.1c1.9.9 3 2.8 3 5.9"/>',
	heart:
		'<path d="M19.5 13.1 12 20.5l-7.5-7.4A5 5 0 1 1 12 6.4a5 5 0 1 1 7.5 6.7Z"/>',
	refresh:
		'<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
};

const values = [
	{
		title: 'Innovation',
		icon: 'zap',
		copy: 'We keep exploring new technologies so our clients stay at the forefront of healthcare management.',
	},
	{
		title: 'Integrity',
		icon: 'shield',
		copy: 'We operate with transparency and the highest ethical standards, the foundation of long-lasting client relationships.',
	},
	{
		title: 'Excellence',
		icon: 'star',
		copy: 'From product to support, we hold every interaction with Easy Clinic to the same standard of quality.',
	},
	{
		title: 'Collaboration',
		icon: 'users',
		copy: 'The best solutions are built together, within our team and with the clinicians who use them.',
	},
	{
		title: 'Customer Success',
		icon: 'heart',
		copy: "We tailor our work to grow our clients' practices, not just install software.",
	},
	{
		title: 'Adaptability',
		icon: 'refresh',
		copy: 'Healthcare keeps evolving, and so do we, keeping our clients competitive and relevant.',
	},
];
---

<section class="values">
	<div class="inner">
		<SectionHead
			eyebrow="Our values"
			title="Values That Shape Us"
			lede="Our commitment to you and to healthcare, six principles behind every product decision and support call."
		/>
		<ul class="content" data-stagger>
			{
				values.map((item) => (
					<li class="card">
						<span class="chip" aria-hidden="true">
							<svg
								viewBox="0 0 24 24"
								width="20"
								height="20"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.values {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2.75rem 1.5rem 5.5rem;
	}
	.content {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}
	.card {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.75rem;
		background: var(--surface-tint);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		border-color: var(--brand-blue);
		box-shadow: 0 16px 36px rgba(10, 37, 64, 10%);
		transform: translateY(-4px);
	}
	.chip {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 1.1rem;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}
	.card:hover .chip {
		background: var(--brand-blue);
		color: var(--surface);
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.15rem;
		font-weight: 700;
	}
	.card p {
		margin: 0.65rem 0 0;
		color: var(--muted);
	}
	@media (max-width: 1080px) {
		.inner {
			padding: 2rem 1.5rem 4rem;
		}
		.content {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 1.5rem 1rem 3rem;
		}
		.content {
			margin-top: 2.25rem;
			grid-template-columns: 1fr;
		}
	}
</style>
