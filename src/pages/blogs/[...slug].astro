---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Cta from '../../components/Cta.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Marketing from '../../layouts/Marketing.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Marketing title={`${post.data.title} — ${SITE_TITLE}`} description={post.data.description} mainClass="blog-post">
	<section class="hero">
		<div class="inner">
			<p class="eyebrow">
				<a href="/blogs">Resources</a>
			</p>
			<h1>{post.data.title}</h1>
			<p class="meta">
				<FormattedDate date={post.data.pubDate} />
				{post.data.author && <span>{post.data.author}</span>}
			</p>
		</div>
	</section>

	<section class="article">
		<div class="panel">
			{
				post.data.heroImage && (
					<Image
						class="shot"
						src={post.data.heroImage}
						alt=""
						widths={[720, 1080, 1320]}
						sizes="(max-width: 1080px) 92vw, 760px"
					/>
				)
			}
			<div class="prose">
				<Content />
			</div>
		</div>
	</section>

	<Cta />
</Marketing>

<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: 760px;
		margin: 0 auto;
		padding: 4rem 1.5rem 3.5rem;
	}
	.eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.eyebrow a {
		color: var(--brand-blue);
		text-decoration: none;
	}
	.eyebrow a:hover {
		color: var(--brand-blue-dark);
	}
	h1 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.6vw, 2.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.15rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.article {
		background: var(--brand-wash);
	}
	.panel {
		max-width: 760px;
		margin: 0 auto;
		border-radius: 24px 24px 0 0;
		padding: 2.5rem 1.5rem 4rem;
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.7;
	}
	.shot {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		margin: 0 0 2rem;
		border-radius: 16px;
		object-fit: cover;
	}
	.prose :global(h2),
	.prose :global(h3) {
		margin: 2rem 0 0.75rem;
		color: var(--navy);
	}
	.prose :global(p) {
		margin: 0 0 1.15rem;
		color: var(--muted);
	}
	.prose :global(a) {
		color: var(--brand-blue);
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.15rem;
		padding-left: 1.25rem;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.inner {
			padding: 2.75rem 1rem 2.5rem;
		}
		.panel {
			padding: 1.5rem 1rem 3rem;
		}
	}
</style>
