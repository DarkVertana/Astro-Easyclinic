								</div>
								<div class="field">
									<label for="email">Email <span class="req" aria-hidden="true">*</span></label>
									<input
										id="email"
										name="email"
										type="email"
										placeholder="Email"
										autocomplete="email"
										required
									/>
								</div>
								<div class="field" data-phone>
									<span class="phone-label">
										<button
											class="dial"
											type="button"
											aria-haspopup="listbox"
											aria-expanded="false"
											aria-label={`Country code: ${HOME.name} ${HOME.dial}`}
											data-dial-button
										>
											<span class="flag" style={`--row:${HOME.flag}`} data-dial-flag aria-hidden="true" />
											<svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
												<path
													d="m4 6.5 4 4 4-4"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"></path>
