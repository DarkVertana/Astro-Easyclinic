---
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/about/hero.png';

const pillars = [
	{
		title: 'Vision',
		icon: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3.2" fill="currentColor"/>',
		copy: 'To be the leading provider of innovative healthcare management solutions, revolutionising the way clinics operate and enhancing the quality of patient care globally.',
	},
	{
		title: 'Mission',
		icon: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/>',
		copy: 'Our mission at Easy Clinic is to empower healthcare organisations with advanced, intuitive software solutions that streamline clinic operations and improve patient outcomes. By harnessing the power of AI, we aim to foster a more efficient, integrated and smart healthcare ecosystem.',
	},
];
---

<section class="hero">
	<div class="inner">
		<header class="head">
			<h1>Commitment to Streamline Your<br /> Clinic Operations</h1>
			<p class="lede">
				Established in 2003, Easy Clinic has grown into a leading provider of premium medical software,
				serving thousands across 18 countries. Renowned for our user-friendly, world-class healthcare
				solutions and unmatched customer support, we’ve consistently delivered excellence and
				affordability, earning high praise from our global user base.
			</p>
		</header>

		<div class="grid">
			<figure class="photo">
				<Image
					src={heroPhoto}
					alt="A clinician working in the Easy Clinic EMR on a laptop"
					width={603}
					height={613}
					densities={[1, 1.5]}
					loading="eager"
				/>
			</figure>

			<ul class="pillars">
				{
					pillars.map((item) => (
						<li>
							<span class="icon" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									width="40"
									height="40"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={item.icon}
								/>
							</span>
							<h2>{item.title}</h2>
							<p>{item.copy}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: 72rem;
		margin: 0 auto;
		padding: 3.5rem 1.5rem 5rem;
	}

	.head {
		text-align: center;
	}
	h1 {
		margin: 0 auto;
		color: var(--navy);
		font-size: clamp(2.125rem, 3.8vw, 2.875rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}
	.lede {
		max-width: 47rem;
		margin: 1rem auto 0;
		color: #333;
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 532fr) minmax(0, 477fr);
		align-items: center;
		gap: 3.9rem;
		margin-top: 5.25rem;
	}
	.photo {
		margin: 0;
	}
	.photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 14px;
	}

	.pillars {
		display: grid;
		gap: 2.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.icon {
		display: grid;
		place-items: center;
		width: 70px;
		height: 70px;
		border-radius: 6px;
		background: var(--brand-blue);
		color: var(--surface);
	}
	.pillars h2 {
		margin: 1rem 0 0;
		color: var(--navy);
		font-size: 1.1875rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.pillars p {
		max-width: 30.5rem;
		margin: 0.15rem 0 0;
		color: #333;
		font-size: 1.125rem;
		line-height: 1.55;
	}

	@media (max-width: 900px) {
		h1 br {
			display: none;
		}
		.grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			margin-top: 3rem;
		}
		.photo {
			max-width: 32rem;
			margin-inline: auto;
		}
		.pillars p {
			max-width: none;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.5rem 1rem 3.5rem;
		}
	}
</style>
