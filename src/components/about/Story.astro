---
const pillars = [
	{
		title: 'Vision',
		copy: 'To be the leading provider of innovative healthcare management solutions — changing how clinics operate and raising the quality of patient care globally.',
	},
	{
		title: 'Mission',
		copy: 'Empower healthcare organisations with software that is advanced and actually usable. Streamline operations, improve outcomes, and build a more efficient, integrated, and smart healthcare ecosystem with AI.',
	},
];
---

<section class="story">
	<div class="panel">
		<p class="eyebrow">Why we exist</p>
		<h2>A product team that still answers the phone</h2>
		<p class="lede">
			Renowned for user-friendly healthcare software and unmatched customer support, we have stayed
			with the same brief since 2003: excellence, affordability, and a team that shows up.
		</p>
		<ul data-stagger>
			{
				pillars.map((item) => (
					<li>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.story {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 2rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}
	h2 {
		max-width: 18ch;
		margin: 0.85rem auto 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.lede {
		max-width: 54ch;
		margin: 1.15rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		text-align: center;
	}
	ul {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	li {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.75rem;
		background: var(--surface-tint);
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
	}
	li p {
		margin: 0.75rem 0 0;
		color: var(--muted);
	}
	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 1.5rem;
		}
		ul {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 1rem;
		}
	}
</style>
