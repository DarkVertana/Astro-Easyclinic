---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// client logos from the live about page, named by file
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/about/clients/*.jpg',
	{ eager: true }
);
const clients = Object.entries(logoModules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod]) => {
		const slug = path.split('/').pop()!.replace('.jpg', '');
		const name = slug
			.split('-')
			.map((word) => (word.length <= 2 ? word.toUpperCase() : word[0].toUpperCase() + word.slice(1)))
			.join(' ')
			.replace(/^Dr /, 'Dr. ');
		return { image: mod.default, name };
	});
---

<section class="clients">
	<div class="inner" data-clients>
		<h2>Empowering Healthcare Organisations Worldwide</h2>

		<div class="slider">
			<button type="button" class="arrow" data-scroll="prev" aria-label="Previous clients">
				<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m15 5-7 7 7 7" />
				</svg>
			</button>

			<ul class="track" data-track aria-label="Our clients">
				{
					clients.map((client) => (
						<li class="slide" data-card>
							<Image src={client.image} alt={client.name} width={240} height={100} densities={[1, 2]} />
						</li>
					))
				}
			</ul>

			<button type="button" class="arrow" data-scroll="next" aria-label="Next clients">
				<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m9 5 7 7-7 7" />
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	import { initCarousel } from '../../scripts/carousel';

	initCarousel('[data-clients]');

	// Gentle autoplay: one logo every few seconds, back to the start at the end.
	// Pauses while the visitor hovers, focuses or touches the slider.
	const root = document.querySelector<HTMLElement>('[data-clients]');
	const track = root?.querySelector<HTMLElement>('[data-track]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (root && track && !reduceMotion) {
		let paused = false;
		const pause = () => (paused = true);
		const resume = () => (paused = false);

		root.addEventListener('pointerenter', pause);
		root.addEventListener('pointerleave', resume);
		root.addEventListener('focusin', pause);
		root.addEventListener('focusout', resume);
		track.addEventListener('touchstart', pause, { passive: true });

		setInterval(() => {
			if (paused || document.hidden) return;
			const end = track.scrollWidth - track.clientWidth;
			if (end <= 0) return;
			if (track.scrollLeft >= end - 8) {
				track.scrollTo({ left: 0 });
			} else {
				const slide = track.querySelector<HTMLElement>('[data-card]');
				const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
				track.scrollBy({ left: slide ? slide.offsetWidth + gap : track.clientWidth });
			}
		}, 3500);
	}
</script>

<style>
	.clients {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
	}
	h2 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.75rem, 3.2vw, 2.625rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-align: center;
	}

	.slider {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 3rem;
	}
	/* on wide screens the arrows sit outside the content edge, like the live page */
	@media (min-width: 1480px) {
		.slider {
			margin-inline: -3rem;
		}
	}
	.arrow {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 50%;
		padding: 0;
		background: transparent;
		color: #9aa3ae;
		cursor: pointer;
		transition:
			color 0.15s ease,
			background 0.15s ease;
	}
	.arrow:hover:not(:disabled) {
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.arrow:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 2px;
	}
	.arrow:disabled {
		color: #d5dae0;
		cursor: default;
	}

	/* one row of logos that scrolls a slide at a time */
	.track {
		display: grid;
		flex: 1;
		min-width: 0;
		grid-auto-flow: column;
		grid-auto-columns: calc((100% - 4 * 1.5rem) / 5);
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}
	.track::-webkit-scrollbar {
		display: none;
	}
	.slide {
		display: grid;
		place-items: center;
		height: 7.5rem;
		scroll-snap-align: start;
	}
	.slide :global(img) {
		display: block;
		width: 100%;
		max-width: 240px;
		height: 100px;
		object-fit: contain;
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem 3.5rem;
		}
		.slider {
			margin-top: 2.75rem;
		}
		.track {
			grid-auto-columns: calc((100% - 2 * 1.5rem) / 3);
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem;
		}
		.slider {
			gap: 0.25rem;
			margin-top: 2rem;
		}
		.arrow {
			width: 32px;
			height: 32px;
		}
		.track {
			grid-auto-columns: calc((100% - 1rem) / 2);
			gap: 1rem;
		}
		.slide {
			height: 5.5rem;
		}
		.slide :global(img) {
			height: 72px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.track {
			scroll-behavior: auto;
		}
	}
</style>
