---
import BaseHead from '../components/BaseHead.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Features from '../components/Features.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PatientCare from '../components/PatientCare.astro';
import Stories from '../components/Stories.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		{/* set before paint, so sections are only hidden when the observer can reveal them */}
		<script is:inline>
			document.documentElement.classList.add('js-reveal');
		</script>
	</head>
	<body>
		<Header />
		<main class="home">
			<Hero />
			<Features />
			<PatientCare />
			<Testimonials />
			<Faq />
			<Stories />
			<Cta />
		</main>
		<Footer />
	</body>
</html>

<script>
	const sections = document.querySelectorAll<HTMLElement>('main.home > section');

	if (!('IntersectionObserver' in window)) {
		sections.forEach((section) => section.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
		);
		sections.forEach((section) => observer.observe(section));
	}
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
</style>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		/* sections rise into place as they enter the viewport */
		html.js-reveal main.home > section {
			opacity: 0;
			transform: translateY(24px);
			transition:
				opacity 0.7s ease,
				transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.home > section.is-visible {
			opacity: 1;
			transform: none;
		}

		/* card groups inside a revealed section arrive one after another */
		html.js-reveal main.home > section [data-stagger] > * {
			opacity: 0;
			transform: translateY(18px);
			transition:
				opacity 0.6s ease,
				transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > * {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > :nth-child(2) {
			transition-delay: 0.09s;
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > :nth-child(3) {
			transition-delay: 0.18s;
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > :nth-child(4) {
			transition-delay: 0.27s;
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > :nth-child(5) {
			transition-delay: 0.36s;
		}
		html.js-reveal main.home > section.is-visible [data-stagger] > :nth-child(6) {
			transition-delay: 0.45s;
		}
	}
</style>
