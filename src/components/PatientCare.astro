---
import { Image } from 'astro:assets';
// Pexels photo 7195087 by Karola G (kaboompics.com), Pexels licence, attribution not required.
import call from '../assets/telehealth-call.jpg';
import { SITE_TITLE } from '../consts';

const points = [
	{
		title: 'Cura AI in the consult',
		copy: 'Optional AI documentation and clinical assist — listen, draft notes, keep the doctor in control. See CuraPilot for the pilot story.',
	},
	{
		title: 'Telehealth without new apps',
		copy: 'Video visits that land on the same chart as in-clinic care — one click for doctor and patient.',
	},
	{
		title: 'WhatsApp, SMS, and email',
		copy: 'Reminders, follow-ups, and visit summaries that patients actually open — fewer no-shows, tighter retention.',
	},
];
---

<section class="care" id="cura">
	<div class="inner">
		<div class="stage">
			<figure class="shot">
				<div class="frame">
					<Image
						src={call}
						alt="A patient on a video consultation with a clinician from home"
						widths={[420, 640, 900]}
						sizes="(max-width: 1080px) 92vw, 32vw"
					/>
					<div class="controls" aria-hidden="true">
						<span class="key">&hellip;</span>
						<span class="key">
							<svg viewBox="0 0 16 16" width="15" height="15">
								<rect x="1.4" y="4.2" width="9" height="7.6" rx="1.8" fill="currentColor" />
								<path d="m11.4 8 3.2-2.2v4.4z" fill="currentColor" />
							</svg>
						</span>
						<span class="key">
							<svg viewBox="0 0 16 16" width="15" height="15">
								<g fill="currentColor">
									<rect x="1.6" y="1.6" width="5.2" height="5.2" rx="1.4" />
									<rect x="9.2" y="1.6" width="5.2" height="5.2" rx="1.4" />
									<rect x="1.6" y="9.2" width="5.2" height="5.2" rx="1.4" />
									<rect x="9.2" y="9.2" width="5.2" height="5.2" rx="1.4" />
								</g>
							</svg>
						</span>
						<span class="key">
							<svg viewBox="0 0 16 16" width="15" height="15">
								<rect x="5.8" y="1.4" width="4.4" height="8" rx="2.2" fill="currentColor" />
								<path
									d="M3.4 8.2a4.6 4.6 0 0 0 9.2 0M8 12.8v1.8"
									fill="none"
									stroke="currentColor"
									stroke-width="1.4"
									stroke-linecap="round"></path>
							</svg>
						</span>
						<span class="key key-end">
							<svg viewBox="0 0 16 16" width="15" height="15">
								<path
									d="M2.2 9.4c3.2-2.6 8.4-2.6 11.6 0l-1.4 2-2.6-.8-.4-1.6a7.4 7.4 0 0 0-2.4 0l-.4 1.6-2.6.8z"
									fill="currentColor"></path>
							</svg>
						</span>
					</div>
				</div>
				<figcaption>
					<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
						<path
							d="M8 1.4l1.3 3.9 3.9 1.3-3.9 1.3L8 11.8 6.7 7.9 2.8 6.6l3.9-1.3z"
							fill="currentColor"></path>
						<path d="M12.8 10.4l.6 1.7 1.7.6-1.7.6-.6 1.7-.6-1.7-1.7-.6 1.7-.6z" fill="currentColor"
						></path>
					</svg>
					Cura AI is listening to Marc
				</figcaption>
			</figure>

			<div class="notes" aria-hidden="true">
				<p class="notes-head">
					<svg viewBox="0 0 16 16" width="18" height="18">
						<path
							d="M8 1.4l1.3 3.9 3.9 1.3-3.9 1.3L8 11.8 6.7 7.9 2.8 6.6l3.9-1.3z"
							fill="currentColor"></path>
					</svg>
					Session notes
				</p>
				<div class="note">
					<strong>Starting the call</strong>
					<p>
						Dr. Rajiv kicked things off with a warm hello, helping Marc and Nahla feel at ease before
						diving in.
					</p>
				</div>
				<div class="note">
					<strong>Main discussion</strong>
					<p>
						Marc and Nahla gave quick health updates, then the talk shifted to making care smoother
						and more personal.
					</p>
					<ul>
						<li>Faster, stress-free check-ins</li>
						<li>Care plans that feel truly tailored</li>
						<li>Small motivators, like gentle reminders or progress trackers, to keep patients on track</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="copy">
			<h2>AI-assisted care that stays connected after the visit</h2>
			<p class="lede">
				From Cura AI documentation to telehealth and WhatsApp engagement, {SITE_TITLE} keeps
				clinicians and patients linked without extra apps.
			</p>
			<div class="points">
				{
					points.map((point, index) => (
						<details open={index === 0}>
							<summary>{point.title}</summary>
							<div class="body" data-accordion-body>
								<p>{point.copy}</p>
							</div>
						</details>
					))
				}
			</div>
			<p class="cura-link">
				<a href="/curapilot">See the AI clinical pilot →</a>
			</p>
		</div>
	</div>
</section>

<script>
	import { initAccordion } from '../scripts/accordion';

	initAccordion('.care details');
</script>
<style>
	.care {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		align-items: center;
		gap: 5rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 7rem;
	}

	/* left composition */
	.stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
		align-items: center;
	}
	.shot {
		margin: 0;
	}
	.frame {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
	}
	.frame img {
		display: block;
		width: 100%;
		aspect-ratio: 1.08;
		object-fit: cover;
	}
	.controls {
		position: absolute;
		bottom: 1rem;
		left: 1rem;
		display: flex;
		align-items: center;
		gap: 0.375rem;
		border-radius: 12px;
		padding: 0.375rem;
		background: rgba(10, 37, 64, 78%);
	}
	.key {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: rgba(255, 255, 255, 12%);
		color: var(--surface);
		font-size: 0.875rem;
		letter-spacing: 0.08em;
	}
	.key-end {
		background: var(--brand-red);
	}
	figcaption {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1rem;
		color: var(--muted);
	}
	figcaption svg {
		flex-shrink: 0;
		color: var(--brand-blue);
	}

	.notes {
		position: relative;
		z-index: 1;
		margin-left: -3rem;
		border-radius: 20px;
		padding: 1.25rem;
		background: var(--navy);
		color: var(--surface);
		font-size: 0.875rem;
		box-shadow: 0 24px 48px rgba(10, 37, 64, 22%);
	}
	.notes-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		font-size: 1.125rem;
		font-weight: 600;
	}
	.notes-head svg {
		color: var(--brand-teal);
	}
	.note {
		border: 1px solid rgba(255, 255, 255, 10%);
		border-radius: 14px;
		padding: 0.875rem 1rem;
		background: rgba(255, 255, 255, 6%);
	}
	.note + .note {
		margin-top: 0.75rem;
	}
	.note strong {
		font-weight: 600;
	}
	.note p {
		margin: 0.5rem 0 0;
		color: rgba(255, 255, 255, 78%);
	}
	.note ul {
		margin: 0.625rem 0 0;
		padding-left: 1.125rem;
		color: rgba(255, 255, 255, 78%);
	}
	.note li + li {
		margin-top: 0.375rem;
	}

	/* right copy */
	h2 {
		max-width: 20ch;
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1.5rem 0 0;
		max-width: 44ch;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.points {
		margin-top: 3rem;
	}
	.cura-link {
		margin: 1.75rem 0 0;
	}
	.cura-link a {
		color: var(--brand-blue);
		font-weight: 600;
		text-decoration: none;
	}
	.cura-link a:hover {
		text-decoration: underline;
	}
	details {
		position: relative;
		border-bottom: 1px solid var(--border);
		padding: 1.25rem 0;
	}
	details:first-child {
		padding-top: 0;
	}
	/* progress echo on the open item, as in the reference layout */
	details[open]::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 40%;
		height: 2px;
		background: var(--navy);
		animation: track 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	@keyframes track {
		from {
			width: 0;
		}
	}
	summary {
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
		transition: color 0.2s ease;
	}
	summary:hover {
		color: var(--brand-blue);
	}
	summary::-webkit-details-marker {
		display: none;
	}
	/* the wrapper is what the open/close animation sizes */
	.body {
		overflow: hidden;
	}
	.body p {
		margin: 0.75rem 0 0;
		max-width: 46ch;
		color: var(--muted);
	}

	@media (max-width: 1080px) {
		.inner {
			grid-template-columns: minmax(0, 1fr);
			gap: 3.5rem;
			padding: 3.5rem 1.5rem 4.5rem;
		}
		h2,
		.lede {
			max-width: none;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.5rem 1rem 3.5rem;
		}
		.stage {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25rem;
		}
		.notes {
			margin-left: 0;
		}
	}
</style>
