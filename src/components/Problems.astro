---
import SectionHead from './SectionHead.astro';

const problems = [
	{
		title: 'Clinic Operations',
		copy: 'Scheduling chaos, long waits, and protocols that do not stick across the floor.',
	},
	{
		title: 'Finance & Inventory',
		copy: 'Missed charges, stockouts, and reconciliation that trails the day.',
	},
	{
		title: 'Patient Management & EMR',
		copy: 'Scattered charts, slow notes, and follow-ups that fall through.',
	},
	{
		title: 'Centralised Control',
		copy: 'No live view across branches — inconsistent workflows and reporting.',
	},
];
---

<section class="problems" id="problems">
	<div class="panel">
		<SectionHead
			eyebrow="Problems we solve"
			title="Less friction across the clinic day"
			lede="Four pressure points Easy Clinic is built to take off your team."
		/>
		<ul class="cards" data-stagger>
			{
				problems.map((item) => (
					<li>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.problems {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 4.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		max-width: var(--page-max);
		margin: 2.75rem auto 0;
		padding: 0;
		list-style: none;
	}
	.cards li {
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.5rem;
		background: var(--surface-tint);
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.cards p {
		margin: 0.7rem 0 0;
		color: var(--muted);
		font-size: 0.975rem;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 3.5rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 2.75rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
