---
import SectionHead from '../SectionHead.astro';

const triggers = [
	'HMO claim rejections / slow settlements',
	'WhatsApp chaos at the desk',
	'No teleconsult path with payment',
	'Multi-site records fragmented',
	'Evening chart catch-up',
];
---

<section class="context">
	<div class="inner">
		<SectionHead
			eyebrow="Why now"
			title="What Nigerian private clinics need"
			lede="Patients, HMOs, and competitors went digital together. Clinics want one cloud system for records, billing, HMO claim packs, pharmacy, WhatsApp, and telemedicine."
		/>
		<p class="body">
			This page is for fee-paying private clinics and small chains in Lagos, Abuja, and beyond — not for
			hospital-only stacks that bury the front desk.
		</p>

		<h3 class="sub">Why clinics switch now</h3>
		<ul class="chips" data-stagger>
			{triggers.map((item) => <li>{item}</li>)}
		</ul>
		<p class="note">One trigger is enough to look; two usually means you’re overdue.</p>
	</div>
</section>

<style>
	.context {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.body {
		max-width: 62ch;
		margin: 2rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
		text-align: center;
	}
	.sub {
		margin: 3rem 0 0;
		color: var(--navy);
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		max-width: 920px;
		margin: 1.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 999px;
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.note {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		text-align: center;
	}
</style>
