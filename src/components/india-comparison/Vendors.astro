---
import SectionHead from '../SectionHead.astro';

const vendors = [
	{
		title: 'Practo Ray',
		copy: 'Practo is widely known for patient discovery and appointments; Ray is the clinic-management side. Strong when marketplace presence matters. EasyClinic is built as the operating system for the floor — EMR, WhatsApp reminders, billing, pharmacy/lab, and multi-branch — without tying your day to a discovery marketplace.',
	},
	{
		title: 'HealthPlix',
		copy: 'HealthPlix is a major doctor-facing platform with genuine AI EMR depth and language-friendly charting for specialists. EasyClinic’s case is broader clinic ops: Cura AI plus front-desk, WhatsApp, billing, and branch control in one cloud stack. Pick HealthPlix when the consulting-room AI EMR is the whole job; pick EasyClinic when the front desk and till have to move with the chart.',
	},
	{
		title: 'Clinicea',
		copy: 'Global cloud EMR with strong clinical templates and India presence. EasyClinic’s India edge is Cura AI documentation assist, WhatsApp-first engagement, published pricing, and an ops spine (billing, pharmacy, lab, multi-branch) sized for private clinics and chains.',
	},
	{
		title: 'MocDoc',
		copy: 'Real depth on clinic operations and scheduling, spanning clinics to hospitals. EasyClinic answers with deeper live AI assist (Cura AI), WhatsApp messaging, and a private-clinic-first cloud model — compare both on your branch count and specialty mix.',
	},
];
---

<section class="vendors">
	<div class="inner">
		<SectionHead
			eyebrow="Head to head"
			title="How EasyClinic compares, vendor by vendor"
			lede="Short takes grounded in each vendor’s public positioning. Full demos beat feature matrices."
		/>
		<ul class="grid" data-stagger>
			{
				vendors.map((v) => (
					<li>
						<h3>EasyClinic vs {v.title}</h3>
						<p>{v.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.vendors {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 2.75rem auto 0;
		padding: 0;
		list-style: none;
	}
	.grid li {
		border: 1px solid rgba(10, 37, 64, 8%);
		border-radius: 18px;
		padding: 1.5rem 1.55rem 1.6rem;
		background: var(--surface);
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	p {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-size: 0.9875rem;
		line-height: 1.6;
	}
	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
