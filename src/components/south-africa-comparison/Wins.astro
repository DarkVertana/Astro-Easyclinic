---
import SectionHead from '../SectionHead.astro';

const wins = [
	{
		title: 'Cura AI documentation assist',
		copy: 'Documentation assist during the visit; clinician stays in charge.',
	},
	{
		title: 'Telemedicine + WhatsApp engagement',
		copy: 'Teleconsult in-product plus reminders and Rx patients actually read.',
	},
	{
		title: 'ICD-10-aware billing workflows',
		copy: 'In-product coding hygiene — medical-aid claim switching depth confirm in demo.',
	},
	{
		title: 'Multi-site cloud reporting',
		copy: 'Shared records and reporting across sites without a second system.',
	},
];
---

<section class="wins">
	<div class="panel">
		<SectionHead
			tone="dark"
			title="Where EasyClinic earns its place"
			lede="Four modern problems — with honesty on medical-aid switching and POPIA."
		/>
		<ul class="rows" data-stagger>
			{
				wins.map((w) => (
					<li>
						<strong>{w.title}</strong>
						<p>{w.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.wins {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
	}
	.rows {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.35rem 1.5rem;
		background: rgba(255, 255, 255, 5%);
	}
	strong {
		display: block;
		color: var(--surface);
		font-size: 1.0625rem;
	}
	p {
		margin: 0.55rem 0 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.9875rem;
		line-height: 1.55;
	}
	@media (max-width: 800px) {
		.rows {
			grid-template-columns: 1fr;
		}
	}
</style>
