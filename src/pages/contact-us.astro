												<path
													d="m4.3 8.3 2.4 2.4 5-5.3"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
											{point}
										</li>
									))
								}
							</ul>

							<div class="ratings">
								<span class="rating">
									<span class="rating-mark"><CapterraLogo width={18} height={18} /></span>
									4.9 <span class="star" aria-hidden="true">&#9733;</span> on Capterra
								</span>
								<span class="rating">
									<span class="rating-mark"><GoogleLogo width={18} height={18} /></span>
									4.8 <span class="star" aria-hidden="true">&#9733;</span> on Google
								</span>
							</div>
						</div>

						{/* No endpoint is wired yet — point action at your form handler to go live. */}
						<form class="form" method="post">
							<div class="fields">
								<div class="field">
									<label for="name">Name <span class="req" aria-hidden="true">*</span></label>
