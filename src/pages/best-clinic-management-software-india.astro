---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Context from '../components/india-comparison/Context.astro';
import Hero from '../components/india-comparison/Hero.astro';
import Shortlist from '../components/india-comparison/Shortlist.astro';
import SwitchCost from '../components/india-comparison/SwitchCost.astro';
import Vendors from '../components/india-comparison/Vendors.astro';
import Verdict from '../components/india-comparison/Verdict.astro';
import Wins from '../components/india-comparison/Wins.astro';
import Marketing from '../layouts/Marketing.astro';

const faqs = [
	{
		question: 'Best CMS for Indian private clinics in 2026?',
		answer:
			'For most ops-first private clinics: EasyClinic (Cura AI, WhatsApp, billing, multi-branch). Marketplace-led growth may still want Practo alongside.',
	},
	{
		question: 'EasyClinic vs Practo?',
		answer:
			'Practo/Ray strong on discovery + Ray ops; EasyClinic stronger as the full clinic OS. See /easyclinic-vs-practo/.',
	},
	{
		question: 'EasyClinic vs HealthPlix?',
		answer:
			'HealthPlix strong AI EMR for specialists; EasyClinic broader floor + AI. See /easyclinic-vs-healthplix/.',
	},
	{
		question: 'ABDM / ABHA compliant?',
		answer: 'Work in progress; current status in demo.',
	},
	{
		question: 'WhatsApp?',
		answer: 'Yes — reminders and prescription sharing.',
	},
	{
		question: 'Cost?',
		answer: 'Published tiers on Pricing; demo for India quote.',
	},
];
---

<Marketing
	title="Best Clinic Management Software India (2026 Comparison) — EasyClinic"
	description="Compare clinic management software India clinics use in 2026 — EasyClinic vs Practo Ray, HealthPlix, and Clinicea on Cura AI, WhatsApp, billing, and multi-branch ops."
	mainClass="india-comparison"
>
	<Hero />
	<Context />
	<Shortlist />
	<Vendors />
	<Wins />
	<SwitchCost />
	<Verdict />
	<Faq items={faqs} />
	<Cta
		title="See EasyClinic on an Indian clinic workflow"
		lede="Book a demo — we’ll map EMR, WhatsApp, and billing to how you practise."
		primaryHref="/contact-us#demo-form"
		primaryLabel="Book a free demo"
		secondaryHref="/pricing"
		secondaryLabel="See pricing"
	/>
</Marketing>
