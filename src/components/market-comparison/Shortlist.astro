---
import SectionHead from '../SectionHead.astro';
import type { MarketComparison } from './types';

interface Props {
	data: MarketComparison;
}

const { data } = Astro.props;
const { shortlist } = data;
---

<section class="shortlist">
	<div class="inner">
		<SectionHead title="The shortlist" lede={shortlist.lede} />
		<div class="table-wrap" role="region" aria-label={shortlist.ariaLabel} tabindex="0">
			<table>
				<thead>
					<tr>
						{shortlist.headers.map((h) => <th scope="col">{h}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						shortlist.rows.map((row) => (
							<tr>
								{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="hint">Details live in the vendor cards below — this table stays one-screen.</p>
	</div>
</section>

<style>
	.shortlist {
		background: var(--surface);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.table-wrap {
		overflow-x: auto;
		margin: 2.75rem auto 0;
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 18px;
		background: #fff;
		-webkit-overflow-scrolling: touch;
	}
	table {
		width: 100%;
		min-width: 760px;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.95rem 1rem;
		border-bottom: 1px solid rgba(10, 37, 64, 8%);
		text-align: left;
		vertical-align: top;
		color: var(--muted);
		line-height: 1.45;
	}
	thead th {
		background: var(--brand-wash);
		color: var(--navy);
		font-weight: 700;
		white-space: nowrap;
	}
	tbody th {
		color: var(--navy);
		font-weight: 650;
		width: 18%;
	}
	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: 0;
	}
	tbody td:nth-child(2) {
		color: var(--navy);
		font-weight: 600;
	}
	.hint {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		text-align: center;
	}
</style>
