---
import SectionHead from '../SectionHead.astro';
import type { RelatedLink } from './types';

interface Props {
	verdict?: string;
	related: RelatedLink[];
}

const { verdict, related } = Astro.props;
---

<section class="verdict">
	<div class="inner">
		{verdict && (
			<>
				<SectionHead title="The verdict" />
				<p class="copy">{verdict}</p>
			</>
		)}
		<nav class="related" aria-label="Related pages">
			{
				related.map((link) => (
					<a href={link.href}>{link.label}</a>
				))
			}
		</nav>
	</div>
</section>

<style>
	.verdict {
		background: var(--brand-wash);
		padding: 4.5rem 1.5rem 1rem;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
	}
	.copy {
		margin: 1.5rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.65;
		text-align: center;
	}
	.related {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.25rem;
		margin: 2.25rem 0 0;
	}
	.related a {
		color: var(--brand-blue);
		font-weight: 650;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.related a:hover {
		text-decoration: underline;
	}
</style>
