---
const address = '30 Circus Avenue, Kolkata — 700 017, India';
const query = encodeURIComponent('30 Circus Avenue, Kolkata 700017, India');
const embedSrc = `https://www.google.com/maps?q=${query}&z=16&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${query}`;
---

<section class="office">
	<div class="inner">
		<p class="eyebrow">Our office</p>
		<h2>Come and see us in Kolkata</h2>
		<p class="address">{address}</p>
		<a class="directions" href={directionsHref} target="_blank" rel="noopener noreferrer">Get directions</a>

		<div class="map">
			<iframe
				src={embedSrc}
				title={`Map showing the EasyClinic office at ${address}`}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
		</div>
	</div>
</section>

<style>
	.office {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 1.5rem 1.5rem 6rem;
		text-align: center;
	}
	.eyebrow {
		margin: 0 0 0.9rem;
		color: var(--brand-blue);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.2vw, 2.5rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.address {
		margin: 0.85rem 0 0;
		color: #333;
		font-size: 1.0625rem;
	}
	.directions {
		display: inline-flex;
		align-items: center;
		height: 2.75rem;
		margin-top: 1.5rem;
		border: 1px solid var(--brand-blue);
		border-radius: 8px;
		padding: 0 1.5rem;
		background: var(--surface);
		color: var(--brand-blue);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.directions:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.map {
		overflow: hidden;
		height: 27.5rem;
		margin-top: 2.5rem;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface-tint);
		box-shadow: 0 24px 60px rgba(10, 37, 64, 8%);
	}
	.map iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (max-width: 720px) {
		.inner {
			padding: 1.5rem 1rem 4rem;
		}
		.map {
			height: 20rem;
			border-radius: 16px;
		}
	}
</style>
