import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Reveal from '../components/Reveal.astro';
import CapterraLogo from '../assets/ratings/capterra.svg';
import GoogleLogo from '../assets/ratings/google.svg';
import { countries, FLAG_CELL } from '../data/countries';
import { SITE_TITLE } from '../consts';

// Headings, the support paragraph, the three contact details and every form field
// are taken from the contact page published at easyclinic.io/contact-us. The rating
// figures are the ones the homepage already shows. Nothing here is invented.

const channels = [
	{
		label: 'Email us',
		value: 'hello@easyclinic.io',
