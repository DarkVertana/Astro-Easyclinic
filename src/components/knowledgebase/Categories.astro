---
import SectionHead from '../SectionHead.astro';
import { HELP_URL } from './links';

const icons: Record<string, string> = {
	flag: '<path d="M4 22V4"/><path d="M4 4h11l-1.6 4L15 12H4"/>',
	document:
		'<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h8"/><path d="M8 17h5"/>',
	calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 15 2 2 4-4"/>',
	wallet:
		'<path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>',
	box: '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
	flask: '<path d="M10 2v7.31"/><path d="M14 9.3V2"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/>',
	chart: '<path d="M3 3v18h18"/><path d="M7 14v4"/><path d="M12 10v8"/><path d="M17 7v11"/>',
	plug: '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a6 6 0 0 1-12 0V8Z"/>',
};

const categories = [
	{
		icon: 'flag',
		title: 'Getting started',
		copy: 'Account setup, users, clinic config, go-live.',
	},
	{
		icon: 'document',
		title: 'EMR & charts',
		copy: 'Visits, 30-second Rx, templates, AI documentation.',
	},
	{
		icon: 'calendar',
		title: 'Appointments',
		copy: 'Calendar, walk-ins, reminders, teleconsult slots, waiting room.',
	},
	{
		icon: 'wallet',
		title: 'Billing & payments',
		copy: 'Invoices, online/offline pay, price lists, reports.',
	},
	{
		icon: 'box',
		title: 'Inventory & pharmacy',
		copy: 'Stock, POs, dispensing, expiry.',
	},
	{
		icon: 'flask',
		title: 'Lab',
		copy: 'Orders, samples, result templates, abnormal flags.',
	},
	{
		icon: 'chart',
		title: 'Reports',
		copy: 'Dashboards for visits, revenue, and follow-ups.',
	},
	{
		icon: 'plug',
		title: 'Integrations',
		copy: 'WhatsApp, payments, devices, and connected tools.',
	},
];
---

<section class="categories">
	<div class="inner">
		<SectionHead
			eyebrow="Browse"
			title="Browse by category"
			lede="Short cuts into the help centre — each card opens the full library at help.easyclinic.io."
		/>

		<ul class="cards" data-stagger>
			{
				categories.map((item) => (
					<li>
						<a href={HELP_URL} target="_blank" rel="noopener noreferrer">
							<span class="mi" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									width="19"
									height="19"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={icons[item.icon]}
								/>
							</span>
							<h3>{item.title}</h3>
							<p>{item.copy}</p>
							<span class="go">
								Open guides
								<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M7 17 17 7" />
									<path d="M8 7h9v9" />
								</svg>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.categories {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}
	.cards a {
		display: block;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.5rem;
		background: var(--surface-tint);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}
	.cards a:hover {
		border-color: var(--brand-wash-deep);
		box-shadow: 0 14px 32px rgba(10, 37, 64, 8%);
		transform: translateY(-3px);
	}

	.mi {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.cards a:hover .mi {
		background: var(--brand-blue);
		color: var(--surface);
	}

	h3 {
		margin: 1.15rem 0 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.cards p {
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.go {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.05rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.cards a:hover .go {
		text-decoration: underline;
	}

	@media (prefers-reduced-motion: reduce) {
		.cards a {
			transition: none;
		}
		.cards a:hover {
			transform: none;
		}
	}
	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
