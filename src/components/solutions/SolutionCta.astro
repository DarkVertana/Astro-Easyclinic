---
interface Props {
	title: string;
	lede: string;
}

const { title, lede } = Astro.props;
---

<section class="cta">
	<div class="inner">
		<h2>{title}</h2>
		<p class="lede">{lede}</p>
		<div class="actions">
			<a class="btn btn-solid" href="/contact-us#demo-form">Book a Demo</a>
			<a class="btn btn-ghost" href="/pricing">View Pricing</a>
		</div>
	</div>
</section>
<style>
	.cta {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 7rem;
		text-align: center;
	}
	h2 {
		max-width: 20ch;
		margin: 0 auto;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.lede {
		max-width: 50ch;
		margin: 1.25rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 2.5rem;
	}
	.btn {
		border-radius: 10px;
		padding: 0.875rem 1.5rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.btn-ghost {
		border: 1.5px solid var(--brand-blue);
		color: var(--brand-blue);
	}
	.btn-ghost:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 3.5rem 1.5rem 4.5rem;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.5rem 1rem 3.5rem;
		}
		.btn {
			flex: 1 1 auto;
			text-align: center;
		}
	}
</style>
