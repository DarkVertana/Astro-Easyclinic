		line-height: 1.3;
		cursor: pointer;
	}
	.dial-name {
		flex: 1;
		min-width: 0;
	}
	.dial-code {
		color: var(--muted);
	}
	.dial-menu li:hover,
	.dial-menu li.is-active {
		background: var(--surface-tint);
	}
	.dial-menu li[aria-selected='true'] {
		font-weight: 600;
	}

	/* ---------- map ---------- */
	.map {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
