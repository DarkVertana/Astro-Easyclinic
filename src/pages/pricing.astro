---
import BaseHead from '../components/BaseHead.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Testimonials from '../components/Testimonials.astro';
import Compare from '../components/pricing/Compare.astro';
import Hero from '../components/pricing/Hero.astro';
import Plans from '../components/pricing/Plans.astro';
import { pricingFaqs } from '../components/pricing/data';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Pricing — ${SITE_TITLE}`}
			description={`Cost-effective EMR and clinic management plans from ${SITE_TITLE}. Professional, Premium, and Enterprise — billed per doctor, reception included.`}
		/>
		{/* set before paint, so sections are only hidden when the observer can reveal them */}
		<script is:inline>
			document.documentElement.classList.add('js-reveal');
		</script>
	</head>
	<body>
		<Header />
		<main class="pricing">
			<Hero />
			<Plans />
			<Compare />
			<Testimonials />
			<Faq items={pricingFaqs} />
			<Cta />
		</main>
		<Footer />
	</body>
</html>

<script>
	const sections = [...document.querySelectorAll<HTMLElement>('main.pricing > section')];
	const [hero, ...rest] = sections;
	hero?.classList.add('is-visible');

	if (!('IntersectionObserver' in window)) {
		rest.forEach((section) => section.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
		);
		rest.forEach((section) => observer.observe(section));
	}
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
</style>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html.js-reveal main.pricing > section:first-child {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main.pricing > section:not(:first-child) {
			opacity: 0;
			transform: translateY(24px);
			transition:
				opacity 0.7s ease,
				transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.pricing > section.is-visible {
			opacity: 1;
			transform: none;
		}

		html.js-reveal main.pricing > section [data-stagger] > * {
			opacity: 0;
			transform: translateY(18px);
			transition:
				opacity 0.6s ease,
				transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > * {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > :nth-child(2) {
			transition-delay: 0.09s;
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > :nth-child(3) {
			transition-delay: 0.18s;
		}
	}
</style>
