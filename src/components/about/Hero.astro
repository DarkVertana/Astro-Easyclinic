---
import PageHero from '../PageHero.astro';

const facts = [
	{ value: '2003', label: 'Founded' },
	{ value: '5,000+', label: 'Doctors' },
	{ value: '18', label: 'Countries' },
];
---

<PageHero
	eyebrow="About us"
	title="Clinic management software, built since 2003"
	lede="EasyClinic started as doctor practice software for clinics tired of paper. Two decades on, thousands of practices still choose it because it is usable and priced to keep."
	secondaryHref="/testimonials"
	secondaryLabel="Customer stories"
>
	<div class="card">
		<p class="card-label">At a glance</p>
		<ul class="rows">
			{
				facts.map((item) => (
					<li class="fact">
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</PageHero>
