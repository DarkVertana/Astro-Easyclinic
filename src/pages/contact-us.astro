											</svg>
										</span>
										<span class="channel-copy">
											<small>{channel.label}</small>
											<strong>{channel.value}</strong>
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- the form: white panel rounding over the wash, as Features does on the homepage -->
			<section class="book" id="demo-form">
