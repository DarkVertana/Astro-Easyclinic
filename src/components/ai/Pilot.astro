---
const mentions = [
	{
		title: 'World’s largest AI clinical pilot',
		copy: 'From prompt engineering to frontline integration, Easy Clinic powered the AI copilot transforming care. This is just the beginning.',
	},
	{
		title: 'Clinics trust us. The industry awards us.',
		copy: 'Join physicians, specialists, and clinic chains using Easy Clinic across the world, credibility built through proven results and endorsements.',
	},
	{
		title: 'Peer-reviewed evidence',
		copy: 'CuraPilot outcomes are measured in peer-reviewed research across tens of thousands of patient visits. See the deeper evidence on the CuraPilot page.',
	},
];
---

<section class="pilot">
	<div class="panel">
		<p class="eyebrow">Social proof</p>
		<h2>Built for clinics that want AI that works</h2>
		<p class="lede">
			Physicians, specialists, and clinic chains trust Easy Clinic to run practices efficiently,
			with AI that shows up in real workflows, not slide decks.
		</p>
		<ul class="cards" data-stagger>
			{
				mentions.map((item) => (
					<li>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.pilot {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-teal);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}
	h2 {
		max-width: 18ch;
		margin: 0.85rem auto 0;
		color: var(--surface);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.lede {
		max-width: 54ch;
		margin: 1.15rem auto 0;
		color: rgba(255, 255, 255, 72%);
		font-size: 1.0625rem;
		text-align: center;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.cards li {
		border: 1px solid rgba(255, 255, 255, 8%);
		border-radius: 20px;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 6%);
	}
	h3 {
		margin: 0;
		color: var(--surface);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.cards p {
		margin: 0.65rem 0 0;
		color: rgba(255, 255, 255, 72%);
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
	}
</style>
