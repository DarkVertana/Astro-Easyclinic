---
import SectionHead from '../SectionHead.astro';

// stroke icons (24×24, currentColor), drawn white on the blue tile
const icons: Record<string, string> = {
	bulb: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
	shield:
		'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
	award: '<circle cx="12" cy="8" r="6"/><path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11"/>',
	users:
		'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	heartPulse:
		'<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
	refresh:
		'<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
};

const values = [
	{
		title: 'Innovation',
		icon: 'bulb',
		copy: 'We keep exploring new technologies so our clients stay at the forefront of healthcare management.',
	},
	{
		title: 'Integrity',
		icon: 'shield',
		copy: 'We operate with transparency and the highest ethical standards, the foundation of long-lasting client relationships.',
	},
	{
		title: 'Excellence',
		icon: 'award',
		copy: 'From product to support, we hold every interaction with Easy Clinic to the same standard of quality.',
	},
	{
		title: 'Collaboration',
		icon: 'users',
		copy: 'The best solutions are built together, within our team and with the clinicians who use them.',
	},
	{
		title: 'Customer Success',
		icon: 'heartPulse',
		copy: "We tailor our work to grow our clients' practices, not just install software.",
	},
	{
		title: 'Adaptability',
		icon: 'refresh',
		copy: 'Healthcare keeps evolving, and so do we, keeping our clients competitive and relevant.',
	},
];
---

<section class="values">
	<div class="inner">
		<SectionHead
			eyebrow="Our values"
			title="Values That Shape Us"
			lede="Our commitment to you and to healthcare, six principles behind every product decision and support call."
		/>
		<ul class="content" data-stagger>
			{
				values.map((item) => (
					<li class="card">
						<span class="icon" aria-hidden="true">
							<svg
								viewBox="0 0 24 24"
								width="26"
								height="26"
								fill="none"
								stroke="currentColor"
								stroke-width="1.9"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.values {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	/* equal space above the heading and below the cards; both neighbours are navy bands */
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5.5rem 1.5rem;
	}
	.content {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}
	.card {
		position: relative;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.9rem 1.75rem 1.75rem;
		background: var(--surface);
		box-shadow: 0 1px 2px rgba(10, 37, 64, 4%);
		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.card:hover {
		border-color: var(--brand-wash-deep);
		box-shadow: 0 18px 40px rgba(10, 37, 64, 9%);
		transform: translateY(-4px);
	}

	/* solid brand-blue icon tile (same colour as the hero's Vision/Mission tiles) with a soft glow */
	.icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		margin-bottom: 1.35rem;
		border-radius: 16px;
		background: var(--brand-blue);
		color: var(--surface);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 35%),
			0 10px 22px color-mix(in srgb, var(--brand-blue) 28%, transparent);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}
	/* soft halo ring that appears on hover */
	.icon::after {
		content: '';
		position: absolute;
		inset: -6px;
		border-radius: 20px;
		border: 1px solid color-mix(in srgb, var(--brand-blue) 22%, transparent);
		opacity: 0;
		transform: scale(0.92);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}
	.card:hover .icon {
		transform: translateY(-2px) rotate(-4deg);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 35%),
			0 14px 28px color-mix(in srgb, var(--brand-blue) 36%, transparent);
	}
	.card:hover .icon::after {
		opacity: 1;
		transform: scale(1);
	}

	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.card p {
		margin: 0.6rem 0 0;
		color: var(--muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.icon,
		.icon::after {
			transition: none;
		}
		.card:hover,
		.card:hover .icon {
			transform: none;
		}
	}
	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem;
		}
		.content {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem;
		}
		.content {
			margin-top: 2.25rem;
			grid-template-columns: 1fr;
		}
		.icon {
			width: 52px;
			height: 52px;
			margin-bottom: 1.15rem;
			border-radius: 14px;
		}
	}
</style>
