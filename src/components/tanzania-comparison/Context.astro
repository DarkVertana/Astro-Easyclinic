---
import SectionHead from '../SectionHead.astro';

const triggers = [
	'Unreliable connectivity',
	'Mobile Money desk friction',
	'No AI/telehealth path',
	'Multi-site chaos',
];
---

<section class="context">
	<div class="inner">
		<SectionHead
			eyebrow="Why now"
			title="Internet and wallet first"
			lede="Cash or Mobile Money at the desk, walk-ins, and paper piles still define many days — match the tool to connectivity."
		/>
		<p class="body">
			Smart Hospital Manager is the self-hosted path for offline-leaning facilities; Tenwave ETHER is cloud/web with
			gateway options; Ksatria offers flexible cloud/on-prem. Match offline needs before crowning an AI cloud winner.
		</p>

		<h3 class="sub">Why clinics switch now</h3>
		<ul class="chips" data-stagger>
			{triggers.map((item) => <li>{item}</li>)}
		</ul>
		<p class="note">One trigger is enough to look; two usually means you’re overdue.</p>
	</div>
</section>

<style>
	.context {
		background: var(--brand-wash);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.body {
		max-width: 62ch;
		margin: 2rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
		line-height: 1.65;
		text-align: center;
	}
	.sub {
		margin: 3rem 0 0;
		color: var(--navy);
		font-size: clamp(1.375rem, 2.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		max-width: 920px;
		margin: 1.5rem auto 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 999px;
		padding: 0.7rem 1.1rem;
		background: var(--surface);
		color: var(--navy);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.note {
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		text-align: center;
	}
</style>
