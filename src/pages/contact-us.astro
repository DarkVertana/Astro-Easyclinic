		rotate: 180deg;
	}

	.dial-menu {
		box-sizing: border-box;
		position: absolute;
		top: calc(1.75rem + 0.4375rem);
		left: 0;
		z-index: 20;
		/* wider than its column — it overflows the grid cell rather than squeezing */
		width: 340px;
		max-width: calc(100vw - 3rem);
		max-height: min(268px, 52vh);
		margin: 0;
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 0.25rem;
		background: var(--surface);
		box-shadow:
