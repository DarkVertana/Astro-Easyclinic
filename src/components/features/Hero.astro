---
import PageHero from '../PageHero.astro';

const modules = [
	{ href: '#emr', name: 'EMR', note: 'Charts & Rx' },
	{ href: '/appointment-scheduling-at-easy-clinic', name: 'Scheduling', note: 'Slots & walk-ins' },
	{ href: '/revenue-management', name: 'Billing', note: 'Invoices & till' },
	{ href: '/curapilot', name: 'Cura AI', note: 'Clinical copilot' },
	{ href: '/patient-engagement-at-easyclinic', name: 'Engagement', note: 'Portal & WhatsApp' },
	{ href: '/reports-and-dashboards', name: 'Reports', note: 'KPIs & dashboards' },
];
---

<PageHero
	eyebrow="Product"
	title="Clinic management software built around the EMR"
	lede="EMR, scheduling, billing, inventory, pharmacy, lab, and Cura AI, so clinical care, operations, and revenue stay connected."
	secondaryHref="/pricing"
	secondaryLabel="View Pricing"
>
	<div class="card">
		<p class="card-label">Modules</p>
		<ul class="rows">
			{
				modules.map((item) => (
					<li>
						<a href={item.href}>
							<strong>{item.name}</strong>
							<span>{item.note}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</PageHero>
