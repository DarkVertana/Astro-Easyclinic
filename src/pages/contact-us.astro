										name="phone"
										type="tel"
										placeholder="98765 43210"
										autocomplete="tel-national"
										required
									/>

									{/* what rides along with the number when the form posts */}
									<input type="hidden" name="dial" value={HOME.dial} data-dial-value />
									<input type="hidden" name="country" value={HOME.iso} data-dial-iso />

									<ul class="dial-menu" role="listbox" aria-label="Country" tabindex="-1" hidden data-dial-menu>
										{countries.map((country) => (
											<li
												role="option"
												id={`dial-${country.iso}`}
												data-iso={country.iso}
												data-dial={country.dial}
												data-flag={country.flag}
												data-name={country.name}
												aria-selected={country.iso === HOME.iso ? 'true' : 'false'}
											>
												<span class="flag" style={`--row:${country.flag}`} aria-hidden="true" />
												<span class="dial-name">{country.name}</span>
												<span class="dial-code">({country.dial})</span>
											</li>
										))}
									</ul>
								</div>
								<div class="field">
									<label for="speciality">Speciality</label>
									<span class="select">
										<select id="speciality" name="speciality">
											<option value="">Select a speciality</option>
											{specialities.map((item) => <option value={item}>{item}</option>)}
										</select>
										<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
											<path
												d="m4 6.5 4 4 4-4"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												stroke-linecap="round"
												stroke-linejoin="round"></path>
										</svg>
									</span>
								</div>
								<div class="field field-wide">
									<label for="note">Note or comment</label>
									<textarea
										id="note"
										name="note"
										rows="4"
										placeholder="Tell us what you need, and a convenient time to call"
									></textarea>
								</div>
							</div>

							<button class="submit" type="submit">Submit</button>
							<p class="consent">
								By submitting my data I agree to the <a href="/terms-of-service">terms</a> and
								<a href="/privacy-policy">privacy policy</a>.
							</p>
						</form>
					</div>
				</div>
			</section>

			<!-- where to find us -->
			<section class="map">
				<div class="inner">
					<div class="map-head">
						<p class="eyebrow">Our office</p>
						<h2>Come and see us in Kolkata</h2>
						<p class="lede">30 Circus Avenue, Kolkata — 700 017, India</p>
						<a
							class="btn"
							href="https://maps.google.com/?q=30+Circus+Avenue+Kolkata+700017+India"
							target="_blank"
							rel="noopener noreferrer"
						>
							Get directions
						</a>
					</div>
					<div class="map-frame">
						<iframe
							title={`${SITE_TITLE} office at 30 Circus Avenue, Kolkata`}
							src="https://www.google.com/maps?q=30+Circus+Avenue,+Kolkata+700017,+India&output=embed"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"></iframe>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// The country dial picker. The button shows the flag; the list shows flag,
	// country and code. The chosen dial and ISO ride in hidden inputs so the form
	// posts them with the number. No search box — typing letters jumps instead,
	// the way a native select behaves.
	const root = document.querySelector<HTMLElement>('[data-phone]');

	if (root) {
		const button = root.querySelector<HTMLButtonElement>('[data-dial-button]')!;
		const menu = root.querySelector<HTMLElement>('[data-dial-menu]')!;
		const flag = root.querySelector<HTMLElement>('[data-dial-flag]')!;
		const dialValue = root.querySelector<HTMLInputElement>('[data-dial-value]')!;
		const isoValue = root.querySelector<HTMLInputElement>('[data-dial-iso]')!;
		const options = Array.from(menu.querySelectorAll<HTMLLIElement>('li'));

		let active = 0;
		let typed = '';
		let typedAt = 0;

		// the list is its own scroll container, so move it rather than calling
		// scrollIntoView, which would also scroll the page behind the form
		const reveal = (row: HTMLLIElement, centre = false) => {
			const top = row.offsetTop;
			if (centre) {
				menu.scrollTop = top - menu.clientHeight / 2 + row.offsetHeight / 2;
			} else if (top < menu.scrollTop) {
				menu.scrollTop = top;
			} else if (top + row.offsetHeight > menu.scrollTop + menu.clientHeight) {
				menu.scrollTop = top + row.offsetHeight - menu.clientHeight;
			}
		};

		const setActive = (next: number, scroll = true) => {
			active = Math.max(0, Math.min(next, options.length - 1));
			options.forEach((option) => option.classList.remove('is-active'));
			const row = options[active];
			row.classList.add('is-active');
			menu.setAttribute('aria-activedescendant', row.id);
			if (scroll) reveal(row);
		};

		const open = () => {
			menu.hidden = false;
			button.setAttribute('aria-expanded', 'true');
			const chosen = options.findIndex((o) => o.getAttribute('aria-selected') === 'true');
			setActive(chosen < 0 ? 0 : chosen, false);
			reveal(options[active], true);
			menu.focus();
		};

		const close = (focusButton = true) => {
			menu.hidden = true;
			button.setAttribute('aria-expanded', 'false');
			if (focusButton) button.focus();
		};

		const choose = (option: HTMLLIElement) => {
			options.forEach((other) => other.setAttribute('aria-selected', 'false'));
			option.setAttribute('aria-selected', 'true');
			flag.style.setProperty('--row', option.dataset.flag ?? '0');
			dialValue.value = option.dataset.dial ?? '';
			isoValue.value = option.dataset.iso ?? '';
			button.setAttribute('aria-label', `Country code: ${option.dataset.name} ${option.dataset.dial}`);
			close();
		};

		button.addEventListener('click', () => (menu.hidden ? open() : close()));
		options.forEach((option, index) => {
			option.addEventListener('click', () => choose(option));
			option.addEventListener('mouseenter', () => setActive(index, false));
		});

		menu.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				setActive(active + 1);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				setActive(active - 1);
			} else if (event.key === 'Home') {
				event.preventDefault();
				setActive(0);
			} else if (event.key === 'End') {
				event.preventDefault();
				setActive(options.length - 1);
			} else if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				choose(options[active]);
			} else if (event.key === 'Escape') {
				event.preventDefault();
				close();
			} else if (event.key.length === 1 && /\S/.test(event.key)) {
				// type-ahead: letters within a second of each other build one term
				const now = Date.now();
				typed = now - typedAt > 1000 ? event.key : typed + event.key;
				typedAt = now;
				const hit = options.findIndex((option) =>
					(option.dataset.name ?? '').toLowerCase().startsWith(typed.toLowerCase())
				);
				if (hit >= 0) setActive(hit);
			}
		});

		document.addEventListener('click', (event) => {
			if (!menu.hidden && !root.contains(event.target as Node)) close(false);
		});
	}
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	/* ---------- intro ---------- */
	.intro {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.intro .inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 5.5rem;
		text-align: center;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-blue);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	h1 {
		margin: 1.25rem auto 0;
		color: var(--navy);
		font-size: clamp(2.25rem, 5vw, 3.75rem);
		font-weight: 700;
		line-height: 1.04;
		letter-spacing: -0.03em;
	}
	.intro .lede {
		max-width: 68ch;
		margin: 1.375rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}

	/* the three ways in, as cards rather than a run of text */
	.channels {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1080px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
		text-align: left;
	}
	.channels a {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		height: 100%;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 18px;
		padding: 1.375rem 1.5rem;
		background: linear-gradient(180deg, var(--surface), #fbfdff);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 0.05),
			0 10px 24px -8px rgba(10, 37, 64, 0.08);
		color: var(--navy);
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}
	@media (hover: hover) {
		.channels a:hover {
			border-color: #b2d9fc;
			box-shadow:
				0 1px 2px rgba(10, 37, 64, 0.06),
				0 20px 44px -14px rgba(10, 37, 64, 0.2);
			transform: translateY(-4px);
		}
	}
	.tile {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: var(--surface-tint);
		color: var(--brand-blue);
		box-shadow: inset 0 0 0 1px rgba(0, 128, 246, 0.09);
	}
	.channel-copy {
		display: flex;
		flex-direction: column;
		gap: 0.1875rem;
		min-width: 0;
	}
	.channel-copy small {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.channel-copy strong {
		color: var(--navy);
		font-size: 1rem;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	/* ---------- the form ---------- */
	.book {
		background: var(--brand-wash);
	}
	.book .panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 6rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.book .inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: 4rem;
		max-width: var(--page-max);
		margin: 0 auto;
	}

	.aside h2 {
		max-width: 18ch;
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.aside .lede {
		max-width: 46ch;
		margin: 1.25rem 0 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.assurances {
		display: grid;
		gap: 0.875rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.assurances li {
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr);
		align-items: start;
		gap: 0.75rem;
		color: var(--muted);
		font-size: 1rem;
	}
	.assurances svg {
		margin-top: 0.1875rem;
		color: var(--brand-blue);
	}
	.ratings {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		margin-top: 2.25rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--border);
		color: var(--navy);
		font-weight: 600;
	}
	.rating {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9375rem;
	}
	.rating-mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: var(--surface-tint);
	}
	.star {
		color: var(--brand-amber);
	}

	/* the form sits in a raised card, so it reads as the thing to do here */
	.form {
		border: 1px solid var(--border);
		border-radius: 22px;
		padding: 2.25rem;
		background: var(--surface);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 0.05),
			0 30px 60px -20px rgba(10, 37, 64, 0.22);
	}
	.fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.125rem;
	}
	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4375rem;
		margin: 0;
		min-width: 0;
	}
	.field-wide {
		grid-column: 1 / -1;
	}
	label {
		color: var(--navy);
		font-size: 0.875rem;
		font-weight: 600;
	}
	/* the flag button makes the phone's label row taller than a plain label, so
	   every label row is held to the same height and the inputs stay in line */
	.field > label,
	.phone-label {
		display: flex;
		align-items: center;
		min-height: 30px;
	}
	.req {
		color: var(--brand-red);
	}
	input,
	select,
	textarea {
		/* nothing sets box-sizing globally, so width:100% would otherwise be the
		   content box and every control would sit 34px wider than its column */
		box-sizing: border-box;
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 0.8125rem 0.9375rem;
		background: var(--surface);
		color: var(--ink);
		font-family: inherit;
		font-size: 1rem;
		line-height: 1.4;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	textarea {
		min-height: 118px;
		resize: vertical;
	}
	input::placeholder,
	textarea::placeholder {
		color: #9aa4b2;
	}
	input:hover,
	select:hover,
	textarea:hover {
		border-color: #cbd5e1;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		border-color: var(--brand-blue);
		box-shadow: 0 0 0 3px rgba(0, 128, 246, 0.16);
		outline: none;
	}
	/* the native arrow varies by platform, so the select carries its own */
	.select {
		position: relative;
		display: block;
	}
	.select select {
		appearance: none;
		padding-right: 2.5rem;
		cursor: pointer;
	}
	/* grey while the empty option is the one selected, like a real placeholder */
	.select select:has(option[value='']:checked) {
		color: #9aa4b2;
	}
	.select option {
		color: var(--ink);
	}
	.select svg {
		position: absolute;
		top: 50%;
		right: 0.9375rem;
		translate: 0 -50%;
		color: var(--muted);
		pointer-events: none;
	}

	.submit {
		width: 100%;
		margin-top: 1.5rem;
		border: 1.5px solid var(--brand-blue);
		border-radius: 10px;
		padding: 0.9375rem 1.5rem;
		background: var(--brand-blue);
		color: var(--surface);
		font-family: inherit;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
		transition:
			background 0.2s ease,
			border-color 0.2s ease;
	}
	.submit:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.submit:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 3px;
	}
	.consent {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.8125rem;
		text-align: center;
	}
	.consent a {
		color: var(--brand-blue-dark);
	}

	/* ---------- phone: country dial picker ---------- */
	/* every flag lives in one sprite of 40x30 cells, so the picker costs a single
	   36KB request rather than 248 — --row is the country's index in that sprite */
	.flag {
		display: block;
		flex-shrink: 0;
		width: 22px;
		height: 16.5px;
		border-radius: 2px;
		background-image: url('/flags.png');
		background-repeat: no-repeat;
		background-size: 22px auto;
		background-position: 0 calc(var(--row) * -16.5px);
		box-shadow: inset 0 0 0 1px rgba(10, 37, 64, 0.14);
	}
	/* the picker anchors to this row, so the list opens under the flag button */
	[data-phone] {
		position: relative;
	}
	.phone-label {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}
	.dial {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		flex-shrink: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 0.3125rem 0.4375rem;
		background: var(--surface);
		color: var(--muted);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
