---
import Cta from '../components/Cta.astro';
import Testimonials from '../components/Testimonials.astro';
import Hero from '../components/about/Hero.astro';
import Stats from '../components/about/Stats.astro';
import Story from '../components/about/Story.astro';
import Team from '../components/about/Team.astro';
import Values from '../components/about/Values.astro';
import Marketing from '../layouts/Marketing.astro';
import { SITE_TITLE } from '../consts';
---

<Marketing
	title={`About us — ${SITE_TITLE}`}
	description="EasyClinic clinic management software since 2003 — 5,000+ doctors, 18 countries. Practical EMR built for real practices."
	mainClass="about"
>
	<Hero />
	<Story />
	<Values />
	<Stats />
	<Team />
	<Testimonials moreHref="/testimonials" />
	<Cta />
</Marketing>
