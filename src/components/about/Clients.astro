---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../SectionHead.astro';

// client logos from the live about page, named by file
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/about/clients/*.jpg',
	{ eager: true }
);
const clients = Object.entries(logoModules)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod]) => {
		const slug = path.split('/').pop()!.replace('.jpg', '');
		const name = slug
			.split('-')
			.map((word) => (word.length <= 2 ? word.toUpperCase() : word[0].toUpperCase() + word.slice(1)))
			.join(' ')
			.replace(/^Dr /, 'Dr. ');
		return { image: mod.default, name };
	});
---

<section class="clients">
	<div class="inner">
		<SectionHead
			eyebrow="Trusted by"
			title="Our Esteemed Clients"
			lede="A few of the practices, hospitals and institutions that run on Easy Clinic."
		/>
		<ul class="content" data-stagger>
			{
				clients.map((client) => (
					<li>
						<Image src={client.image} alt={client.name} width={180} height={90} densities={[1, 2]} />
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.clients {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5.5rem 1.5rem;
	}
	.content {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: grid;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 1rem;
		background: var(--surface);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	li:hover {
		border-color: var(--brand-blue);
		box-shadow: 0 12px 28px rgba(10, 37, 64, 10%);
		transform: translateY(-3px);
	}
	li :global(img) {
		display: block;
		width: 100%;
		height: 64px;
		object-fit: contain;
		filter: grayscale(1);
		opacity: 0.8;
		transition:
			filter 0.2s ease,
			opacity 0.2s ease;
	}
	li:hover :global(img) {
		filter: none;
		opacity: 1;
	}
	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem;
		}
		.content {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem;
		}
		.content {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		li :global(img) {
			height: 48px;
		}
	}
</style>
