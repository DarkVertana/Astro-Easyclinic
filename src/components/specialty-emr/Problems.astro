---
import SectionHead from '../SectionHead.astro';
import type { Specialty } from './data';

interface Props {
	specialty: Specialty;
}

const { specialty } = Astro.props;
---

<section class="problems">
	<div class="panel">
		<SectionHead
			eyebrow={specialty.problemsEyebrow}
			title={specialty.problemsTitle}
			lede={specialty.problemsLede}
		/>

		<ul class="cards" data-stagger>
			{
				specialty.problems.map((item, index) => (
					<li>
						<span class="num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
						<h3>{item.title}</h3>
						{item.copy && <p>{item.copy}</p>}
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.problems {
		background: var(--surface);
	}
	.panel {
		background: var(--brand-wash);
		border-radius: 24px 24px 0 0;
		padding: 5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.cards li {
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 20px;
		padding: 1.75rem;
		background: var(--surface);
		box-shadow: 0 8px 24px rgba(10, 37, 64, 6%);
	}
	.num {
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 12px;
		background: var(--brand-wash-deep);
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	h3 {
		margin: 1.15rem 0 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.cards p {
		margin: 0.7rem 0 0;
		color: var(--muted);
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
	}
	@media (max-width: 720px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
