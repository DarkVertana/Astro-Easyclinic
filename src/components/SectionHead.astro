---
/* Reusable centered section heading: eyebrow + title + optional lede.
   tone="dark" flips the palette for navy bands. */
interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	tone?: 'light' | 'dark';
}

const { eyebrow, title, lede, tone = 'light' } = Astro.props;
---

<header class:list={['section-head', tone]}>
	{eyebrow && <p class="eyebrow">{eyebrow}</p>}
	{/* titles are internal constants; set:html allows deliberate <br> breaks */}
	<h2 set:html={title} />
	{lede && <p class="lede">{lede}</p>}
</header>

<style>
	.section-head {
		font-size: 16px;
		line-height: 1.5;
		text-align: center;
	}
	.eyebrow {
		margin: 0;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.dark .eyebrow {
		color: var(--brand-teal);
	}
	h2 {
		max-width: 24ch;
		margin: 0.85rem auto 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 2.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.dark h2 {
		color: var(--surface);
	}
	.lede {
		max-width: 56ch;
		margin: 1.15rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.dark .lede {
		color: rgba(255, 255, 255, 0.75);
	}
	@media (max-width: 720px) {
		.lede {
			font-size: 1.0625rem;
		}
	}
</style>
