---
/* Photo hero, same pattern as about/contact/pricing: photo + deco rings/dots,
   float chips, and a figcaption badge. Geos without a `heroImage` keep the
   original facts card so staged markets still render. */
import { Image } from 'astro:assets';
import PageHero from '../PageHero.astro';
import HeroFacts from './HeroFacts.astro';
import type { GeoMarket } from './data';

interface Props {
	market: GeoMarket;
}

const { market } = Astro.props;
const photo = market.heroImage;
---

<PageHero
	eyebrow={market.eyebrow}
	title={market.title}
	lede={market.lede}
	note={market.complianceNote}
	primaryHref="/contact-us#demo-form"
	primaryLabel="Book a free demo"
	secondaryHref="/pricing"
	secondaryLabel="See pricing"
>
	{/* facts move out of the right slot when a photo takes it over */}
	<HeroFacts slot="under-lede" facts={photo ? market.heroFacts : []} />

	<figure class:list={['artifact', { 'has-photo': photo }]}>
		<svg class="deco ring" viewBox="0 0 200 200" aria-hidden="true">
			<circle cx="100" cy="100" r="88" fill="none" stroke="var(--brand-teal)" stroke-width="2" opacity="0.5"></circle>
			<circle cx="100" cy="100" r="66" fill="none" stroke="var(--brand-blue)" stroke-width="2" opacity="0.35"></circle>
		</svg>
		<svg class="deco dots" viewBox="0 0 120 120" aria-hidden="true">
			{
				Array.from({ length: 25 }, (_, i) => (
					<circle cx={8 + (i % 5) * 26} cy={8 + Math.floor(i / 5) * 26} r="3.5" fill="var(--brand-blue)" opacity="0.35" />
				))
			}
		</svg>

		{
			photo ? (
				<Image
					class="photo"
					src={photo}
					alt={market.heroImageAlt ?? `A clinician using EasyClinic in a clinic in ${market.geo}`}
					densities={[1, 1.5]}
					loading="eager"
				/>
			) : (
				<div class="card">
					<p class="card-label">{`Clinics in ${market.geo}`}</p>
					<ul class="rows">
						{market.heroFacts.map((item) => (
							<li class="fact">
								<strong>{item.value}</strong>
								<span>{item.label}</span>
							</li>
						))}
					</ul>
				</div>
			)
		}

		<span class="float-chip chip-pin" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 21s7-4.4 7-10a7 7 0 1 0-14 0c0 5.6 7 10 7 10Z"></path>
				<circle cx="12" cy="11" r="2.6"></circle>
			</svg>
		</span>
		{
			photo && (
				<span class="float-chip chip-shield" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
						<path d="M12 2.5 20 6v6c0 4.7-3.4 8.6-8 9.5-4.6-.9-8-4.8-8-9.5V6Z" />
						<path d="m8.75 12 2.25 2.25L15.5 9.75" />
					</svg>
				</span>
			)
		}

		<figcaption class="badge">
			<strong>{market.heroBadge.value}</strong>
			<span>{market.heroBadge.label}</span>
		</figcaption>
	</figure>
</PageHero>

<style>
	.artifact {
		position: relative;
		margin: 0;
	}
	.artifact.has-photo {
		width: fit-content;
		margin: 0 auto;
	}
	.card {
		position: relative;
		z-index: 1;
	}
	.artifact :global(img.photo) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		max-width: 480px;
		height: auto;
		border-radius: 20px;
		box-shadow: 0 20px 48px rgba(10, 37, 64, 14%);
	}

	.deco {
		position: absolute;
		z-index: 0;
	}
	.ring {
		top: -3rem;
		right: -3rem;
		width: 140px;
		height: 140px;
	}
	.dots {
		bottom: -2.5rem;
		right: -1.75rem;
		width: 105px;
		height: 105px;
	}

	.float-chip {
		position: absolute;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 16px;
		background: var(--surface);
		color: var(--brand-blue);
		box-shadow: 0 12px 28px rgba(10, 37, 64, 16%);
		animation: float 5.5s ease-in-out infinite;
	}
	.chip-pin {
		top: -1.35rem;
		right: -1rem;
	}
	.chip-shield {
		top: 42%;
		left: -1.75rem;
		color: var(--brand-teal);
		animation-delay: 1.4s;
	}
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}

	.badge {
		position: absolute;
		left: -1.25rem;
		bottom: -1.5rem;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		max-width: 17rem;
		margin: 0;
		border-radius: 14px;
		padding: 0.8rem 1.1rem;
		background: var(--surface);
		box-shadow: 0 14px 32px rgba(10, 37, 64, 18%);
	}
	/* over the photo, not hanging below it */
	.has-photo .badge {
		bottom: 1.5rem;
	}
	.badge strong {
		color: var(--navy);
		font-size: 1rem;
		font-weight: 700;
	}
	.badge span {
		color: var(--muted);
		font-size: 0.8125rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.float-chip {
			animation: none;
		}
	}
	@media (max-width: 1080px) {
		.artifact {
			max-width: 520px;
			margin: 0 auto;
		}
		.badge {
			left: 0.75rem;
			bottom: -1rem;
		}
		.has-photo .badge {
			bottom: 0.75rem;
		}
		.chip-pin {
			right: 0.5rem;
		}
		.chip-shield {
			left: 0.75rem;
		}
		.ring {
			top: -1.5rem;
			right: -1rem;
			width: 110px;
			height: 110px;
		}
		.dots {
			right: -0.25rem;
			bottom: -1.5rem;
		}
	}
</style>
