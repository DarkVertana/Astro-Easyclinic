---
import SectionHead from '../SectionHead.astro';

const headers = ['Capability', 'EasyClinic', 'Ksatria', 'HealthTech Ghana (Health Pro HMS)', 'Smart Hospital Manager'];
const rows = [
	['Cloud SaaS', 'Yes', 'Cloud/on-prem mix', 'Often on-prem / local HMS', 'Self-hosted tilt'],
	['Cura AI', 'Live', '—', '—', '—'],
	['WhatsApp', 'Native style', 'Check', 'Check', 'Check'],
	['MoMo / payments', 'Confirm (e.g. Seerbit-class rails in demo)', 'Check', 'Check', 'Cashier / local'],
	['NHIS claims', 'Not confirmed — demo', 'Built around NHIS (live posture)', 'NHIS-oriented', 'Check'],
	['Offline / low connectivity', 'Cloud-first; confirm', 'Stronger local/offline story', 'Local HMS', 'Self-hosted offline angle'],
	['Telemedicine', 'In-product', 'Check', 'Check', 'Check'],
];
---

<section class="shortlist">
	<div class="inner">
		<SectionHead
			title="The shortlist"
			lede="✓ = native. NHIS/MoMo status called out honestly. Always request a current Ghana quote."
		/>
		<div class="table-wrap" role="region" aria-label="Ghana clinic software shortlist comparison" tabindex="0">
			<table>
				<thead>
					<tr>
						{headers.map((h) => <th scope="col">{h}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr>
								{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="hint">Details live in the vendor cards below — this table stays one-screen.</p>
	</div>
</section>

<style>
	.shortlist {
		background: var(--surface);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.table-wrap {
		overflow-x: auto;
		margin: 2.75rem auto 0;
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 18px;
		background: #fff;
		-webkit-overflow-scrolling: touch;
	}
	table {
		width: 100%;
		min-width: 760px;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.95rem 1rem;
		border-bottom: 1px solid rgba(10, 37, 64, 8%);
		text-align: left;
		vertical-align: top;
		color: var(--muted);
		line-height: 1.45;
	}
	thead th {
		background: var(--brand-wash);
		color: var(--navy);
		font-weight: 700;
		white-space: nowrap;
	}
	tbody th {
		color: var(--navy);
		font-weight: 650;
		width: 18%;
	}
	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: 0;
	}
	tbody td:nth-child(2) {
		color: var(--navy);
		font-weight: 600;
	}
	.hint {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		text-align: center;
	}
</style>
