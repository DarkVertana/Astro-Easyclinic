---
import SectionHead from '../SectionHead.astro';
---

<section class="verdict">
	<div class="inner">
		<SectionHead title="The verdict" />
		<p>
			EasyClinic is the AI + WhatsApp + telehealth all-rounder for Nigerian private clinics. Keep MocDoc
			in the final two for NDPA/language/HMO depth; keep eClinicPlus when local tier pricing and named
			HMO billing matter most. NDPA controls and Nigeria-specific HMO connectors: discuss in demo — no
			checkbox certification claims.
		</p>
	</div>
</section>

<style>
	.verdict {
		background: var(--surface);
		padding: 4.5rem 1.5rem 1rem;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
	}
	p {
		margin: 1.5rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.65;
		text-align: center;
	}
</style>
