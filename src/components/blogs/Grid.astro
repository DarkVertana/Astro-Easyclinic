---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<section class="index">
	<div class="panel">
		<ul class="cards" data-stagger>
			{
				posts.map((post) => (
					<li>
						<a href={`/blogs/${post.id}`}>
							{post.data.heroImage && (
								<Image
									class="shot"
									src={post.data.heroImage}
									alt=""
									widths={[420, 640, 900]}
									sizes="(max-width: 720px) 92vw, (max-width: 1080px) 44vw, 30vw"
								/>
							)}
							{post.data.category && <span class="pill">{post.data.category}</span>}
							<h2>{post.data.title}</h2>
							<p class="excerpt">{post.data.description}</p>
							<p class="meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.author && <span>{post.data.author}</span>}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.index {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 4.5rem 1.5rem 4rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}
	.cards a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.shot {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		border-radius: 16px;
		object-fit: cover;
	}
	.pill {
		display: inline-block;
		border-radius: 8px;
		padding: 0.3125rem 0.625rem;
		margin-top: 1.15rem;
		background: var(--brand-wash);
		color: var(--navy);
		font-size: 0.8125rem;
		font-weight: 500;
	}
	h2 {
		margin: 0.9rem 0 0;
		color: var(--navy);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.cards a:hover h2 {
		color: var(--brand-blue);
	}
	.excerpt {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin: 0.65rem 0 0;
		color: var(--muted);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	@media (max-width: 1080px) {
		.panel {
			padding: 3.5rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 2.5rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
