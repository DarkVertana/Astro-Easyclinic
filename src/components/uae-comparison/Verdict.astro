---
import SectionHead from '../SectionHead.astro';
---

<section class="verdict">
	<div class="inner">
		<SectionHead title="The verdict" />
		<p>
			If exchange certification is the blocker, shortlist Clinicea, MedicoPlus, or PappyJoe first. If you
			want AI + WhatsApp cloud ops and can confirm connectivity for your Emirate, EasyClinic is the
			strongest modern all-rounder — without inventing a NABIDH/Malaffi/Riayati checkbox claim.
		</p>
	</div>
</section>

<style>
	.verdict {
		background: var(--surface);
		padding: 4.5rem 1.5rem 1rem;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
	}
	p {
		margin: 1.5rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.65;
		text-align: center;
	}
</style>
