---
import SectionHead from '../SectionHead.astro';

const steps = [
	{
		label: 'Search',
		copy: 'Search the issue in plain words (module + action).',
	},
	{
		label: 'Filter',
		copy: 'Filter by category if the result list is long.',
	},
	{
		label: 'Follow',
		copy: 'Follow the steps; if you’re stuck mid-workflow, open a support chat with the article link.',
	},
];
---

<section class="find">
	<div class="inner">
		<SectionHead eyebrow="How to" title="How to find answers" />

		<ol class="cards" data-stagger>
			{
				steps.map((item) => (
					<li>
						<h3>{item.label}</h3>
						<p>{item.copy}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
<style>
	.find {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 5rem 1.5rem 4.5rem;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	.cards li {
		position: relative;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.5rem;
		background: var(--surface-tint);
		counter-increment: step;
	}
	.cards li::before {
		content: counter(step, decimal-leading-zero);
		display: block;
		margin-bottom: 0.85rem;
		color: var(--brand-teal);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.cards p {
		margin: 0.65rem 0 0;
		color: var(--muted);
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 4rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.inner {
			padding: 3rem 1rem 3rem;
		}
		.cards {
			margin-top: 2.25rem;
		}
	}
</style>
