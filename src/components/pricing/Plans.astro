---
import SectionHead from '../SectionHead.astro';
import { plans, priceAttrs } from './data';

const check = `<svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true"><path d="m3.6 8.3 2.9 2.9 5.9-6.2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// plan icons after the live pricing page: star, crown, diamond — drawn white on a coloured tile
const planIcons: Record<string, string> = {
	professional:
		'<path fill="currentColor" d="M11.53 2.3a.53.53 0 0 1 .94 0l2.31 4.68a2.12 2.12 0 0 0 1.6 1.16l5.16.75a.53.53 0 0 1 .3.9l-3.74 3.65a2.12 2.12 0 0 0-.61 1.87l.88 5.14a.53.53 0 0 1-.77.56l-4.62-2.43a2.12 2.12 0 0 0-1.97 0l-4.62 2.43a.53.53 0 0 1-.77-.56l.88-5.14a2.12 2.12 0 0 0-.61-1.87L2.16 9.8a.53.53 0 0 1 .3-.9l5.16-.76a2.12 2.12 0 0 0 1.6-1.16Z"/>',
	premium:
		'<path fill="currentColor" d="M11.56 3.27a.5.5 0 0 1 .88 0l2.95 5.6a1 1 0 0 0 1.52.3L21.18 5.5a.5.5 0 0 1 .8.52l-2.83 10.25a1 1 0 0 1-.96.73H5.81a1 1 0 0 1-.96-.73L2.02 6.02a.5.5 0 0 1 .8-.52l4.27 3.67a1 1 0 0 0 1.52-.3Z"/><path d="M5 21h14"/>',
	enterprise: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
};
---

<section class="plans" id="plans">
	<div class="panel">
		<SectionHead
			eyebrow="Choose a plan"
			title="Built for how you practise"
			lede="Billed per doctor. A reception licence is included, and there are no binding contracts."
		/>

		<div class="toggles">
			<div class="billing" role="group" aria-label="Billing period">
				<button type="button" data-billing="annual" aria-pressed="true">
					Billed annually <span class="save">Save 20%</span>
				</button>
				<button type="button" data-billing="quarterly" aria-pressed="false">Billed quarterly</button>
			</div>
		</div>

		<ul class="board" data-stagger>
			{
				plans.map((plan) => {
					const p = priceAttrs(plan.price);
					const custom = plan.price.usd.annual === 'custom';
					return (
						<li class:list={['card', { featured: plan.featured }]} id={`plan-${plan.id}`}>
							{plan.badge && <p class="ribbon">{plan.badge}</p>}

							<div class="head">
								<span class:list={['chip', `chip-${plan.id}`]} aria-hidden="true">
									<svg
										viewBox="0 0 24 24"
										width="22"
										height="22"
										fill="none"
										stroke="currentColor"
										stroke-width="1.9"
										stroke-linecap="round"
										stroke-linejoin="round"
										set:html={planIcons[plan.id]}
									/>
								</span>
								<h3>{plan.name}</h3>
							</div>
							<p class="audience">{plan.audience}</p>

							<div class="pricing">
								<p class="price">
									<span
										class="amount"
										data-price
										data-usd-annual={p.usdAnnual}
										data-usd-quarterly={p.usdQuarterly}
										data-inr-annual={p.inrAnnual}
										data-inr-quarterly={p.inrQuarterly}
									>
										{p.usdAnnual}
									</span>
									<small>{custom ? 'tailored quote' : plan.cadence}</small>
								</p>
								{
									custom ? (
										<p class="note">Please get in touch for a custom price</p>
									) : (
										<p class="note">
											<span class="note-annual">Billed annually — you save 20%</span>
											<span class="note-quarterly">Billed quarterly</span>
										</p>
									)
								}
							</div>

							<a class:list={['btn', plan.featured ? 'btn-solid' : 'btn-ghost']} href={plan.href}>
								{plan.cta}
							</a>

							<p class="plus">{plan.includesFrom ?? 'What you get'}</p>
							<ul class="features">
								{plan.features.map((feature) => (
									<li>
										<span class="tick" set:html={check} />
										{feature}
									</li>
								))}
							</ul>
						</li>
					);
				})
			}
		</ul>

		<div class="helper">
			<div class="helper-copy">
				<h3>Not sure which plan is right for you?</h3>
				<p>Tell us how your clinic runs and we will point you to the smallest plan that fits.</p>
			</div>
			<div class="helper-actions">
				<a class="btn btn-solid" href="/contact-us#demo-form">Book a Demo</a>
				<a class="btn btn-ghost" href="/contact-us">Talk to us</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { initBilling } from '../../scripts/billing';

	initBilling();
</script>
<style>
	.plans {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		text-align: center;
	}

	/* billing switch: slim tinted pill, the active option lifts out in white */
	.toggles {
		display: flex;
		justify-content: center;
		margin: 2rem auto 0;
	}
	.billing {
		display: inline-flex;
		gap: 0.25rem;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 999px;
		padding: 0.3rem;
		background: var(--surface-tint);
		box-shadow: inset 0 1px 2px rgba(10, 37, 64, 5%);
	}
	.billing button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 0;
		border-radius: 999px;
		padding: 0.6rem 1.15rem;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
		transition:
			background 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.billing button[aria-pressed='true'] {
		background: var(--surface);
		color: var(--navy);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 8%),
			0 4px 12px rgba(10, 37, 64, 8%);
	}
	.billing button:hover:not([aria-pressed='true']) {
		color: var(--navy);
	}
	.billing button:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 2px;
	}
	.save {
		border-radius: 999px;
		padding: 0.2rem 0.55rem;
		background: var(--brand-teal);
		color: var(--surface);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.board {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: stretch;
		gap: 1.5rem;
		max-width: var(--page-max);
		margin: 3.25rem auto 0;
		padding: 1rem 0 0;
		list-style: none;
		text-align: left;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 24px;
		padding: 2rem 1.85rem 2.1rem;
		background: var(--surface);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 4%),
			0 12px 32px rgba(10, 37, 64, 6%);
		transition:
			transform 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.card:not(.featured):hover {
		border-color: var(--brand-wash-deep);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 4%),
			0 22px 48px rgba(10, 37, 64, 11%);
		transform: translateY(-4px);
	}

	/* featured plan: navy with a soft blue glow and a hairline light edge */
	.card.featured {
		z-index: 1;
		overflow: visible;
		border-color: rgba(255, 255, 255, 10%);
		background:
			radial-gradient(120% 60% at 100% 0%, color-mix(in srgb, var(--brand-blue) 32%, transparent) 0%, transparent 60%),
			radial-gradient(90% 50% at 0% 100%, color-mix(in srgb, var(--brand-teal) 14%, transparent) 0%, transparent 65%),
			var(--navy);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 8%),
			0 30px 60px rgba(10, 37, 64, 26%);
		color: var(--surface);
		transform: translateY(-14px);
	}

	.ribbon {
		position: absolute;
		top: -0.85rem;
		left: 50%;
		width: max-content;
		margin: 0;
		border-radius: 999px;
		padding: 0.35rem 0.9rem;
		background: var(--brand-teal);
		color: var(--surface);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.3;
		box-shadow: 0 8px 18px color-mix(in srgb, var(--brand-teal) 35%, transparent);
		transform: translateX(-50%);
	}

	.head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.chip {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 42px;
		height: 42px;
		--tile: var(--brand-blue);
		border-radius: 12px;
		background: var(--tile);
		color: var(--surface);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 28%),
			0 8px 18px color-mix(in srgb, var(--tile) 32%, transparent);
	}
	/* tile colours follow the live pricing page: crown on amber, diamond on violet */
	.chip-premium {
		--tile: #f5a623;
	}
	.chip-enterprise {
		--tile: #7c5cff;
	}
	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.featured h3 {
		color: var(--surface);
	}

	.audience {
		min-height: 2.8em;
		margin: 0.9rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.45;
	}
	.featured .audience {
		color: rgba(255, 255, 255, 72%);
	}

	/* price block sits between two hairlines */
	.pricing {
		margin-top: 1.4rem;
		border-top: 1px solid var(--border);
		padding-top: 1.4rem;
	}
	.featured .pricing {
		border-top-color: rgba(255, 255, 255, 12%);
	}
	.price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.3rem 0.6rem;
		margin: 0;
	}
	.amount {
		color: var(--navy);
		font-size: clamp(2.375rem, 3.2vw, 3rem);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.035em;
		line-height: 1;
	}
	.featured .amount {
		color: var(--surface);
	}
	.price small {
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.featured .price small {
		color: rgba(255, 255, 255, 65%);
	}
	.note {
		margin: 0.55rem 0 0;
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.featured .note {
		color: rgba(255, 255, 255, 65%);
	}
	/* the billing script stamps html[data-billing]; show the matching note */
	.note-quarterly,
	:global(html[data-billing='quarterly']) .note-annual {
		display: none;
	}
	:global(html[data-billing='quarterly']) .note-quarterly {
		display: inline;
	}

	.btn {
		display: block;
		border-radius: 10px;
		padding: 0.85rem 1.15rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card .btn {
		margin-top: 1.5rem;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
		box-shadow: 0 10px 22px color-mix(in srgb, var(--brand-blue) 32%, transparent);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
		color: var(--surface);
	}
	.btn-ghost {
		border: 1.5px solid var(--brand-blue);
		background: var(--surface);
		color: var(--brand-blue);
	}
	.btn-ghost:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 3px;
	}

	.plus {
		margin: 1.75rem 0 0;
		color: var(--navy);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.featured .plus {
		color: var(--surface);
	}

	.features {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		margin: 0.95rem 0 0;
		padding: 0;
		list-style: none;
	}
	.features li {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		color: var(--ink);
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	.featured .features li {
		color: rgba(255, 255, 255, 90%);
	}
	/* solid teal check with a soft halo, as on the live pricing page */
	.tick {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 19px;
		height: 19px;
		margin-top: 0.05rem;
		border-radius: 50%;
		background: var(--brand-teal);
		color: var(--surface);
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--brand-teal) 16%, transparent),
			0 2px 6px color-mix(in srgb, var(--brand-teal) 35%, transparent);
	}
	.featured .tick {
		box-shadow:
			0 0 0 3px color-mix(in srgb, var(--brand-teal) 24%, transparent),
			0 2px 8px color-mix(in srgb, var(--brand-teal) 45%, transparent);
	}

	/* "not sure" helper strip */
	.helper {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		max-width: var(--page-max);
		margin: 3.5rem auto 0;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 24px;
		padding: 1.9rem 2.1rem;
		background:
			radial-gradient(60% 120% at 100% 50%, color-mix(in srgb, var(--brand-blue) 8%, transparent) 0%, transparent 70%),
			var(--surface-tint);
		text-align: left;
	}
	.helper-copy h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
	}
	.helper-copy p {
		max-width: 52ch;
		margin: 0.4rem 0 0;
		color: var(--muted);
	}
	.helper-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.btn,
		.billing button {
			transition: none;
		}
		.card.featured,
		.card:not(.featured):hover {
			transform: none;
		}
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
		.board {
			grid-template-columns: 1fr;
			max-width: 30rem;
			gap: 1.75rem;
			padding-top: 0;
		}
		.card.featured {
			order: -1;
			margin-top: 0.85rem;
			transform: none;
		}
		.audience {
			min-height: 0;
		}
		.helper {
			justify-content: center;
			text-align: center;
		}
		.helper-copy p {
			margin-inline: auto;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.billing {
			display: flex;
			width: 100%;
		}
		.billing button {
			flex: 1 1 auto;
			justify-content: center;
			padding: 0.65rem 0.6rem;
			font-size: 0.8125rem;
		}
		.save {
			padding: 0.15rem 0.45rem;
			font-size: 0.6875rem;
		}
		.card {
			padding: 1.75rem 1.4rem 1.85rem;
		}
		h3 {
			font-size: 1.2rem;
		}
		.helper {
			padding: 1.5rem 1.25rem;
		}
		.helper-actions {
			width: 100%;
		}
		.helper .btn {
			flex: 1 1 auto;
		}
	}
</style>
