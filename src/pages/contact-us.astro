	}
	.map-frame {
		border: 1px solid var(--border);
		border-radius: 22px;
		background: var(--surface-tint);
		box-shadow:
			0 1px 2px rgba(10, 37, 64, 0.05),
			0 30px 60px -20px rgba(10, 37, 64, 0.2);
