---
import SectionHead from '../SectionHead.astro';

const wins = [
	{
		title: 'EasyClinic is for',
		copy: 'Clinics that want AI-first ops and will sort exchange connection deliberately.',
	},
	{
		title: 'Local certified suites are for',
		copy: 'Clinics that must show NABIDH/Malaffi/Riayati certification immediately.',
	},
	{
		title: 'Arabic support',
		copy: 'Rx in Arabic/English on EasyClinic; full Arabic UI — confirm in demo.',
	},
	{
		title: 'Cura AI + WhatsApp',
		copy: 'Documentation assist and reminders patients actually read — after exchange fit is clear.',
	},
];
---

<section class="wins">
	<div class="panel">
		<SectionHead
			tone="dark"
			title="Honesty both sides"
			lede="Exchange certification is not checkbox marketing — pick the right posture for Monday morning."
		/>
		<ul class="rows" data-stagger>
			{
				wins.map((w) => (
					<li>
						<strong>{w.title}</strong>
						<p>{w.copy}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.wins {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
	}
	.rows {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.35rem 1.5rem;
		background: rgba(255, 255, 255, 5%);
	}
	strong {
		display: block;
		color: var(--surface);
		font-size: 1.0625rem;
	}
	p {
		margin: 0.55rem 0 0;
		color: rgba(255, 255, 255, 0.78);
		font-size: 0.9875rem;
		line-height: 1.55;
	}
	@media (max-width: 800px) {
		.rows {
			grid-template-columns: 1fr;
		}
	}
</style>
