# DevLabs CMS (/devlabs) — set these in Vercel Project Settings → Environment Variables.
# Never commit real secrets. Rotate ADMIN_PASSWORD after first deploy.

ADMIN_EMAIL=admin@easyclinic.io

# Bootstrap: plain password (timing-safe compare). Prefer rotating to a hash after setup.
ADMIN_PASSWORD=ChangeMe123!

# Optional preferred alternative to ADMIN_PASSWORD (bcryptjs hash, pure JS).
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# ADMIN_PASSWORD_HASH=$2a$12$...

# Signed session cookie secret — REQUIRED in production (min 32 characters).
# Fail-closed if missing/default in production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-32
