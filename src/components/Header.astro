---
import { Image } from 'astro:assets';
import logo from '../assets/footer-logo-img-1.png';
import { SITE_TITLE } from '../consts';

const navLinks = [
	{ href: '/curapilot', label: 'Cura AI' },
	{ href: '/features', label: 'Features' },
	{ href: '/solutions', label: 'Solutions' },
	{ href: '/pricing', label: 'Pricing' },
	{ href: '/about-us', label: 'About us' },
	{ href: '/blogs', label: 'Resources' },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = (href: string) => href === pathname || href === '/' + (subpath?.[0] || '');
---

<header>
	<div class="shell">
		<p class="banner">
			Ready to see {SITE_TITLE} in action? Book a demo of our AI EMR today.
		</p>
		<nav>
			<a class="brand" href="/">
				<Image
					class="logo"
					src={logo}
					alt={SITE_TITLE}
					width={182}
					height={36}
					densities={[1, 2]}
					loading="eager"
					fetchpriority="high"
				/>
			</a>
			<div class="links">
				{
					navLinks.map((link) => (
						<a href={link.href} class:list={['link', { active: isActive(link.href) }]}>
							{link.label}
						</a>
					))
				}
			</div>
			<div class="actions">
				<a class="btn btn-ghost" href="/contact-us#demo-form">Book a Demo</a>
				<a class="btn btn-solid" href="https://app.easyclinic.io/">Login</a>
			</div>

			<details class="menu">
				<summary>
					<span class="sr-only">Menu</span>
					<svg class="bars" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
						<path
							d="M2 4h12M2 8h12M2 12h12"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"></path>
					</svg>
					<svg class="cross" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
						<path
							d="m3.5 3.5 9 9m0-9-9 9"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"></path>
					</svg>
				</summary>
				<div class="drawer">
					{navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
					<a class="btn btn-ghost" href="/contact-us#demo-form">Book a Demo</a>
				</div>
			</details>
		</nav>
	</div>
</header>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('.menu');
	const bar = document.querySelector('header');

	if (menu && bar) {
		// the sheet starts where the header ends, and the banner height varies with wrapping
		const measure = () =>
			document.documentElement.style.setProperty(
				'--header-h',
				`${Math.round(bar.getBoundingClientRect().bottom)}px`
			);

		const close = () => {
			menu.open = false;
			document.body.classList.remove('menu-open');
		};

		measure();

		menu.addEventListener('toggle', () => {
			if (menu.open) measure();
			document.body.classList.toggle('menu-open', menu.open);
		});

		menu.querySelectorAll('.drawer a').forEach((link) => link.addEventListener('click', close));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) close();
		});

		window.addEventListener('resize', () => {
			if (!menu.open) return;
			if (window.innerWidth > 960) close();
			else measure();
		});
	}
</script>
<style>
	header {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.4;
	}
	.shell {
		padding: 1rem 1rem 0 1rem;
	}
	.banner {
		margin: 0 0 0.625rem;
		padding: 0.6875rem 1.5rem;
		border-radius: 12px;
		background: var(--brand-wash-deep);
		color: var(--navy);
		text-align: center;
		font-size: 1rem;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 3rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0 1.5rem;
		height: 80px;
	}
	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo {
		display: block;
		width: auto;
		height: 36px;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-right: auto;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--ink);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
	}
	.link:hover {
		color: var(--brand-blue);
	}
	.link.active {
		font-weight: 600;
	}
	.chevron {
		flex-shrink: 0;
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-shrink: 0;
	}
	.btn {
		border-radius: 8px;
		padding: 0.75rem 1.125rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}
	.btn-ghost {
		border: 1.5px solid var(--brand-blue);
		color: var(--brand-blue);
	}
	.btn-ghost:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	/* below the desktop breakpoint the same links live in a disclosure drawer */
	.menu {
		display: none;
		position: relative;
		flex-shrink: 0;
	}
	.menu summary {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 1.5px solid var(--brand-blue);
		border-radius: 8px;
		color: var(--brand-blue);
		cursor: pointer;
		list-style: none;
	}
	.menu summary::-webkit-details-marker {
		display: none;
	}
	.menu .cross,
	.menu[open] .bars {
		display: none;
	}
	.menu[open] .cross {
		display: block;
	}
	/* full-screen sheet under the header bar, so the logo and close stay reachable */
	.drawer {
		position: fixed;
		inset: var(--header-h, 140px) 0 0 0;
		z-index: 40;
		display: flex;
		flex-direction: column;
		padding: 0.5rem 1rem 2rem;
		background: var(--surface);
		overflow-y: auto;
		overscroll-behavior: contain;
		animation: sheet 0.28s cubic-bezier(0.22, 1, 0.36, 1) both;
	}
	@keyframes sheet {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
	}
	.drawer a {
		padding: 1.125rem 0.25rem;
		border-bottom: 1px solid var(--border);
		color: var(--ink);
		font-size: 1.1875rem;
		font-weight: 500;
		text-decoration: none;
	}
	.drawer a:hover {
		color: var(--brand-blue);
	}
	.drawer .btn-ghost {
		margin-top: 1.5rem;
		border-bottom: 1.5px solid var(--brand-blue);
		padding: 0.9375rem 1rem;
		text-align: center;
	}
	@media (prefers-reduced-motion: reduce) {
		.drawer {
			animation: none;
		}
	}

	/* Tighten spacing so Login is not clipped around laptop widths (~1024px). */
	@media (max-width: 1120px) and (min-width: 961px) {
		nav {
			gap: 1.25rem;
			padding: 0 1rem;
		}
		.links {
			gap: 0.75rem;
		}
		.btn {
			padding: 0.7rem 0.95rem;
		}
	}
	@media (max-width: 960px) {
		.links {
			display: none;
		}
		.actions {
			margin-left: auto;
		}
		.menu {
			display: block;
		}
		/* the toggle sits above the sheet it opens */
		.menu[open] summary {
			position: relative;
			z-index: 50;
		}
		nav {
			gap: 1rem;
			height: 72px;
		}
	}
	/* the page behind the sheet must not scroll */
	:global(body.menu-open) {
		overflow: hidden;
	}
	@media (max-width: 600px) {
		.actions .btn-ghost {
			display: none;
		}
		.banner {
			padding: 0.75rem 1rem;
			font-size: 0.875rem;
		}
		nav {
			padding: 0 1rem;
		}
		.logo {
			height: 30px;
		}
		.btn {
			padding: 0.6875rem 1rem;
		}
	}
</style>
