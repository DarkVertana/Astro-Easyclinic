---
const stats = [
	{ value: '23+', label: 'Years of industry expertise' },
	{ value: '5,000+', label: 'Doctors on the platform' },
	{ value: '18', label: 'Countries served' },
	{ value: '200+', label: 'Cities with live clinics' },
];
---

<section class="stats">
	<div class="panel">
		<ul data-stagger>
			{
				stats.map((item) => (
					<li>
						<strong>{item.value}</strong>
						<small>{item.label}</small>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.stats {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 3.5rem 1.5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0;
		list-style: none;
		text-align: center;
	}
	strong {
		display: block;
		font-size: 2.25rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	small {
		display: block;
		margin-top: 0.4rem;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.9375rem;
	}
	@media (max-width: 1080px) {
		.panel {
			padding: 2.5rem 1.25rem;
		}
		ul {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 2rem 1rem;
		}
	}
</style>
