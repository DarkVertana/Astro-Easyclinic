---
import SectionHead from '../SectionHead.astro';
import { plans, priceAttrs } from './data';

const check = `<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="m3.4 8.4 3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// one icon per plan, same chip language as the about page
const planIcons: Record<string, string> = {
	professional: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/>',
	premium:
		'<path d="M4 2a2 2 0 0 0-2 2v5a6 6 0 0 0 12 0V4a2 2 0 0 0-2-2"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>',
	enterprise:
		'<rect x="2" y="8" width="9" height="13" rx="1"/><path d="M11 21h9a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-8a1 1 0 0 0-1 1v4"/><path d="M6 12h.01M6 16h.01M15.5 7h.01M15.5 11h.01M15.5 15h.01"/>',
};
---

<section class="plans" id="plans">
	<div class="panel">
		<SectionHead
			eyebrow="Choose a plan"
			title="Built for how you practise"
			lede="Billed per doctor. A reception licence is included, and there are no binding contracts."
		/>

		<div class="toggles">
			<div class="billing" role="group" aria-label="Billing period">
				<button type="button" data-billing="annual" aria-pressed="true">
					Billed Annually (Save 20%)
				</button>
				<button type="button" data-billing="quarterly" aria-pressed="false">Billed Quarterly</button>
			</div>
		</div>

		<ul class="board" data-stagger>
			{
				plans.map((plan) => {
					const p = priceAttrs(plan.price);
					return (
						<li class:list={['card', { featured: plan.featured }]} id={`plan-${plan.id}`}>
							{plan.badge && <p class="ribbon">{plan.badge}</p>}
							<span class="chip" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									width="20"
									height="20"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={planIcons[plan.id]}
								/>
							</span>
							<h3>{plan.name}</h3>
							<p class="audience">{plan.audience}</p>
							<p class="price">
								<span
									class="amount"
									data-price
									data-usd-annual={p.usdAnnual}
									data-usd-quarterly={p.usdQuarterly}
									data-inr-annual={p.inrAnnual}
									data-inr-quarterly={p.inrQuarterly}
								>
									{p.usdAnnual}
								</span>
								<small>{plan.cadence}</small>
							</p>
							{plan.includesFrom && <p class="plus">{plan.includesFrom}</p>}
							<ul class="features">
								{plan.features.map((feature) => (
									<li>
										<span class="tick" set:html={check} />
										{feature}
									</li>
								))}
							</ul>
							<a class:list={['btn', plan.featured || plan.id === 'enterprise' ? 'btn-solid' : 'btn-ghost']} href={plan.href}>
								{plan.cta}
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="helper">
			<div class="helper-copy">
				<h3>Not sure which plan is right for you?</h3>
				<p>Tell us how your clinic runs and we will point you to the smallest plan that fits.</p>
			</div>
			<div class="helper-actions">
				<a class="btn btn-solid" href="/contact-us#demo-form">Book a Demo</a>
				<a class="btn btn-ghost" href="/contact-us">Talk to us</a>
			</div>
		</div>
	</div>
</section>

<script>
	import { initBilling } from '../../scripts/billing';

	initBilling();
</script>
<style>
	.plans {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		text-align: center;
	}

	.toggles {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.75rem 1rem;
		margin: 2rem auto 0;
	}

	.billing {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem;
		border: 1.5px solid var(--brand-blue);
		border-radius: 999px;
		padding: 0.25rem;
		background: var(--surface);
	}
	.billing button {
		border: 0;
		border-radius: 999px;
		padding: 0.7rem 1.1rem;
		background: transparent;
		color: var(--navy);
		font: inherit;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
	}
	.billing button[aria-pressed='true'] {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.billing button:hover:not([aria-pressed='true']) {
		background: var(--brand-wash);
	}
	.billing button:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 2px;
	}

	.board {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		align-items: stretch;
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3.25rem auto 0;
		padding: 1.25rem 0 0;
		list-style: none;
		text-align: left;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.75rem 1.6rem 1.6rem;
		background: var(--surface);
		box-shadow: 0 10px 28px rgba(10, 37, 64, 6%);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:not(.featured):hover {
		border-color: var(--brand-blue);
		box-shadow: 0 18px 40px rgba(10, 37, 64, 10%);
		transform: translateY(-4px);
	}
	.card.featured {
		z-index: 1;
		transform: translateY(-18px);
		border-color: transparent;
		background: var(--navy);
		box-shadow: 0 28px 56px rgba(10, 37, 64, 22%);
		color: var(--surface);
	}

	.ribbon {
		position: absolute;
		top: -0.85rem;
		left: 1.6rem;
		width: fit-content;
		margin: 0;
		border-radius: 999px;
		padding: 0.32rem 0.8rem;
		background: var(--brand-teal);
		color: var(--surface);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.3;
		box-shadow: 0 8px 18px rgba(4, 189, 175, 35%);
	}

	.chip {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 1.1rem;
		border-radius: 12px;
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.featured .chip {
		background: rgba(255, 255, 255, 12%);
		color: var(--brand-teal);
	}

	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.featured h3 {
		color: var(--surface);
	}

	.audience {
		margin: 0.4rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	.featured .audience {
		color: rgba(255, 255, 255, 72%);
	}

	.price {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem 0.65rem;
		margin: 1.25rem 0 0;
	}
	.amount {
		color: var(--navy);
		font-size: clamp(2.25rem, 3vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.04em;
		line-height: 1;
	}
	.featured .amount {
		color: var(--surface);
	}
	.price small {
		color: var(--muted);
		font-size: 0.875rem;
	}
	.featured .price small {
		color: rgba(255, 255, 255, 62%);
	}

	.plus {
		margin: 1.15rem 0 0;
		color: var(--navy);
		font-size: 0.8125rem;
		font-weight: 600;
	}
	.featured .plus {
		color: var(--brand-teal);
	}

	.features {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
		flex: 1 1 auto;
	}
	.features li {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		color: var(--ink);
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	.featured .features li {
		color: rgba(255, 255, 255, 92%);
	}
	.tick {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		margin-top: 0.05rem;
		border-radius: 50%;
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.featured .tick {
		background: rgba(4, 189, 175, 22%);
		color: var(--brand-teal);
	}

	.btn {
		display: block;
		margin-top: 1.5rem;
		border-radius: 8px;
		padding: 0.85rem 1.15rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.btn-ghost {
		border: 1.5px solid var(--brand-blue);
		color: var(--brand-blue);
	}
	.btn-ghost:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.featured .btn-solid {
		border-color: var(--surface);
		background: var(--surface);
		color: var(--navy);
	}
	.featured .btn-solid:hover {
		border-color: var(--brand-teal);
		background: var(--brand-teal);
		color: var(--surface);
	}

	/* "not sure" helper strip */
	.helper {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 20px;
		padding: 1.75rem 2rem;
		background: var(--brand-wash);
		text-align: left;
	}
	.helper-copy h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
	}
	.helper-copy p {
		max-width: 52ch;
		margin: 0.4rem 0 0;
		color: var(--muted);
	}
	.helper-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		flex-shrink: 0;
	}
	.helper .btn {
		margin-top: 0;
	}
	.helper .btn-ghost {
		background: var(--surface);
	}
	.helper .btn-ghost:hover {
		background: var(--brand-blue);
	}

	@media (prefers-reduced-motion: reduce) {
		.card.featured {
			transform: none;
		}
		.card:not(.featured):hover {
			transform: none;
		}
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
		.board {
			grid-template-columns: 1fr;
			max-width: 28rem;
			padding-top: 0;
		}
		.card.featured {
			transform: none;
			order: -1;
			margin-top: 0.85rem;
		}
		.helper {
			justify-content: center;
			text-align: center;
		}
		.helper-copy p {
			margin-inline: auto;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.billing {
			display: flex;
			width: 100%;
		}
		.billing button {
			flex: 1 1 auto;
			padding: 0.75rem 0.7rem;
			font-size: 0.8125rem;
		}
		h3 {
			font-size: 1.125rem;
		}
		.helper {
			padding: 1.5rem 1.25rem;
		}
		.helper-actions {
			width: 100%;
		}
		.helper .btn {
			flex: 1 1 auto;
		}
	}
</style>
