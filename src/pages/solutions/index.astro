---
import PageHero from '../../components/PageHero.astro';
import SolutionCta from '../../components/solutions/SolutionCta.astro';
import { indexCopy, solutions } from '../../components/solutions/data';
import Marketing from '../../layouts/Marketing.astro';
---

<Marketing title={indexCopy.seoTitle} description={indexCopy.seoDescription} mainClass="solutions-hub">
	<PageHero
		eyebrow={indexCopy.eyebrow}
		title={indexCopy.title}
		lede={indexCopy.lede}
		secondaryHref="/pricing"
		secondaryLabel="View Pricing"
		note={indexCopy.note}
	>
		<div class="card">
			<p class="card-label">Solutions</p>
			<ul class="rows">
				{
					indexCopy.heroFacts.map((item) => (
						<li class="fact">
							<strong>{item.value}</strong>
							<span>{item.label}</span>
						</li>
					))
				}
			</ul>
		</div>
	</PageHero>

	<section class="hub">
		<div class="panel">
			<h2>{indexCopy.sectionTitle}</h2>
			<p class="lede">{indexCopy.sectionLede}</p>
			<ul class="cards" data-stagger>
				{
					solutions.map((item) => (
						<li>
							<a class="card-link" href={item.href}>
								<h3>{item.cardTitle}</h3>
								<p>{item.cardCopy}</p>
								<span class="more">Explore</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="fit-strip">
		<div class="inner">
			<h2>{indexCopy.fitTitle}</h2>
			<p class="lede">{indexCopy.fitLede}</p>
			<ul>
				{
					solutions.map((item) => (
						<li>
							<a href={item.href}>{item.navLabel}</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<SolutionCta title={indexCopy.ctaTitle} lede={indexCopy.ctaLede} />
</Marketing>

<style>
	.hub {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.panel h2 {
		max-width: 20ch;
		margin: 0 auto;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.panel .lede {
		max-width: 52ch;
		margin: 1.15rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		text-align: center;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--border);
		border-radius: 20px;
		padding: 1.75rem;
		background: var(--surface-tint);
		color: inherit;
		text-decoration: none;
	}
	.card-link:hover {
		border-color: var(--brand-blue);
	}
	.card-link h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.card-link p {
		margin: 0.75rem 0 0;
		color: var(--muted);
		flex: 1;
	}
	.more {
		margin-top: 1.25rem;
		color: var(--brand-blue);
		font-size: 0.9375rem;
		font-weight: 600;
	}
	.card-link:hover .more {
		text-decoration: underline;
	}

	.fit-strip {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.fit-strip .inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 1rem 1.5rem 4.5rem;
		text-align: center;
	}
	.fit-strip h2 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.5rem, 2.8vw, 2rem);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}
	.fit-strip .lede {
		max-width: 48ch;
		margin: 0.85rem auto 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.fit-strip ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	.fit-strip a {
		display: inline-block;
		border: 1.5px solid var(--border);
		border-radius: 999px;
		padding: 0.55rem 1rem;
		color: var(--navy);
		font-weight: 600;
		text-decoration: none;
	}
	.fit-strip a:hover {
		border-color: var(--brand-blue);
		color: var(--brand-blue);
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
		.cards {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.fit-strip .inner {
			padding: 0.5rem 1rem 3rem;
		}
	}
</style>
