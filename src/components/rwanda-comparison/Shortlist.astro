---
import SectionHead from '../SectionHead.astro';

const headers = ['Capability', 'EasyClinic', 'CareLogic', 'MocDoc'];
const rows = [
	['Cura AI', 'Live', '—', 'Check'],
	['WhatsApp', 'Native style', 'SMS', 'Check'],
	['Telemedicine', 'Yes', 'Check', 'Check'],
	['RSSB / Mutuelle', 'Not confirmed — demo', 'Direct insurance workflow (live)', 'Insurance workflow'],
	['Multilingual Rx', 'Yes', 'Check', 'Check'],
	['Pricing', 'Plans + quote', 'Tiered (Clinic Starter+)', 'Quote'],
];
---

<section class="shortlist">
	<div class="inner">
		<SectionHead
			title="The shortlist"
			lede="Get RWF quotes; confirm insurance scheme support explicitly."
		/>
		<div class="table-wrap" role="region" aria-label="Rwanda clinic software shortlist comparison" tabindex="0">
			<table>
				<thead>
					<tr>
						{headers.map((h) => <th scope="col">{h}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr>
								{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="hint">Details live in the vendor cards below — this table stays one-screen.</p>
	</div>
</section>

<style>
	.shortlist {
		background: var(--surface);
		padding: 5rem 1.5rem;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
	}
	.table-wrap {
		overflow-x: auto;
		margin: 2.75rem auto 0;
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 18px;
		background: #fff;
		-webkit-overflow-scrolling: touch;
	}
	table {
		width: 100%;
		min-width: 680px;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}
	th,
	td {
		padding: 0.95rem 1rem;
		border-bottom: 1px solid rgba(10, 37, 64, 8%);
		text-align: left;
		vertical-align: top;
		color: var(--muted);
		line-height: 1.45;
	}
	thead th {
		background: var(--brand-wash);
		color: var(--navy);
		font-weight: 700;
		white-space: nowrap;
	}
	tbody th {
		color: var(--navy);
		font-weight: 650;
		width: 18%;
	}
	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: 0;
	}
	tbody td:nth-child(2) {
		color: var(--navy);
		font-weight: 600;
	}
	.hint {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
		text-align: center;
	}
</style>
