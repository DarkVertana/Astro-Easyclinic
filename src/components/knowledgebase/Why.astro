---
import SectionHead from '../SectionHead.astro';
import { HELP_URL } from './links';

const columns = [
	{
		title: 'Knowledgebase',
		copy: 'How-tos, setup, and “where is this setting?” → Knowledgebase.',
		href: HELP_URL,
		label: 'Open knowledgebase',
		external: true,
	},
	{
		title: 'Support',
		copy: 'Account access, billing disputes, outages, data fixes → Contact support.',
		href: '/contact-us',
		label: 'Contact support',
		external: false,
	},
];
---

<section class="why">
	<div class="panel">
		<SectionHead
			tone="dark"
			title="Knowledgebase first; support when it must be human"
		/>

		<ul class="split" data-stagger>
			{
				columns.map((item) => (
					<li>
						<h3>{item.title}</h3>
						<p>{item.copy}</p>
						<a
							href={item.href}
							target={item.external ? '_blank' : undefined}
							rel={item.external ? 'noopener noreferrer' : undefined}
						>
							{item.label}
							<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M5 12h14" />
								<path d="m13 6 6 6-6 6" />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.why {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}

	.split {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: 920px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.split li {
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.75rem;
		background: rgba(255, 255, 255, 5%);
	}
	h3 {
		margin: 0;
		color: var(--surface);
		font-size: 1.1875rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.split p {
		margin: 0.7rem 0 0;
		color: rgba(255, 255, 255, 0.72);
	}
	.split a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.25rem;
		color: var(--brand-teal);
		font-weight: 600;
		text-decoration: none;
	}
	.split a:hover {
		text-decoration: underline;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 4rem;
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.split {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
