---
import SectionHead from '../SectionHead.astro';
import type { MarketComparison } from './types';

interface Props {
	data: MarketComparison;
}

const { data } = Astro.props;
---

<section class="verdict">
	<div class="inner">
		<SectionHead title="The verdict" />
		<p>{data.verdict}</p>
	</div>
</section>

<style>
	.verdict {
		background: var(--surface);
		padding: 4.5rem 1.5rem 1rem;
	}
	.inner {
		max-width: 720px;
		margin: 0 auto;
	}
	p {
		margin: 1.5rem auto 0;
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1.65;
		text-align: center;
	}
</style>
