		icon: 'M5.6 2.6 7 5.1 5.7 6.4a7.4 7.4 0 0 0 3.9 3.9l1.3-1.3 2.5 1.4v2.2a1 1 0 0 1-1.1 1A11.4 11.4 0 0 1 2.4 3.7a1 1 0 0 1 1-1.1z',
