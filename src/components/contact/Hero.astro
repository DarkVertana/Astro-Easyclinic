---
const channels = [
	{
		label: 'Email us',
		value: 'hello@easyclinic.io',
		href: 'mailto:hello@easyclinic.io',
		icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
	},
	{
		label: 'Call us',
		value: '+91 91477 70277',
		href: 'tel:+919147770277',
		icon: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c1 .3 2 .5 3 .6a2 2 0 0 1 1.6 2Z"/>',
	},
	{
		label: 'Visit us',
		value: '30 Circus Avenue, Kolkata — 700 017, India',
		href: 'https://maps.google.com/?q=30+Circus+Avenue+Kolkata',
		icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
	},
];
---

<section class="hero">
	<div class="inner">
		<p class="eyebrow">Contact us</p>
		<h1>Need some help?</h1>
		<p class="lede">
			Questions? Concerns? Whatever it is, EasyClinic does real time support and customer service the
			perfect way. No more long waits, call centre attitude or robot answering services. Our support
			team is available via phone, email and chat to quickly and decisively resolve any issues.
		</p>

		<ul class="cards">
			{
				channels.map((item) => (
					<li>
						<a href={item.href}>
							<span class="chip" aria-hidden="true">
								<svg
									viewBox="0 0 24 24"
									width="18"
									height="18"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									set:html={item.icon}
								/>
							</span>
							<span class="body">
								<small>{item.label}</small>
								<strong>{item.value}</strong>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 4.75rem 1.5rem 2.75rem;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--brand-blue);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(2.5rem, 5vw, 3.75rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}
	.lede {
		margin: 1.25rem auto 0;
		max-width: 46rem;
		color: #333;
		font-size: 1.0625rem;
		line-height: 1.55;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.1rem;
		max-width: 67.5rem;
		margin: 3.25rem auto 0;
		padding: 0;
		list-style: none;
		text-align: left;
	}
	.cards a {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		height: 100%;
		min-height: 9.9rem;
		box-sizing: border-box;
		border: 1px solid rgba(255, 255, 255, 70%);
		border-radius: 16px;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 88%);
		color: inherit;
		text-decoration: none;
		box-shadow: 0 10px 30px rgba(10, 37, 64, 7%);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.cards a:hover {
		transform: translateY(-3px);
		box-shadow: 0 18px 40px rgba(10, 37, 64, 11%);
	}
	.chip {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		box-sizing: border-box;
		border: 1px solid var(--brand-wash-deep);
		border-radius: 10px;
		background: var(--brand-wash);
		color: var(--brand-blue);
	}
	.body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	.body small {
		color: var(--navy);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}
	.body strong {
		color: var(--navy);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.45;
		transition: color 0.2s ease;
	}
	.cards a:hover strong {
		color: var(--brand-blue);
	}

	@media (prefers-reduced-motion: reduce) {
		.cards a {
			transition: none;
		}
		.cards a:hover {
			transform: none;
		}
	}
	@media (max-width: 900px) {
		.cards {
			grid-template-columns: 1fr;
			max-width: 28rem;
		}
		.cards a {
			min-height: 0;
			padding: 1.25rem;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 3rem 1rem 2.5rem;
		}
	}
</style>
