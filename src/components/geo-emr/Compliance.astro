---
import SectionHead from '../SectionHead.astro';
import type { GeoMarket } from './data';

interface Props {
	market: GeoMarket;
}

const { market } = Astro.props;
---

<section class="compliance">
	<div class="panel">
		<SectionHead
			tone="dark"
			eyebrow={market.complianceEyebrow}
			title={market.complianceTitle}
			lede={market.complianceLede}
		/>

		<ul class="rows" data-stagger>
			{
				market.complianceBullets.map((bullet) => (
					<li>
						<span class="mi" aria-hidden="true">
							<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
							</svg>
						</span>
						<p>{bullet}</p>
					</li>
				))
			}
		</ul>

		<p class="note">Ask for the current status in your demo — we won’t checkbox-claim it here.</p>
	</div>
</section>
<style>
	.compliance {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}

	.rows {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1040px;
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.rows li {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.35rem 1.5rem;
		background: rgba(255, 255, 255, 5%);
	}
	.mi {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		background: rgba(255, 255, 255, 8%);
		color: var(--brand-teal);
	}
	.rows p {
		margin: 0.35rem 0 0;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.9375rem;
	}

	.note {
		margin: 2.25rem 0 0;
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.9375rem;
		text-align: center;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 4rem;
		}
	}
	@media (max-width: 720px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.rows {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
