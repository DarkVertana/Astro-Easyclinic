---
import SectionHead from '../SectionHead.astro';

const icons: Record<string, string> = {
	users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
	log: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h4"/>',
	exchange: '<path d="M3 8h14l-3-3"/><path d="M21 16H7l3 3"/>',
};

const controls = [
	{
		icon: 'users',
		title: 'Role-based access',
	},
	{
		icon: 'lock',
		title: 'Encryption in transit/at rest',
	},
	{
		icon: 'log',
		title: 'Audit logs',
	},
	{
		icon: 'exchange',
		title: 'API standards',
		copy: 'HL7, FHIR, DICOM; ABHA status in demo',
	},
];
---

<section class="security">
	<div class="panel">
		<SectionHead
			tone="dark"
			eyebrow="Security"
			title="Security and compliance, designed in"
			lede="Sensitive patient data needs controls from the first architecture decision — not bolted on at go-live."
		/>

		<ul class="cards" data-stagger>
			{
				controls.map((item) => (
					<li>
						<span class="mi" aria-hidden="true">
							<svg
								viewBox="0 0 24 24"
								width="19"
								height="19"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								set:html={icons[item.icon]}
							/>
						</span>
						<h3>{item.title}</h3>
						{item.copy && <p>{item.copy}</p>}
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.security {
		background: var(--surface);
	}
	.panel {
		background: var(--navy);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 5rem;
		color: var(--surface);
		font-size: 16px;
		line-height: 1.5;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.cards li {
		border: 1px solid rgba(255, 255, 255, 9%);
		border-radius: 18px;
		padding: 1.75rem;
		background: rgba(255, 255, 255, 5%);
	}

	.mi {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		background: rgba(255, 255, 255, 8%);
		color: var(--brand-teal);
	}

	h3 {
		margin: 1.15rem 0 0;
		color: var(--surface);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.cards p {
		margin: 0.7rem 0 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.9375rem;
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 4rem;
		}
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.cards {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
