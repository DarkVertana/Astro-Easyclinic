const legal = [
	{ label: 'Privacy policy', href: '/privacy' },
	{ label: 'Terms of service', href: '/terms' },
];

const year = new Date().getFullYear();
---

<footer>
	<div class="panel">
		<div class="grid">
			<div class="brand">
				<a href="/">
					<Image class="logo" src={logo} alt={SITE_TITLE} width={182} height={36} densities={[1, 2]} />
				</a>
				<p class="tagline">
					Helping healthcare practices run smoothly and grow confidently since 2003.
				</p>
				<ul class="socials">
					{
						socials.map((social) => (
							<li>
								<a href={social.href} target="_blank" rel="noopener noreferrer">
									<span class="sr-only">{`${SITE_TITLE} on ${social.label}`}</span>
									<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
										<path fill="currentColor" d={social.path} />
									</svg>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			{
				columns.map((column) => (
					<nav class="column" aria-label={column.heading}>
						<h2>{column.heading}</h2>
						<ul>
							{column.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="base">
			<p class="copyright">
				&copy; {year} Novel Medicare Solutions Pvt Ltd. All rights reserved.
			</p>
			<ul class="legal">
				{
					legal.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
<style>
	/* white behind the panel, so its rounded top corners read against the section above */
	footer {
		background: var(--surface);
		padding: 0;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		text-align: left;
	}
	.panel {
		border-radius: 28px 28px 0 0;
		padding: 4rem 1.5rem 2.5rem;
		background: var(--brand-wash);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
		gap: 2.5rem 2rem;
		max-width: var(--page-max);
		margin: 0 auto;
	}

	.brand .logo {
		display: block;
		width: auto;
		height: 36px;
	}
	.tagline {
		max-width: 34ch;
		margin: 1.25rem 0 0;
		color: var(--muted);
	}
	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	.socials a {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--brand-wash-deep);
		color: var(--navy);
	}
	.socials a:hover {
		background: var(--navy);
		color: var(--surface);
	}

	.column h2 {
		margin: 0 0 1.25rem;
		color: var(--navy);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.column ul {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.column a {
		color: var(--muted);
		text-decoration: none;
	}
	.column a:hover {
		color: var(--brand-blue);
	}

	.base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		max-width: var(--page-max);
		margin: 3.5rem auto 0;
		border-top: 1px solid var(--brand-wash-deep);
		padding-top: 1.5rem;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.copyright {
		margin: 0;
	}
	.legal {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.legal a {
		color: var(--muted);
		text-decoration: none;
	}
	.legal a:hover {
		color: var(--brand-blue);
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 3rem 1.5rem 2rem;
		}
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 640px) {
		.panel {
			border-radius: 20px 20px 0 0;
			padding: 2.5rem 1rem 2rem;
		}
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 1.5rem;
		}
		.base {
			margin-top: 2.5rem;
			gap: 0.75rem;
		}
		.legal {
			gap: 1.5rem;
		}
	}
</style>
