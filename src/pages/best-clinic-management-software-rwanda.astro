---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Context from '../components/rwanda-comparison/Context.astro';
import Hero from '../components/rwanda-comparison/Hero.astro';
import Shortlist from '../components/rwanda-comparison/Shortlist.astro';
import SwitchCost from '../components/rwanda-comparison/SwitchCost.astro';
import Vendors from '../components/rwanda-comparison/Vendors.astro';
import Verdict from '../components/rwanda-comparison/Verdict.astro';
import Wins from '../components/rwanda-comparison/Wins.astro';
import Marketing from '../layouts/Marketing.astro';

const faqs = [
	{
		question: 'Best in Rwanda?',
		answer:
			'EasyClinic for modern private-clinic ops; CareLogic when scheme billing must be proven day one.',
	},
	{
		question: 'RSSB / Mutuelle?',
		answer: 'Confirm EasyClinic status in demo; CareLogic claims direct workflows.',
	},
	{
		question: 'WhatsApp?',
		answer: 'Yes on EasyClinic.',
	},
];
---

<Marketing
	title="Best Clinic Management Software Rwanda (2026 Comparison) — EasyClinic"
	description="Compare clinic management software Rwanda — EasyClinic vs CareLogic and MocDoc on Cura AI, telemedicine, WhatsApp, and insurance workflows."
	mainClass="rwanda-comparison"
>
	<Hero />
	<Context />
	<Shortlist />
	<Vendors />
	<Wins />
	<SwitchCost />
	<Verdict />
	<Faq items={faqs} />
	<Cta
		title="See EasyClinic on a Rwandan clinic workflow"
		lede="Book a demo — AI docs, WhatsApp, and insurance fit."
		primaryHref="/contact-us#demo-form"
		primaryLabel="Book a free demo"
		secondaryHref="/pricing"
		secondaryLabel="See pricing"
	/>
</Marketing>
