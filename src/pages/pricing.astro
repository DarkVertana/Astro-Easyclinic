---
import BaseHead from '../components/BaseHead.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Testimonials from '../components/Testimonials.astro';
import Compare from '../components/pricing/Compare.astro';
import Hero from '../components/pricing/Hero.astro';
import Plans from '../components/pricing/Plans.astro';
import { pricingFaqs } from '../components/pricing/data';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Pricing — ${SITE_TITLE}`}
			description="EasyClinic EMR and clinic management pricing — Professional, Premium, and Enterprise. Per doctor, reception included, no lock-in."
		/>
		{/* Geo currency hint before paint — cached region / India TZ/locale → INR, else USD. */}
		<script is:inline>
			(function () {
				try {
					var region = localStorage.getItem('ec_pricing_region');
					var tz = '';
					try {
						tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
					} catch (e) {}
					var lang = (navigator.language || '').toLowerCase();
					var currency =
						region === 'IN' ||
						tz === 'Asia/Kolkata' ||
						tz === 'Asia/Calcutta' ||
						lang === 'en-in' ||
						lang === 'hi-in'
							? 'inr'
							: 'usd';
					document.documentElement.dataset.currency = currency;
					document.documentElement.dataset.billing = 'annual';
				} catch (e) {
					document.documentElement.dataset.currency = 'usd';
					document.documentElement.dataset.billing = 'annual';
				}
			})();
		</script>
	</head>
	<body>
		<Header />
		<main class="pricing">
			<Hero />
			<Plans />
			<!-- Apply currency to prices immediately after they exist (before deferred modules). -->
			<script is:inline>
				(function () {
					var currency = document.documentElement.dataset.currency || 'usd';
					var period = document.documentElement.dataset.billing || 'annual';
					document.querySelectorAll('[data-price]').forEach(function (el) {
						var next = el.getAttribute('data-' + currency + '-' + period);
						if (next) el.textContent = next;
					});
					document.documentElement.setAttribute('data-prices-ready', '');
				})();
			</script>
			<Compare />
			<Testimonials />
			<Faq items={pricingFaqs} />
			<Cta />
		</main>
		<Footer />
	</body>
</html>

<script>
	const sections = [...document.querySelectorAll<HTMLElement>('main.pricing > section')];
	const [hero, ...rest] = sections;
	hero?.classList.add('is-visible');

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const canObserve = 'IntersectionObserver' in window && !reduceMotion;

	if (!canObserve) {
		rest.forEach((section) => section.classList.add('is-visible'));
	} else {
		/* Mark anything already near the viewport before enabling hide-until-reveal. */
		const nearFold = window.innerHeight * 0.92;
		rest.forEach((section) => {
			if (section.getBoundingClientRect().top < nearFold) {
				section.classList.add('is-visible');
			}
		});

		/* Progressive enhance only after in-view sections are marked visible. */
		document.documentElement.classList.add('js-reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -6% 0px', threshold: 0.04 }
		);
		rest.forEach((section) => {
			if (!section.classList.contains('is-visible')) observer.observe(section);
		});
	}
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
</style>

<style is:global>
	/* Default: sections stay visible. js-reveal is added only after IO-ready JS marks
	   already-in-view sections, so first paint never leaves blank opacity gaps. */
	@media (prefers-reduced-motion: no-preference) {
		html.js-reveal main.pricing > section:not(.is-visible) {
			opacity: 0;
			transform: translateY(16px);
			transition:
				opacity 0.55s ease,
				transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.pricing > section.is-visible {
			opacity: 1;
			transform: none;
		}

		html.js-reveal main.pricing > section:not(.is-visible) [data-stagger] > * {
			opacity: 0;
			transform: translateY(12px);
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > * {
			opacity: 1;
			transform: none;
			transition:
				opacity 0.5s ease,
				transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > :nth-child(2) {
			transition-delay: 0.07s;
		}
		html.js-reveal main.pricing > section.is-visible [data-stagger] > :nth-child(3) {
			transition-delay: 0.14s;
		}
	}

	main.pricing {
		overflow-x: clip;
	}
</style>
