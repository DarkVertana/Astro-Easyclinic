---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	mainClass?: string;
}

const { title, description, mainClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		{/* set before paint, so sections are only hidden when the observer can reveal them */}
		<script is:inline>
			document.documentElement.classList.add('js-reveal');
		</script>
	</head>
	<body>
		<Header />
		<main class:list={['page', mainClass]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	const sections = [...document.querySelectorAll<HTMLElement>('main.page > section')];
	const [hero, ...rest] = sections;
	hero?.classList.add('is-visible');

	if (!('IntersectionObserver' in window)) {
		rest.forEach((section) => section.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px', threshold: 0.06 }
		);
		rest.forEach((section) => observer.observe(section));
	}
</script>

<style>
	main {
		width: 100%;
		max-width: none;
		margin: 0;
		padding: 0;
	}
</style>

<style is:global>
	@media (prefers-reduced-motion: no-preference) {
		html.js-reveal main.page > section:first-child {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main.page > section:not(:first-child) {
			opacity: 0;
			transform: translateY(24px);
			transition:
				opacity 0.7s ease,
				transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.page > section.is-visible {
			opacity: 1;
			transform: none;
		}

		html.js-reveal main.page > section [data-stagger] > * {
			opacity: 0;
			transform: translateY(18px);
			transition:
				opacity 0.6s ease,
				transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > * {
			opacity: 1;
			transform: none;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(2) {
			transition-delay: 0.09s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(3) {
			transition-delay: 0.18s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(4) {
			transition-delay: 0.27s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(5) {
			transition-delay: 0.36s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(6) {
			transition-delay: 0.45s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(7) {
			transition-delay: 0.54s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(8) {
			transition-delay: 0.63s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(9) {
			transition-delay: 0.72s;
		}
		html.js-reveal main.page > section.is-visible [data-stagger] > :nth-child(10) {
			transition-delay: 0.81s;
		}
	}
</style>
