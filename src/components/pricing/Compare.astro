---
import SectionHead from '../SectionHead.astro';
import { compareGroups, plans } from './data';

const columns = plans.map((plan) => ({
	id: plan.id,
	name: plan.name,
	featured: Boolean(plan.featured),
}));

const mark = (on: boolean) =>
	on
		? `<span class="yes"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.4 8.4 3 3 6.2-6.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr-only">Included</span></span>`
		: `<span class="no" aria-hidden="true">—</span><span class="sr-only">Not included</span>`;
---

<section class="compare" id="compare">
	<div class="inner">
		<SectionHead
			eyebrow="What's included"
			title="Compare every module"
			lede="Professional covers day-to-day clinic work. Premium adds specialist and multi-location tools. Enterprise is the full operating system for clinic chains."
		/>

		<div class="compare-table">
			<p class="scroll-hint" aria-hidden="true">Swipe to compare →</p>
			<div
				class="scroller"
				tabindex="0"
				role="region"
				aria-label="Compare plans table. Scroll horizontally to see all columns."
			>
				<div class="ledger">
					<div class="names">
						<span class="corner">Modules</span>
						{
							columns.map((column) => (
								<span class:list={['plan', { featured: column.featured }]}>{column.name}</span>
							))
						}
					</div>

					{
						compareGroups.map((group) => (
							<div class="group">
								<p class="group-title">{group.heading}</p>
								<ul>
									{group.rows.map((entry) => (
										<li class="row">
											<span class="module">{entry.name}</span>
											<span class:list={['cell', { featured: columns[0].featured }]} set:html={mark(entry.professional)} />
											<span class:list={['cell', { featured: columns[1].featured }]} set:html={mark(entry.premium)} />
											<span class:list={['cell', { featured: columns[2].featured }]} set:html={mark(entry.enterprise)} />
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
<style>
	.compare {
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		overflow-x: clip;
	}
	.inner {
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5.5rem;
	}

	.compare-table {
		margin: 3rem auto 0;
		width: 100%;
		max-width: 100%;
	}
	.scroll-hint {
		display: none;
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-align: right;
	}
	.scroller {
		width: 100%;
		max-width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface);
	}
	.scroller:focus-visible {
		outline: 2px solid var(--brand-blue);
		outline-offset: 3px;
	}
	.ledger {
		min-width: 36rem;
		background: var(--surface);
	}

	.names,
	.row {
		display: grid;
		grid-template-columns: minmax(12rem, 1.6fr) repeat(3, minmax(5.5rem, 0.7fr));
		align-items: stretch;
	}

	.names {
		position: sticky;
		top: 0;
		z-index: 2;
		background: var(--navy);
		color: var(--surface);
		font-size: 0.9375rem;
		font-weight: 700;
	}
	.corner,
	.plan {
		padding: 1rem 1.15rem;
	}
	.corner {
		color: rgba(255, 255, 255, 62%);
		font-weight: 600;
	}
	.plan {
		text-align: center;
		border-left: 1px solid rgba(255, 255, 255, 10%);
	}
	.plan.featured {
		background: rgba(4, 189, 175, 22%);
		color: var(--surface);
	}

	.group-title {
		margin: 0;
		padding: 0.85rem 1.15rem;
		background: var(--brand-wash);
		color: var(--navy);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.row {
		border-top: 1px solid var(--border);
	}
	.row:first-child {
		border-top: 0;
	}
	.module {
		padding: 0.85rem 1.15rem;
		color: var(--ink);
		font-size: 0.9375rem;
	}
	.cell {
		display: grid;
		place-items: center;
		border-left: 1px solid var(--border);
		padding: 0.7rem 0.5rem;
	}
	.cell.featured {
		background: var(--brand-wash);
	}

	.yes {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--brand-wash-deep);
		color: var(--brand-blue);
	}
	.cell.featured .yes {
		background: var(--brand-teal);
		color: var(--surface);
	}
	.no {
		color: var(--muted);
		font-size: 1.125rem;
		line-height: 1;
	}

	@media (max-width: 1080px) {
		.inner {
			padding: 3.5rem 1.5rem 4.5rem;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.75rem 1rem 3.5rem;
		}
		.scroll-hint {
			display: block;
		}
		.names {
			top: 0;
		}
		.module,
		.corner,
		.plan {
			padding: 0.8rem 0.9rem;
		}
	}
</style>
