---
import { SITE_TITLE } from '../../consts';
---

<section class="hero">
	<div class="inner">
		<p class="eyebrow">Contact</p>
		<h1>Talk to the EasyClinic team</h1>
		<p class="lede">
			Demo our clinic management software, ask about EMR workflows, or get go-live help — phone,
			email, or chat with a real person on the team.
		</p>
		<div class="cta">
			<a class="btn btn-solid" href="#demo-form">Book a Demo</a>
		</div>
		<p class="channels">
			<a href="mailto:hello@easyclinic.io">hello@easyclinic.io</a>
			<span aria-hidden="true">·</span>
			<a href="tel:+919147770277">+91 91477 70277</a>
		</p>
	</div>
</section>
<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.hero p {
		margin-bottom: 0;
	}
	.inner {
		max-width: 42rem;
		margin: 0 auto;
		padding: 4.5rem 1.5rem 4.5rem;
		text-align: center;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0 auto;
		color: var(--navy);
		font-size: clamp(2.125rem, 4vw, 2.75rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1rem auto 0;
		max-width: 46ch;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.cta {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}
	.btn {
		border-radius: 8px;
		padding: 0.875rem 1.375rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.channels {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 0.75rem;
		margin: 1.15rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.channels a {
		color: var(--brand-blue);
		font-weight: 600;
		text-decoration: none;
	}
	.channels a:hover {
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.inner {
			padding: 2.5rem 1rem 2.25rem;
		}
	}
</style>
