---
import { SITE_TITLE } from '../../consts';
import { plans, priceAttrs } from './data';

const glance = {
	professional: 'GPs and physicians',
	premium: 'Specialists',
	enterprise: 'Clinic chains',
};
---

<section class="hero">
	<div class="inner">
		<div class="copy">
			<p class="eyebrow">Pricing</p>
			<h1>Clinic management plans priced per doctor</h1>
			<p class="lede">
				One price per doctor, reception included, no lock-in. Start with the EMR you need and grow
				{SITE_TITLE} as the practice grows.
			</p>
			<div class="cta">
				<a class="btn btn-solid" href="/contact-us#demo-form">Book a Demo</a>
				<a class="btn btn-ghost" href="https://app.easyclinic.io/">Login</a>
			</div>
			<p class="proof">Used by 5,000+ doctors across 200 cities.</p>
		</div>

		<div class="stack">
			<p class="stack-label">At a glance</p>
			<ul>
				{
					plans.map((plan) => {
						const p = priceAttrs(plan.price);
						return (
							<li>
								<a
									class:list={['preview', { featured: plan.featured }]}
									href={`#plan-${plan.id}`}
								>
									<span class="who">
										{plan.featured && <span class="badge">Popular</span>}
										<strong>{plan.name}</strong>
										<small>{glance[plan.id]}</small>
									</span>
									<span class="cost">
										<span
											class="amount"
											data-price
											data-usd-annual={p.usdAnnual}
											data-usd-quarterly={p.usdQuarterly}
											data-inr-annual={p.inrAnnual}
											data-inr-quarterly={p.inrQuarterly}
										>
											{p.usdAnnual}
										</span>
										<small>{plan.cadence}</small>
									</span>
								</a>
							</li>
						);
					})
				}
			</ul>
		</div>
	</div>
</section>
<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		overflow: hidden;
	}
	.inner {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.85fr);
		align-items: center;
		gap: 4rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5.5rem;
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		max-width: 14ch;
		color: var(--navy);
		font-size: clamp(2.25rem, 4.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1.35rem 0 0;
		max-width: 44ch;
		color: var(--muted);
		font-size: 1.125rem;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.btn {
		border-radius: 8px;
		padding: 0.875rem 1.375rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}
	.btn-solid {
		border: 1.5px solid var(--brand-blue);
		background: var(--brand-blue);
		color: var(--surface);
	}
	.btn-solid:hover {
		border-color: var(--brand-blue-dark);
		background: var(--brand-blue-dark);
	}
	.btn-ghost {
		border: 1.5px solid var(--brand-blue);
		color: var(--brand-blue);
	}
	.btn-ghost:hover {
		background: var(--brand-blue);
		color: var(--surface);
	}
	.proof {
		margin: 2rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}

	.stack {
		min-width: 0;
	}
	.stack-label {
		margin: 0 0 0.85rem 0.15rem;
		color: var(--navy);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.stack ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.preview {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 1rem;
		border: 1px solid rgba(10, 37, 64, 10%);
		border-radius: 16px;
		padding: 1.1rem 1.25rem;
		background: var(--surface);
		box-shadow: 0 12px 32px rgba(10, 37, 64, 8%);
		color: inherit;
		text-decoration: none;
	}
	.preview:hover {
		border-color: var(--brand-blue);
	}
	.preview.featured {
		border-color: transparent;
		background: var(--navy);
		box-shadow: 0 16px 36px rgba(10, 37, 64, 22%);
	}
	.preview.featured .who strong,
	.preview.featured .amount {
		color: var(--surface);
	}
	.preview.featured .who small,
	.preview.featured .cost small {
		color: rgba(255, 255, 255, 0.72);
	}
	.who {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		min-width: 0;
	}
	.badge {
		width: fit-content;
		margin-bottom: 0.25rem;
		border-radius: 999px;
		padding: 0.15rem 0.55rem;
		background: var(--brand-teal);
		color: var(--surface);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}
	.who strong {
		color: var(--navy);
		font-size: 1.0625rem;
		font-weight: 700;
	}
	.who small,
	.cost small {
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.35;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cost {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		line-height: 1.15;
		flex-shrink: 0;
	}
	.amount {
		color: var(--navy);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		white-space: nowrap;
	}

	@media (max-width: 1080px) {
		.inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 3.5rem 1.5rem 4.5rem;
		}
		h1,
		.lede {
			max-width: none;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.75rem 1rem 3.25rem;
		}
		.btn {
			flex: 1 1 auto;
			text-align: center;
		}
	}
</style>
