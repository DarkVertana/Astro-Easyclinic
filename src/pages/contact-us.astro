	}
	.map-frame iframe {
		display: block;
		width: 100%;
		height: 440px;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.channels a,
		.dial svg {
			transition: none;
		}
	}

	/* ---------- responsive ---------- */
	@media (max-width: 1080px) {
		.intro .inner {
