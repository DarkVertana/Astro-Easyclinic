---
import { Image } from 'astro:assets';
import team from '../../assets/contact-hero.webp';
---

<section class="hero">
	<div class="inner">
		<div class="copy">
			<p class="eyebrow">Contact</p>
			<h1>Talk to the EasyClinic team</h1>
			<p class="lede">
				Demo our clinic management software, ask about EMR workflows, or get go-live help, phone,
				email, or chat with a real person on the team.
			</p>
			<ul class="points">
				<li>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"></rect><path d="M8 21h8"></path><path d="M12 17v4"></path></svg>
					<span>Personalised demo</span>
				</li>
				<li>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13a9 9 0 0 1 18 0"></path><path d="M21 17v1a4 4 0 0 1-4 4h-4"></path><rect x="3" y="13" width="4" height="6" rx="2"></rect><rect x="17" y="13" width="4" height="6" rx="2"></rect></svg>
					<span>Real human support</span>
				</li>
				<li>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"></path></svg>
					<span>Free training</span>
				</li>
			</ul>
		</div>

		<figure class="visual">
			{/* abstract accents behind the photo */}
			<svg class="deco ring" viewBox="0 0 200 200" aria-hidden="true">
				<circle cx="100" cy="100" r="88" fill="none" stroke="var(--brand-teal)" stroke-width="2" opacity="0.5"></circle>
				<circle cx="100" cy="100" r="66" fill="none" stroke="var(--brand-blue)" stroke-width="2" opacity="0.35"></circle>
			</svg>
			<svg class="deco dots" viewBox="0 0 120 120" aria-hidden="true">
				{
					Array.from({ length: 25 }, (_, i) => (
						<circle cx={8 + (i % 5) * 26} cy={8 + Math.floor(i / 5) * 26} r="3.5" fill="var(--brand-blue)" opacity="0.35" />
					))
				}
			</svg>

			<Image
				src={team}
				alt="Two members of the Easy Clinic team celebrating a go-live at a desk"
				width={1040}
				height={693}
				densities={[1, 1.5]}
				loading="eager"
			/>

			<span class="float-chip" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 13a9 9 0 0 1 18 0"></path>
					<path d="M21 17v1a4 4 0 0 1-4 4h-4"></path>
					<rect x="3" y="13" width="4" height="6" rx="2"></rect>
					<rect x="17" y="13" width="4" height="6" rx="2"></rect>
				</svg>
			</span>

			<figcaption class="badge">
				<strong>Real people, no bots</strong>
				<span>Phone, email and chat support</span>
			</figcaption>
		</figure>
	</div>
</section>
<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		overflow: hidden;
	}
	.hero p {
		margin-bottom: 0;
	}
	.inner {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.85fr);
		align-items: center;
		gap: 4rem;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5.5rem;
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		max-width: 14ch;
		color: var(--navy);
		font-size: clamp(2.25rem, 4.4vw, 3.25rem);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1.35rem 0 0;
		max-width: 44ch;
		color: var(--muted);
		font-size: 1.125rem;
	}

	.points {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}
	.points li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.45rem 0.95rem;
		background: var(--surface);
		color: var(--navy);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.points svg {
		flex-shrink: 0;
		width: 14px;
		height: 14px;
		color: var(--brand-teal);
	}

	.visual {
		position: relative;
		width: fit-content;
		max-width: 100%;
		margin: 0 auto;
	}
	.visual :global(img) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		max-width: 520px;
		height: auto;
		border-radius: 20px;
		box-shadow: 0 20px 48px rgba(10, 37, 64, 14%);
	}

	.deco {
		position: absolute;
		z-index: 0;
	}
	.ring {
		top: -3rem;
		right: -3rem;
		width: 140px;
		height: 140px;
	}
	.dots {
		bottom: -2.25rem;
		right: -1.75rem;
		width: 105px;
		height: 105px;
	}

	.float-chip {
		position: absolute;
		z-index: 2;
		top: 1.75rem;
		right: 0.9rem;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 16px;
		background: var(--surface);
		color: var(--brand-blue);
		box-shadow: 0 12px 28px rgba(10, 37, 64, 16%);
		animation: float 5.5s ease-in-out infinite;
	}
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}

	.badge {
		position: absolute;
		left: -1.25rem;
		bottom: 1.5rem;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		border-radius: 14px;
		padding: 0.8rem 1.1rem;
		background: var(--surface);
		box-shadow: 0 14px 32px rgba(10, 37, 64, 18%);
	}
	.badge strong {
		color: var(--navy);
		font-size: 1rem;
		font-weight: 700;
	}
	.badge span {
		color: var(--muted);
		font-size: 0.8125rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.float-chip {
			animation: none;
		}
	}
	@media (min-width: 1260px) {
		.float-chip {
			right: -1.5rem;
		}
	}
	@media (max-width: 1080px) {
		.inner {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding: 3.5rem 1.5rem 4.5rem;
		}
		h1,
		.lede {
			max-width: none;
		}
		.badge {
			left: 0.75rem;
			bottom: 0.75rem;
		}
		.float-chip {
			right: 0.75rem;
		}
		.ring {
			top: -1.5rem;
			right: -1rem;
			width: 110px;
			height: 110px;
		}
		.dots {
			right: -0.25rem;
			bottom: -1.25rem;
		}
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.75rem 1rem 3.25rem;
		}
	}
</style>
