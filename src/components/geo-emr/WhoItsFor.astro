---
import SectionHead from '../SectionHead.astro';
import type { GeoMarket } from './data';

interface Props {
	market: GeoMarket;
}

const { market } = Astro.props;
---

<section class="who">
	<div class="panel">
		<SectionHead
			eyebrow={market.clinicTypesEyebrow}
			title={market.clinicTypesTitle}
			lede={market.clinicTypesLede}
		/>

		<ul class="chips" data-stagger>
			{
				market.clinicTypes.map((item) => (
					<li>
						{item.href ? (
							<a href={item.href}>
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
								<span class="go" aria-hidden="true">
									<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M5 12h13" />
										<path d="m12 5 7 7-7 7" />
									</svg>
								</span>
							</a>
						) : (
							<div class="static">
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
							</div>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>
<style>
	.who {
		background: var(--brand-wash);
	}
	.panel {
		background: var(--surface);
		border-radius: 24px 24px 0 0;
		padding: 5.5rem 1.5rem 4.5rem;
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}

	.chips {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		max-width: var(--page-max);
		margin: 3rem auto 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		border: 1px solid var(--border);
		border-radius: 20px;
		background: var(--surface-tint);
	}
	.chips a,
	.static {
		display: block;
		position: relative;
		padding: 1.5rem;
		color: inherit;
		text-decoration: none;
	}
	.chips a {
		padding-bottom: 3.25rem;
	}
	.chips li:has(a):hover {
		border-color: var(--brand-wash-deep);
		background: var(--brand-wash);
	}

	h3 {
		margin: 0;
		color: var(--navy);
		font-size: 1.125rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.chips p {
		margin: 0.65rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.go {
		position: absolute;
		left: 1.5rem;
		bottom: 1.4rem;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 10px;
		background: var(--brand-wash-deep);
		color: var(--brand-blue);
	}
	.chips a:hover .go {
		background: var(--brand-blue);
		color: var(--surface);
	}

	@media (max-width: 1080px) {
		.panel {
			padding: 4rem 1.5rem 3.5rem;
		}
		.chips {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.panel {
			padding: 3rem 1rem 3rem;
		}
		.chips {
			grid-template-columns: 1fr;
			margin-top: 2.25rem;
		}
	}
</style>
