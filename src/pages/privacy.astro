---
import Cta from '../components/Cta.astro';
import Marketing from '../layouts/Marketing.astro';
import { SITE_TITLE } from '../consts';
---

<Marketing
	title={`Privacy policy — ${SITE_TITLE}`}
	description="How Novel Medicare Solutions Pvt Ltd handles information on the EasyClinic clinic software marketing site and product enquiries."
	mainClass="legal"
>
	<section class="hero">
		<div class="inner">
			<p class="eyebrow">Legal</p>
			<h1>Privacy policy</h1>
			<p class="lede">
				How Novel Medicare Solutions Pvt Ltd (“EasyClinic”) handles information when you visit
				easyclinic.io or contact us about our EMR and clinic software.
			</p>
			<p class="updated">Last updated: 4 September 2026</p>
		</div>
	</section>

	<section class="body">
		<div class="panel">
			<div class="prose">
				<h2>Who we are</h2>
				<p>
					EasyClinic is operated by Novel Medicare Solutions Pvt Ltd, 30 Circus Avenue, Kolkata —
					700 017, India. For privacy questions, email
					<a href="mailto:hello@easyclinic.io">hello@easyclinic.io</a>.
				</p>

				<h2>What we collect on this marketing site</h2>
				<p>
					When you request a demo or email us, we receive the details you choose to send — typically
					name, clinic name, email, phone, and your message. We use that information only to respond
					and to schedule product conversations.
				</p>
				<p>
					This static marketing site does not store form submissions on our servers. Demo requests
					open your email client to reach our team. Server logs from hosting may include standard
					technical data such as IP address and browser type.
				</p>

				<h2>Product and clinic data</h2>
				<p>
					If your clinic uses the EasyClinic application, patient and operational data is processed
					under your organisation’s agreement with us and applicable healthcare and data-protection
					laws. That processing is separate from this marketing website and is covered in your
					customer contract and product documentation.
				</p>

				<h2>Cookies and analytics</h2>
				<p>
					We may use essential cookies required for the site to function. If we add analytics or
					marketing cookies, we will describe them here and, where required, ask for consent.
				</p>

				<h2>Sharing</h2>
				<p>
					We do not sell personal information. We may share contact details with service providers
					who help us operate email, hosting, or customer support — only as needed to serve you —
					or when required by law.
				</p>

				<h2>Retention and your rights</h2>
				<p>
					We keep enquiry records only as long as needed to follow up and maintain a normal business
					relationship. Depending on your location, you may have rights to access, correct, or
					delete personal information we hold about you. Contact us at the email above to make a
					request.
				</p>

				<h2>Changes</h2>
				<p>
					We may update this policy as our practices or the law change. The date at the top of this
					page will reflect the latest revision.
				</p>
			</div>
		</div>
	</section>

	<Cta />
</Marketing>

<style>
	.hero {
		background: var(--brand-wash);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
	}
	.inner {
		max-width: 760px;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
	}
	.eyebrow {
		margin: 0 0 0.85rem;
		color: var(--brand-blue);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		margin: 0;
		color: var(--navy);
		font-size: clamp(1.875rem, 3.6vw, 2.75rem);
		font-weight: 700;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1.15rem 0 0;
		color: var(--muted);
		font-size: 1.0625rem;
	}
	.updated {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.875rem;
	}
	.body {
		background: var(--brand-wash);
	}
	.panel {
		max-width: 760px;
		margin: 0 auto;
		border-radius: 24px 24px 0 0;
		padding: 2.5rem 1.5rem 4rem;
		background: var(--surface);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.7;
	}
	.prose :global(h2),
	.prose h2 {
		margin: 2rem 0 0.75rem;
		color: var(--navy);
		font-size: 1.25rem;
		font-weight: 700;
	}
	.prose h2:first-child {
		margin-top: 0;
	}
	.prose p {
		margin: 0 0 1.15rem;
		color: var(--muted);
	}
	.prose a {
		color: var(--brand-blue);
	}
	@media (max-width: 720px) {
		.inner {
			padding: 2.75rem 1rem 2.25rem;
		}
		.panel {
			padding: 1.5rem 1rem 3rem;
		}
	}
</style>
